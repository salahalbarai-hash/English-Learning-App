<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0-android</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>English</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>English</ApplicationTitle>
		<ApplicationId>com.salah.englishapp</ApplicationId>
		<ApplicationDisplayVersion>1.7</ApplicationDisplayVersion>
		<ApplicationVersion>8</ApplicationVersion>

		<SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
		<NuGetAudit>false</NuGetAudit>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $(TargetFramework.Contains('android'))">
		<!-- دعم جميع الهواتف الحقيقية (القديمة 32-bit والحديثة 64-bit) واستبعاد معماريات المحاكيات x86/x64 -->
		<RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>
		
		<!-- إخراج ملف APK موحد مضغوط -->
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<AndroidEnableMultiDex>true</AndroidEnableMultiDex>
		<AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>

		<!-- تفعيل تشذيب الكود (Trimming) لحذف المكتبات غير المستخدمة مع الحفاظ على عمل JSON والـ API -->
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>partial</TrimMode>

		<!-- تفعيل أداة R8 لضغط كود Android وحذف الموارد غير المستخدمة -->
		<AndroidLinkTool>r8</AndroidLinkTool>
		<AndroidLinkResources>true</AndroidLinkResources>

		<!-- إيقاف AOT و Profiled AOT لتوفير مساحة كبيرة في كلا المعماريتين -->
		<RunAOTCompilation>false</RunAOTCompilation>
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>

		<!-- إلغاء ملفات التتبع والتصحيح -->
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#512BD4" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#68B1F6" BaseSize="200,200" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <AndroidResource Remove="Platforms\Android\Resources\values\styles.xml" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Pages\ExamPage.xaml.cs" />
		<Compile Remove="Pages\GroupPage.xaml.cs" />
		<Compile Remove="Pages\MainPage.xaml.cs" />
		<Compile Remove="Pages\VideoPage.xaml.cs" />
		<Compile Remove="Services\InterstitialAd.cs" />
		<Compile Remove="Services\RewardedAd.cs" />
		<Compile Remove="ViewModels\ListeningQuestionsViewVM.cs" />
		<Compile Remove="ViewModels\OptionsQuestionsViewVM.cs" />
		<Compile Remove="Views\ListeningQuestionView.xaml.cs" />
		<Compile Remove="Views\OptionsQuestionView.xaml.cs" />
		<Compile Remove="Views\WinView.xaml.cs" />
		<Compile Remove="Views\WritingQuestionView.xaml.cs" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Remove="Pages\ExamPage.xaml" />
	  <MauiXaml Remove="Pages\GroupPage.xaml" />
	  <MauiXaml Remove="Pages\MainPage.xaml" />
	  <MauiXaml Remove="Pages\VideoPage.xaml" />
	  <MauiXaml Remove="Views\ListeningQuestionView.xaml" />
	  <MauiXaml Remove="Views\OptionsQuestionView.xaml" />
	  <MauiXaml Remove="Views\WinView.xaml" />
	  <MauiXaml Remove="Views\WritingQuestionView.xaml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="9.1.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
		<PackageReference Include="RestSharp" Version="113.1.0" />
		<PackageReference Include="SkiaSharp" Version="3.119.1" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="2.88.9" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Shared\Shared.csproj" />
	</ItemGroup>

