<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lottie="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="English.Views.WinView"
             Loaded="ContentView_Loaded" Unloaded="ContentView_Unloaded">
    <Grid>
        <Image Source="ok.gif" IsAnimationPlaying="True" BackgroundColor="White"/>
        <ActivityIndicator x:Name="ActivityIndicator" 
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           BackgroundColor="#80000000"
                           Color="#00BCD4"/>
        <Button x:Name="SaveBtn"
                Text="حفظ النتيجة" 
                WidthRequest="100" 
                HeightRequest="50" 
                VerticalOptions="End" 
                Margin="0,0,0,60" 
                FontAttributes="Bold" 
                IsVisible="False"
                Clicked="SaveBtn_Clicked"/>
        <!--<toolkit:MediaElement x:Name="mediaElement" ShouldAutoPlay="True" IsVisible="False"/>-->
    </Grid>
</ContentView>