<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="English.Views.OptionsQuestionView"
             x:Name="root">

    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="OptionButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="#334155" />
                <Setter Property="FontFamily" Value="HacenLebanon" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="BorderColor" Value="#F1F5F9" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="HeightRequest" Value="70" />
                <Setter Property="Margin" Value="0,5" />
                <Style.Triggers>
                    <Trigger TargetType="Button" Property="IsPressed" Value="True">
                        <Setter Property="Scale" Value="0.97" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="25,40,25,30" BackgroundColor="#F8FAFC">

        <toolkit:MediaElement x:Name="mediaElement"
                              Source="{Binding MediaSource}"
                              ShouldAutoPlay="True"
                              IsVisible="False"/>

        <Border Grid.Row="1" 
        Stroke="#E2E8F0" 
        StrokeThickness="2" 
        StrokeShape="RoundRectangle 20" 
        BackgroundColor="White" 
        Padding="20" 
        Margin="0,10">
            <Border.Shadow>
                <Shadow Brush="#CBD5E1" Offset="0,10" Opacity="0.1" Radius="20"/>
            </Border.Shadow>

            <Label Text="{Binding CurrentQuestion.Title}"
           FontSize="36"
           FontAttributes="Bold"
           TextColor="#0F172A" 
           HorizontalTextAlignment="Center"
           FontFamily="HacenLebanon"/>
        </Border>

        <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
            <CollectionView ItemsSource="{Binding CurrentQuestion.Options}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,5">
                            <Button Text="{Binding .}"
                                    Style="{StaticResource OptionButtonStyle}"
                                    Clicked="Button_Clicked"
                                    Command="{Binding Source={x:Reference root}, Path=BindingContext.OptionSelectedCommand}"
                                    CommandParameter="{Binding .}">
                                <Button.Shadow>
                                    <Shadow Brush="#94A3B8" Offset="0,4" Opacity="0.1" Radius="8"/>
                                </Button.Shadow>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <Button Grid.Row="3"
                Text="تاكيد الإجابة"
                Command="{Binding NextCommand}"
                BackgroundColor="#0EA5E9"
                TextColor="White"
                HeightRequest="60"
                CornerRadius="18"
                FontSize="18"
                FontAttributes="Bold"
                FontFamily="HacenLebanon"
                Margin="0,10,0,0">
            <Button.Shadow>
                <Shadow Brush="#0EA5E9" Offset="0,6" Opacity="0.3" Radius="12"/>
            </Button.Shadow>
        </Button>

    </Grid>
</ContentView>