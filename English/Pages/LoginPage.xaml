<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.LoginPage"
             Title="تسجيل الدخول"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             FlowDirection="RightToLeft"
             BackgroundColor="#0B0F1A">
    <ContentPage.Content>
        <Grid>
            <Ellipse Fill="#1A38BDF8" WidthRequest="300" HeightRequest="300" HorizontalOptions="Start" VerticalOptions="Start" Margin="-100,-100,0,0" />
            <Ellipse Fill="#1A818CF8" WidthRequest="250" HeightRequest="250" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-80,-80" />

            <ScrollView>
                <VerticalStackLayout Padding="30,50,30,30" Spacing="25" VerticalOptions="Center">

                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,0,0,20">
                        <Border WidthRequest="100" HeightRequest="100" StrokeShape="RoundRectangle 25" StrokeThickness="0">
                            <Image Source="login.gif" Aspect="AspectFill" IsAnimationPlaying="True" />
                            <Border.Shadow>
                                <Shadow Brush="#38BDF8" Offset="0,10" Radius="25" Opacity="0.4" />
                            </Border.Shadow>
                        </Border>

                        <Label Text="أهلاً بك في انجليش!" 
                               TextColor="White" 
                               FontSize="28" 
                               FontFamily="CairoBold" 
                               HorizontalOptions="Center" 
                               Margin="0,10,0,0"/>

                        <Label Text="سجل دخولك لاستكمال التحدي ⚡" 
                               TextColor="#94A3B8" 
                               FontSize="14" 
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="اسم المستخدم" TextColor="#94A3B8" FontSize="14" FontAttributes="Bold" Margin="5,0,0,0"/>
                        <Border StrokeShape="RoundRectangle 16" 
                                StrokeThickness="1" 
                                Stroke="#1E293B" 
                                BackgroundColor="#0F172A" 
                                Padding="15,5"
                                HeightRequest="60">
                            <Entry x:Name="UserNameEntry" 
                                   Placeholder="أدخل اسم المستخدم..." 
                                   PlaceholderColor="#475569"
                                   TextColor="White"
                                   BackgroundColor="Transparent"
                                   FontSize="16"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="كلمة المرور" TextColor="#94A3B8" FontSize="14" FontAttributes="Bold" Margin="5,0,0,0"/>
                        <Border StrokeShape="RoundRectangle 16" 
                                StrokeThickness="1" 
                                Stroke="#1E293B" 
                                BackgroundColor="#0F172A" 
                                Padding="15,5"
                                HeightRequest="60">
                            <Entry x:Name="PasswordEntry" 
                                   Placeholder="••••••••" 
                                   PlaceholderColor="#475569"
                                   TextColor="White"
                                   BackgroundColor="Transparent"
                                   IsPassword="True"
                                   FontSize="20"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="تسجيل الدخول" 
                            Clicked="OnLoginClicked" 
                            Margin="0,15,0,0" 
                            HeightRequest="60"
                            CornerRadius="16"
                            FontSize="18"
                            FontAttributes="Bold"
                            FontFamily="CairoBold"
                            TextColor="White">
                        <Button.Background>
                            <LinearGradientBrush EndPoint="1,0">
                                <GradientStop Color="#38BDF8" Offset="0.1" />
                                <GradientStop Color="#818CF8" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Shadow>
                            <Shadow Brush="#38BDF8" Offset="0,6" Radius="20" Opacity="0.5" />
                        </Button.Shadow>
                    </Button>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,10,0,0">
                        <Label Text="مستخدم جديد؟" TextColor="#64748B" FontSize="14"/>
                        <Label Text="أنشئ حسابك الآن" TextColor="#38BDF8" FontSize="14" FontAttributes="Bold" TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRegisterTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <Grid x:Name="LoadingOverlay" BackgroundColor="#CC0B0F1A" IsVisible="False">
                <Border HorizontalOptions="Center" 
                        VerticalOptions="Center" 
                        StrokeShape="RoundRectangle 20" 
                        StrokeThickness="1"
                        Stroke="#1E293B"
                        BackgroundColor="#0F172A" 
                        Padding="35">
                    <VerticalStackLayout Spacing="15">
                        <ActivityIndicator x:Name="ActivityIndicator"
                                           IsRunning="True"
                                           Color="#38BDF8"
                                           WidthRequest="50"
                                           HeightRequest="50"
                                           HorizontalOptions="Center"/>
                        <Label Text="جاري تسجيل الدخول..." 
                               TextColor="White" 
                               FontSize="16" 
                               FontFamily="CairoBold" 
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </Grid>
    </ContentPage.Content>
</ContentPage>