<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.MessagesPage"
             BackgroundColor="#FFFFFF"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *">

        <!-- مربع البحث -->
        <Border Grid.Row="0"
                Margin="20,20,20,15"
                StrokeThickness="0"
                BackgroundColor="#F3F4F6"
                StrokeShape="RoundRectangle 14"
                HeightRequest="50">

            <SearchBar x:Name="SearchBarFriends"
                       Placeholder="ابحث عن صديق..."
                       BackgroundColor="Transparent"
                       PlaceholderColor="#9CA3AF"
                       CancelButtonColor="#6366F1"
                       TextColor="#111827"
                       VerticalOptions="Center"
                       TextChanged="OnSearchTextChanged"/>
        </Border>

        <!-- قائمة الأصدقاء -->
        <CollectionView x:Name="FriendsList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnFriendSelected">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid BackgroundColor="Transparent">

                        <!-- تأثير اللمس الاحترافي -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#F9FAFB" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,12,20,12">

                            <!-- الصورة ونقطة الاتصال -->
                            <Grid Grid.Column="0" 
                                  WidthRequest="54"
                                  HeightRequest="54"
                                  Margin="0,0,15,0">

                                <!-- صورة العرض الدائرية -->
                                <Border WidthRequest="54"
                                        HeightRequest="54"
                                        StrokeShape="RoundRectangle 27"
                                        StrokeThickness="0"
                                        BackgroundColor="#6366F1">
                                    <Label Text="{Binding Initials}"
                                           FontAttributes="Bold"
                                           FontSize="20"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <!-- نقطة الاتصال المدمجة -->
                                <Border WidthRequest="16"
                                        HeightRequest="16"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#FFFFFF"
                                        StrokeThickness="2.5"
                                        BackgroundColor="{Binding StatusColor}"
                                        HorizontalOptions="End"
                                        VerticalOptions="End"
                                        TranslationX="2"
                                        TranslationY="2"/>
                            </Grid>

                            <!-- معلومات الصديق -->
                            <VerticalStackLayout Grid.Column="1" 
                                                 VerticalOptions="Center" 
                                                 Spacing="2">
                                <Label Text="{Binding Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#111827"/>

                                <Label Text="{Binding StatusText}"
                                       FontSize="13"
                                       TextColor="#6B7280"/>
                            </VerticalStackLayout>

                            <!-- السهم -->
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="#D1D5DB"
                                   TranslationY="-2"/>

                        </Grid>

                        <!-- خط فاصل ناعم بين المحادثات -->
                        <BoxView HeightRequest="1" 
                                 Color="#F3F4F6" 
                                 VerticalOptions="End" 
                                 Margin="89,0,20,0"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- حالة "لا يوجد بيانات" -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="False"
                             x:Name="EmptyLabel"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="10">

            <Label Text="💬"
                   FontSize="64"
                   HorizontalOptions="Center"
                   Opacity="0.8"/>

            <Label Text="لا توجد محادثات"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#374151"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>