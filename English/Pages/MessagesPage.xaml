<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.MessagesPage"
             Title="الرسائل">
    <VerticalStackLayout Padding="12" Spacing="10">
        <Label Text="الرسائل" FontSize="24" HorizontalOptions="Center" />

        <SearchBar x:Name="SearchBarFriends"
                   Placeholder="ابحث عن صديق..."
                   SearchCommandParameter=""
                   TextChanged="OnSearchTextChanged" />

        <CollectionView x:Name="FriendsList"
                        SelectionMode="Single"
                        SelectionChanged="OnFriendSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
                        <Frame WidthRequest="48" HeightRequest="48" CornerRadius="24" HasShadow="False" Padding="0" BackgroundColor="#E5E7EB">
                            <Label Text="{Binding Initials}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                        </Frame>

                        <StackLayout Grid.Column="1" Spacing="2" Padding="8,0">
                            <Label Text="{Binding Name}" FontSize="16" />
                            <Label Text="{Binding StatusText}" FontSize="12" TextColor="#6B7280" />
                        </StackLayout>

                        <Label Grid.Column="2" Text="{Binding StatusIcon}" VerticalOptions="Center" HorizontalOptions="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="EmptyLabel" Text="لا توجد أصدقاء لعرضهم" IsVisible="False" HorizontalOptions="Center" VerticalOptions="CenterAndExpand" />
    </VerticalStackLayout>
</ContentPage>