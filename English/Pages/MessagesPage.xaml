<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:English.Pages"
             x:Class="English.Pages.MessagesPage"
             BackgroundColor="#0B1120"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- ══════════ الترويسة العلوية ══════════ -->
        <Grid Grid.Row="0" Padding="20,16,20,0">
            <Grid ColumnDefinitions="*, Auto">
                <!-- عنوان الصفحة -->
                <Label Grid.Column="0" Text="المحادثات"
                       FontSize="24" FontFamily="CairoBold"
                       TextColor="#F8FAFC"
                       VerticalOptions="Center" />

                <!-- أيقونة إعدادات المحادثات (أيقونة احترافية Vector بدقة عالية) -->
                <Border Grid.Column="1"
                        x:Name="SettingsBtn"
                        WidthRequest="40" HeightRequest="40"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="1"
                        Stroke="#334155"
                        BackgroundColor="#1E293B"
                        VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.35"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsClicked"/>
                    </Border.GestureRecognizers>
                    <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                          Fill="#CBD5E1"
                          WidthRequest="21"
                          HeightRequest="21"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════ مربع البحث ══════════ -->
        <Border Grid.Row="1"
                Margin="20,14,20,10"
                StrokeThickness="0"
                BackgroundColor="#151E2F"
                StrokeShape="RoundRectangle 14"
                HeightRequest="48">

            <Grid ColumnDefinitions="Auto, *">
                <Label Text="🔍" FontSize="16"
                       Margin="14,0,0,0"
                       VerticalOptions="Center" Opacity="0.6" />
                <Entry Grid.Column="1"
                       x:Name="SearchBarFriends"
                       Placeholder="ابحث عن صديق أو رسالة..."
                       BackgroundColor="Transparent"
                       PlaceholderColor="#64748B"
                       TextColor="#F8FAFC"
                       ClearButtonVisibility="WhileEditing"
                       VerticalOptions="Center"
                       TextChanged="OnSearchTextChanged"/>
            </Grid>
        </Border>

        <!-- ══════════ قائمة المحادثات ══════════ -->
        <CollectionView x:Name="FriendsList"
                        Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="OnFriendSelected">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:MessagesFriendItem">
                    <Grid BackgroundColor="Transparent">

                        <!-- تأثير التحديد -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#1E293B" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,12,20,12">

                            <!-- الصورة ونقطة الاتصال -->
                            <Grid Grid.Column="0"
                                  WidthRequest="52"
                                  HeightRequest="52"
                                  Margin="0,0,12,0">

                                <!-- صورة العرض الدائرية مع تدرج لوني -->
                                <Border WidthRequest="52"
                                        HeightRequest="52"
                                        StrokeShape="RoundRectangle 26"
                                        StrokeThickness="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#6366F1" Offset="0.0" />
                                            <GradientStop Color="#818CF8" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="{Binding Initials}"
                                           FontAttributes="Bold"
                                           FontSize="19" FontFamily="CairoBold"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <!-- نقطة الاتصال المدمجة -->
                                <Border WidthRequest="15"
                                        HeightRequest="15"
                                        StrokeShape="RoundRectangle 7.5"
                                        Stroke="#0B1120"
                                        StrokeThickness="2.5"
                                        BackgroundColor="{Binding StatusColor}"
                                        HorizontalOptions="End"
                                        VerticalOptions="End"
                                        TranslationX="2"
                                        TranslationY="2"/>
                            </Grid>

                            <!-- معلومات الصديق وآخر رسالة -->
                            <Grid Grid.Column="1"
                                  RowDefinitions="Auto, Auto"
                                  RowSpacing="3"
                                  VerticalOptions="Center">

                                <!-- السطر الأول: الاسم + وقت آخر رسالة -->
                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontSize="15" FontFamily="CairoBold"
                                           TextColor="#F8FAFC"
                                           LineBreakMode="TailTruncation"/>

                                    <Label Grid.Column="1"
                                           Text="{Binding LastMessageTimeString}"
                                           FontSize="11"
                                           TextColor="#64748B"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding HasLastMessage}"/>
                                </Grid>

                                <!-- السطر الثاني: معاينة آخر رسالة أو نص الحالة -->
                                <Label Grid.Row="1"
                                       Text="{Binding LastMessagePreview}"
                                       FontSize="13"
                                       TextColor="{Binding LastMessageColor}"
                                       FontAttributes="{Binding LastMessageFontAttributes}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"/>
                            </Grid>

                            <!-- شارة الرسائل غير المقروءة أو سهم الانتقال -->
                            <Grid Grid.Column="2"
                                  VerticalOptions="Center"
                                  Margin="8,0,0,0">

                                <!-- شارة الرسائل غير المقروءة -->
                                <Border IsVisible="{Binding HasUnread}"
                                        BackgroundColor="#38BDF8"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 11"
                                        Padding="7,2"
                                        MinimumWidthRequest="22" HeightRequest="22"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding UnreadCountText}"
                                           FontFamily="CairoBold" FontSize="11"
                                           TextColor="#040814"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <!-- سهم الانتقال الدائري عند عدم وجود رسائل غير مقروءة -->
                                <Border IsVisible="{Binding IsArrowVisible}"
                                        WidthRequest="28" HeightRequest="28"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="0"
                                        BackgroundColor="#1E293B"
                                        VerticalOptions="Center">
                                    <Label Text="›"
                                           FontSize="18" FontAttributes="Bold"
                                           VerticalOptions="Center" HorizontalOptions="Center"
                                           TextColor="#64748B" />
                                </Border>
                            </Grid>

                        </Grid>

                        <!-- خط فاصل ناعم -->
                        <BoxView HeightRequest="0.5"
                                 Color="#1E293B"
                                 VerticalOptions="End"
                                 Margin="84,0,20,0"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- حالة "لا يوجد بيانات" -->
        <VerticalStackLayout Grid.Row="2"
                             IsVisible="False"
                             x:Name="EmptyLabel"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12">

            <Border WidthRequest="90" HeightRequest="90"
                    StrokeShape="RoundRectangle 45"
                    StrokeThickness="0"
                    BackgroundColor="#151E2F"
                    HorizontalOptions="Center">
                <Label Text="💬"
                       FontSize="42"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Opacity="0.7"/>
            </Border>

            <Label Text="لا توجد محادثات بعد"
                   FontSize="18" FontFamily="CairoBold"
                   TextColor="#64748B"
                   HorizontalOptions="Center"/>

            <Label Text="أضف أصدقاء لبدء المحادثة"
                   FontSize="14" 
                   TextColor="#475569"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
