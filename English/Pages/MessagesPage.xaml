<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.MessagesPage"
             BackgroundColor="#F5F7FA"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!-- البحث -->
        <Border
            Grid.Row="0"
            Margin="15,15,15,10"
            StrokeThickness="0"
            BackgroundColor="White"
            StrokeShape="RoundRectangle 18">

            <SearchBar
                x:Name="SearchBarFriends"
                Placeholder="ابحث عن صديق..."
                BackgroundColor="Transparent"
                PlaceholderColor="#9CA3AF"
                CancelButtonColor="#6366F1"
                TextColor="#111827"
                HeightRequest="52"
                TextChanged="OnSearchTextChanged"/>
        </Border>

        <!-- القائمة -->
        <CollectionView
            x:Name="FriendsList"
            Grid.Row="1"
            Margin="12,0,12,10"
            SelectionMode="Single"
            SelectionChanged="OnFriendSelected">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        StrokeThickness="0"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 18"
                        Padding="15,12">

                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <!-- الصورة ونقطة الاتصال -->
                            <Grid WidthRequest="58"
                                  HeightRequest="58">

                                <Frame
                                    WidthRequest="58"
                                    HeightRequest="58"
                                    CornerRadius="29"
                                    Padding="0"
                                    BackgroundColor="#6366F1"
                                    HasShadow="False">

                                    <Label
                                        Text="{Binding Initials}"
                                        FontAttributes="Bold"
                                        FontSize="22"
                                        TextColor="White"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>

                                </Frame>

                                <!-- نقطة الاتصال الديناميكية المدمجة باحترافية -->
                                <Border
                                    WidthRequest="16"
                                    HeightRequest="16"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="0"
                                    Stroke="White"
                                    StrokeThickness="2"
                                    BackgroundColor="{Binding StatusColor}"
                                    HorizontalOptions="End"
                                    VerticalOptions="End"/>

                            </Grid>

                            <!-- الاسم -->

                            <VerticalStackLayout
                                Grid.Column="1"
                                Padding="15,0"
                                VerticalOptions="Center">

                                <Label
                                    Text="{Binding Name}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="#111827"/>

                                <Label
                                    Text="{Binding StatusText}"
                                    FontSize="13"
                                    TextColor="#6B7280"/>

                            </VerticalStackLayout>

                            <!-- السهم -->

                            <Label
                                Grid.Column="2"
                                Text="›"
                                FontSize="28"
                                VerticalOptions="Center"
                                TextColor="#C4C4C4"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- لا يوجد بيانات -->

        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="False"
            x:Name="EmptyLabel"
            VerticalOptions="Center"
            HorizontalOptions="Center">

            <Label
                Text="💬"
                FontSize="60"
                HorizontalOptions="Center"/>

            <Label
                Text="لا يوجد أصدقاء"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#6B7280"
                HorizontalOptions="Center"/>

            <Label
                Text="ابدأ بإضافة أصدقاء لبدء المحادثات."
                FontSize="14"
                TextColor="#9CA3AF"
                HorizontalOptions="Center"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>