<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.TenWordsPage"
             BackgroundColor="#080D18"
             Title="قاموس انجليش">

    <Grid Padding="16" RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" StrokeThickness="1.5" StrokeShape="RoundRectangle 22" Margin="0,0,0,18" Padding="18,18" BackgroundColor="#111827">

            <Border.Stroke>
                <LinearGradientBrush EndPoint="1,0">
                    <GradientStop Color="#38BDF8" Offset="0.0"/>
                    <GradientStop Color="#818CF8" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Stroke>

            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.25" Radius="12" Offset="0,5"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">

                <!-- الصف العلوي: الأرقام والكوينز -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <!-- الأرقام (اليمين) -->
                    <HorizontalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                        <Label Text="{Binding MemorizedWordsCount}" TextColor="#38BDF8" FontSize="18" FontFamily="CairoBold" VerticalOptions="Center"/>
                        <Label Text="/" TextColor="#64748B" FontSize="14" FontFamily="CairoBold" VerticalOptions="Center" Margin="0,2,0,0"/>
                        <Label Text="{Binding CurrentGoal}" TextColor="#64748B" FontSize="14" FontFamily="CairoBold" VerticalOptions="Center" Margin="0,2,0,0"/>
                    </HorizontalStackLayout>
                    
                    <!-- أدوات التحكم والكوينز (اليسار) -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">

                        <!-- زر التلقين الصوتي الدائري الأنيق -->
                        <Border x:Name="BtnAutoReciteIcon"
                                StrokeThickness="1"
                                Stroke="#38BDF8"
                                StrokeShape="RoundRectangle 18"
                                BackgroundColor="#0B111D"
                                WidthRequest="36"
                                HeightRequest="36"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAutoReciteTapped"/>
                            </Border.GestureRecognizers>
                            <Image x:Name="AutoReciteImage"
                                   Source="headphones_icon.svg"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <!-- الكوينز -->
                        <Border StrokeThickness="1" Stroke="#263B5E" StrokeShape="RoundRectangle 20" BackgroundColor="#0B111D" Padding="12,4,12,4" HeightRequest="36" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding ProgressStatus}" FontSize="16" TextColor="#FBBF24" FontFamily="CairoBold" VerticalOptions="Center"/>
                                <Image Source="coin.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" SemanticProperties.Description="أيقونة العملات"/>
                            </HorizontalStackLayout>
                        </Border>

                    </HorizontalStackLayout>
                </Grid>

                <!-- شريط التقدم -->
                <Grid x:Name="ProgressBarContainer" VerticalOptions="Center" FlowDirection="RightToLeft" SizeChanged="OnProgressBarContainerSizeChanged">
                    <Border HeightRequest="14" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 7"/>

                    <Border x:Name="ProgressBar" HeightRequest="14" WidthRequest="{Binding ProgressWidth}" HorizontalOptions="Start" StrokeShape="RoundRectangle 7" StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                <GradientStop Color="#14B8A6" Offset="0"/>
                                <GradientStop Color="#38BDF8" Offset="0.55"/>
                                <GradientStop Color="#818CF8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Border.Shadow>
                            <Shadow Brush="#2DD4BF" Opacity="0.5" Radius="8" Offset="0,0"/>
                        </Border.Shadow>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- الكلمات -->
        <CollectionView x:Name="CV" Grid.Row="1" ItemsSource="{Binding Titles}" SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="10"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="2">
                        <!-- التعديل هنا: زيادة الـ Padding العمودي من 16 إلى 24 لجعل الكروت أطول وأكثر راحة للعين -->
                        <Border StrokeThickness="1.5" StrokeShape="RoundRectangle 18" Padding="14,18" BackgroundColor="#121B2B" Stroke="{Binding CardStrokeBrush}">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWordTapped"/>
                                <TapGestureRecognizer Tapped="OnWordLanguageTapped" NumberOfTapsRequired="2"/>
                            </Border.GestureRecognizers>

                            <Border.Shadow>
                                <Shadow Brush="#000000" Opacity="0.18" Radius="8" Offset="0,3"/>
                            </Border.Shadow>

                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">

                                <!-- فراغ متوازن في الجانب الأيسر لضمان توسيط نص الكلمة بدقة -->
                                <BoxView Grid.Column="0" WidthRequest="38" HeightRequest="38" Color="Transparent"/>

                                <!-- نص الكلمة في المنتصف تماماً -->
                                <Label Grid.Column="1" 
                                       Text="{Binding DisplayText}" 
                                       TextColor="{Binding DisplayColor}" 
                                       FontSize="20" 
                                       FontFamily="CairoBold" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center" 
                                       LineBreakMode="TailTruncation"/>

                                <!-- زر الميكروفون التفاعلي لفحص النطق بالذكاء الاصطناعي -->
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 19"
                                        StrokeThickness="1.5"
                                        WidthRequest="38"
                                        HeightRequest="38"
                                        Background="{Binding MicButtonBgBrush}"
                                        Stroke="{Binding MicButtonBorderBrush}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMicTapped"/>
                                    </Border.GestureRecognizers>

                                    <Label Text="{Binding MicButtonIcon}"
                                           FontSize="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                            </Grid>

                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Padding="0,18,0,40" Spacing="8">
                    <Button Text="ابدأ التحدي ⚡" HeightRequest="60" WidthRequest="250" CornerRadius="30" BackgroundColor="#F43F5E" TextColor="White" Clicked="QuizButton_Clicked" FontFamily="CairoBold" FontSize="18" HorizontalOptions="Center"/>
                    <Label Text="اختبر الكلمات التي حفظتها" TextColor="#64748B" FontSize="12" FontFamily="Cairo" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>

    </Grid>
</ContentPage>