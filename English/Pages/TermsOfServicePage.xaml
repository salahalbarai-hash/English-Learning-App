<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.TermsOfServicePage"
             Title="شروط الخدمة"
             BackgroundColor="#13161C"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ══════════ الشريط العلوي (Header) ══════════ -->
        <Border Grid.Row="0"
                BackgroundColor="#1A1F28"
                StrokeThickness="0"
                Padding="16,40,16,14">
            <Grid ColumnDefinitions="45,*,45" VerticalOptions="Center">

                <!-- زر الرجوع -->
                <Border Grid.Column="0"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1"
                        Stroke="#2D333F"
                        BackgroundColor="#22262F"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="›"
                           FontSize="24"
                           TextColor="#9EA4B0"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="0,-2,0,0"/>
                </Border>

                <!-- العنوان المركزي -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="📜" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="شروط الخدمة"
                               FontSize="18"
                               FontFamily="CairoBold"
                               TextColor="#FFFFFF"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="تطبيق إنجليش (English)"
                           FontSize="11"
                           FontFamily="CairoRegular"
                           TextColor="#9EA4B0"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- عنصر موازن للشكل -->
                <BoxView Grid.Column="2" WidthRequest="40" HeightRequest="40" Color="Transparent"/>
            </Grid>
        </Border>

        <!-- ══════════ المحتوى الرئيسي ══════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,18,20,30" Spacing="16">

                <!-- بطاقة الترحيب والقبول -->
                <Border BackgroundColor="#22262F"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="#2D333F"
                        Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="🤝" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="1. قبول الشروط والغرض من التطبيق"
                                   FontSize="16"
                                   FontFamily="CairoBold"
                                   TextColor="#FFFFFF"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Text="مرحباً بك في تطبيق «إنجليش» (English). تم تصميم هذا التطبيق لتقديم تجربة تعليمية تفاعلية ممتعة تمكّنك من تعلم وحفظ مفردات اللغة الإنجليزية وخوض تحديات لغوية وتنافس شريف مع الأصدقاء واللاعبين."
                               FontSize="13"
                               FontFamily="CairoRegular"
                               TextColor="#9EA4B0"
                               LineHeight="1.5"/>
                        <Label Text="بمجرد إنشاء حسابك أو استخدام التطبيق، فإنك تقر وتوافق على الالتزام الكامل بهذه الشروط والأحكام. إذا كنت لا توافق على أي بند منها، فيرجى التوقف عن استخدام التطبيق فوراً."
                               FontSize="13"
                               FontFamily="CairoMedium"
                               TextColor="#38BDF8"
                               LineHeight="1.5"/>
                    </VerticalStackLayout>
                </Border>

                <!-- بطاقة سياسة المحتوى وسلوك المستخدم (UGC Policy) -->
                <Border BackgroundColor="#22262F"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1.5"
                        Stroke="#F59E0B"
                        Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="🛡️" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="2. سياسة المحتوى وسلوك المستخدم (UGC Policy)"
                                   FontSize="16"
                                   FontFamily="CairoBold"
                                   TextColor="#FFFFFF"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <!-- شارة إرشادية -->
                        <Border BackgroundColor="#2D2215"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0"
                                Padding="10,6"
                                HorizontalOptions="Start">
                            <Label Text="سياسة الاستخدام والمحتوى التفاعلي"
                                   FontSize="11"
                                   FontFamily="CairoBold"
                                   TextColor="#FBBF24"/>
                        </Border>

                        <Label Text="يتضمن تطبيق «إنجليش» ميزات تواصل ومحتوى ينشئه المستخدمون (UGC) مثل أسماء الحسابات، وقائمة الأصدقاء، والمحادثات النصية، وغرف التحدي المباشرة. لذلك نطبق سياسة عدم تسامح مطلق (Zero Tolerance) تجاه السلوكيات المسيئة:"
                               FontSize="13"
                               FontFamily="CairoRegular"
                               TextColor="#9EA4B0"
                               LineHeight="1.5"/>

                        <!-- المحظورات -->
                        <Label Text="المحظورات الصارمة:" FontSize="14" FontFamily="CairoBold" TextColor="#EF4444"/>

                        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                            <Label Text="⛔" FontSize="12" HorizontalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="يُمنع منعاً باتاً إرسال أو تداول أي رسائل مسيئة، غير لائقة، خادشة للحياء، تشهيرية، أو تحتوي على عبارات تحث على الكراهية، العنف، أو التمييز."
                                   FontSize="13" FontFamily="CairoRegular" TextColor="#9EA4B0" LineHeight="1.4"/>
                        </Grid>

                        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                            <Label Text="⛔" FontSize="12" HorizontalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="يُحظر مضايقة أو إزعاج أو تهديد أي مستخدم آخر، أو إرسال رسائل غير مرغوب فيها (Spam)."
                                   FontSize="13" FontFamily="CairoRegular" TextColor="#9EA4B0" LineHeight="1.4"/>
                        </Grid>

                        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                            <Label Text="⛔" FontSize="12" HorizontalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="يُمنع انتحال صفة الآخرين، أو اختيار أسماء مستخدمين بذيئة أو مضللة، أو محاولة التلاعب بنتائج التحديات والمسابقات عبر برمجيات خبيثة."
                                   FontSize="13" FontFamily="CairoRegular" TextColor="#9EA4B0" LineHeight="1.4"/>
                        </Grid>

                        <!-- آليات الحماية والإجراءات -->
                        <Label Text="آليات الحماية والإجراءات الفورية:" FontSize="14" FontFamily="CairoBold" TextColor="#10B981" Margin="0,4,0,0"/>

                        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                            <Label Text="✓" FontSize="14" TextColor="#10B981" HorizontalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="آلية الحظر: يتيح التطبيق إمكانية حظر أي صديق أو مستخدم مسيء فوراً لمنعه من المراسلة أو إرسال التحديات."
                                   FontSize="13" FontFamily="CairoRegular" TextColor="#9EA4B0" LineHeight="1.4"/>
                        </Grid>

                        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                            <Label Text="✓" FontSize="14" TextColor="#10B981" HorizontalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="الإبلاغ والمراجعة: يمكنك الإبلاغ عن أي انتهاك أو سلوك غير لائق من خلال أدوات الإبلاغ داخل التطبيق، وسيتم اتخاذ الإجراءات اللازمة بحزم وفورية."
                                   FontSize="13" FontFamily="CairoRegular" TextColor="#9EA4B0" LineHeight="1.4"/>
                        </Grid>

                        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                            <Label Text="✓" FontSize="14" TextColor="#EF4444" HorizontalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="سلطة الإدارة: تحتفظ إدارة التطبيق بالحق الكامل في تعليق، تقييد، أو حذف أي حساب ينتهك هذه القواعد بشكل دائم وفوري دون سابق إنذار ودون أي مسؤولية قانونية."
                                   FontSize="13" FontFamily="CairoBold" TextColor="#F87171" LineHeight="1.4"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- بطاقة حقوق الملكية الفكرية -->
                <Border BackgroundColor="#22262F"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="#2D333F"
                        Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="💡" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="3. حقوق الملكية الفكرية"
                                   FontSize="16"
                                   FontFamily="CairoBold"
                                   TextColor="#FFFFFF"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Label Text="كافة المواد والمحتويات المعروضة داخل تطبيق «إنجليش» محمية بموجب قوانين الملكية الفكرية وحقوق النشر:"
                               FontSize="13"
                               FontFamily="CairoRegular"
                               TextColor="#9EA4B0"
                               LineHeight="1.5"/>

                        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                            <Label Text="•" FontSize="16" TextColor="#38BDF8" HorizontalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="تشمل الحقوق: بنك الكلمات والترجمات، الأسئلة التعليمية، الخوارزميات التفاعلية، التصاميم الجرافيكية، شعار التطبيق، والأكواد المصدرية."
                                   FontSize="13" FontFamily="CairoRegular" TextColor="#9EA4B0" LineHeight="1.4"/>
                        </Grid>

                        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                            <Label Text="•" FontSize="16" TextColor="#38BDF8" HorizontalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="يُحظر نسخ، أو تعديل، أو إعادة نشر، أو هندسة عكسية لأي جزء من التطبيق دون الحصول على تصريح خطي مسبق من مطوري التطبيق."
                                   FontSize="13" FontFamily="CairoRegular" TextColor="#9EA4B0" LineHeight="1.4"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- بطاقة إخلاء المسؤولية والتعديلات -->
                <Border BackgroundColor="#22262F"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="#2D333F"
                        Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="⚖️" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="4. التعديلات وإخلاء المسؤولية"
                                   FontSize="16"
                                   FontFamily="CairoBold"
                                   TextColor="#FFFFFF"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                            <Label Text="🔹" FontSize="12" TextColor="#38BDF8" HorizontalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="طبيعة الخدمة: يُقدّم التطبيق «كما هو» (As-Is)، ونبذل قصارى جهدنا لضمان استقرار الخوادم ودقة المحتوى العلمي، ولكننا لا نضمن عدم حدوث انقطاعات تقنية طارئة."
                                   FontSize="13" FontFamily="CairoRegular" TextColor="#9EA4B0" LineHeight="1.4"/>
                        </Grid>

                        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                            <Label Text="🔹" FontSize="12" TextColor="#38BDF8" HorizontalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="تحديث الشروط: تحتفظ إدارة التطبيق بحق تحديث أو تعديل هذه الشروط في أي وقت لمواكبة التحديثات أو المتطلبات القانونية، وتصبح التعديلات سارية فور نشرها داخل التطبيق."
                                   FontSize="13" FontFamily="CairoRegular" TextColor="#9EA4B0" LineHeight="1.4"/>
                        </Grid>

                        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                            <Label Text="🔹" FontSize="12" TextColor="#38BDF8" HorizontalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="استمرارك في استخدام التطبيق بعد إجراء التعديلات يُعد موافقة صريحة على الشروط المحدثة."
                                   FontSize="13" FontFamily="CairoRegular" TextColor="#9EA4B0" LineHeight="1.4"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- حقوق النشر -->
                <VerticalStackLayout Spacing="4" Margin="0,10,0,10" HorizontalOptions="Center">
                    <Label Text="تطبيق إنجليش © 2026"
                           FontSize="12"
                           FontFamily="CairoRegular"
                           TextColor="#64748B"
                           HorizontalOptions="Center"/>
                    <Label Text="جميع الحقوق محفوظة"
                           FontSize="11"
                           FontFamily="CairoRegular"
                           TextColor="#475569"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
