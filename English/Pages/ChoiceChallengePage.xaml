<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.ChoiceChallengePage"
             FlowDirection="RightToLeft"
             NavigationPage.HasNavigationBar="False">

    <!-- خلفية متدرجة عصرية للشاشة بالكامل (مطابقة لتحدي الكتابة) -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#040814" Offset="0.0" />
            <GradientStop Color="#0B1528" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <!-- ============================================== -->
        <!-- 🟢 1. Setup View (Shown by default)            -->
        <!-- ============================================== -->
        <ScrollView x:Name="SetupView" IsVisible="True">
            <VerticalStackLayout Spacing="24" Padding="20,30,20,20">

                <!-- Header -->
                <Grid ColumnDefinitions="Auto, *">
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Margin="-44,0,0,0" Spacing="4">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="⚡" FontSize="26" VerticalOptions="Center"/>
                            <Label Text="تحدي الخيارات" FontSize="24" FontFamily="CairoBold" TextColor="White"/>
                        </HorizontalStackLayout>
                        <Label Text="اختر الترجمة الصحيحة في أسرع وقت ممكن" FontSize="13" FontFamily="CairoRegular" TextColor="#94A3B8" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Memorized Words Stats Card -->
                <Border BackgroundColor="#121B2D" Stroke="#23344D" StrokeThickness="1.5" StrokeShape="RoundRectangle 20" Padding="18">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                        <Border Grid.Column="0" WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 25" StrokeThickness="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#047857" Offset="0.0" />
                                    <GradientStop Color="#047857" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Label Text="📚" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="إجمالي الكلمات المحفوظة" FontSize="13" FontFamily="CairoRegular" TextColor="#94A3B8"/>
                            <HorizontalStackLayout Spacing="6">
                                <Label x:Name="MaxWordsLabel" Text="0" FontSize="22" FontFamily="CairoBold" TextColor="#34D399"/>
                                <Label Text="كلمة جاهزة للاختبار" FontSize="15" FontFamily="CairoBold" TextColor="White" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Mode Selection -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="وضع اللعب" FontSize="15" FontFamily="CairoBold" TextColor="#CBD5E1"/>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <Border x:Name="SinglePlayerCard" Grid.Column="0" BackgroundColor="#0C1B2A" Stroke="#34D399" StrokeThickness="2" StrokeShape="RoundRectangle 18" Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSinglePlayerTapped"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="👤" FontSize="28" HorizontalOptions="Center"/>
                                <Label x:Name="SinglePlayerText" Text="لعب فردي" FontSize="15" FontFamily="CairoBold" TextColor="White" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="MultiplayerCard" Grid.Column="1" BackgroundColor="#101726" Stroke="#23344D" StrokeThickness="1.5" StrokeShape="RoundRectangle 18" Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMultiplayerTapped"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="👥" FontSize="28" HorizontalOptions="Center"/>
                                <Label x:Name="MultiplayerText" Text="تحدي صديق" FontSize="15" FontFamily="CairoBold" TextColor="#64748B" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Game Settings Card -->
                <Border BackgroundColor="#121B2D" Stroke="#23344D" StrokeThickness="1.5" StrokeShape="RoundRectangle 20" Padding="18">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="إعدادات الجولة" FontSize="15" FontFamily="CairoBold" TextColor="#CBD5E1"/>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="عدد الأسئلة:" FontSize="13" FontFamily="CairoRegular" TextColor="#94A3B8"/>
                            <Border BackgroundColor="#0B1320" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,2">
                                <Entry x:Name="WordsCountEntry" Text="10" Keyboard="Numeric" TextColor="White" FontFamily="CairoBold" FontSize="16" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="الزمن لكل سؤال (ثواني):" FontSize="13" FontFamily="CairoRegular" TextColor="#94A3B8"/>
                            <Border BackgroundColor="#0B1320" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,2">
                                <Entry x:Name="TimePerQuestionEntry" Text="5" Keyboard="Numeric" TextColor="White" FontFamily="CairoBold" FontSize="16" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Start Button -->
                <Button x:Name="StartGameButton" Text="🚀 بدء التحدي" TextColor="White" FontFamily="CairoBold" FontSize="18" HeightRequest="56" CornerRadius="18" Margin="0,10,0,20" Clicked="OnStartChallengeClicked">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0284C7" Offset="0.0" />
                            <GradientStop Color="#0EA5E9" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ============================================== -->
        <!-- 🟢 2. Game View (Active Gameplay)              -->
        <!-- ============================================== -->
        <Grid x:Name="GameView" RowDefinitions="Auto, *" IsVisible="False">
            <!-- Header (Modern Curved) -->
            <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="#0A111F">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,35,35"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,5" Radius="15" Opacity="0.3"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,20,20,24">
                    <Button Grid.Column="0" Text="➔" FontSize="18" FontAttributes="Bold" TextColor="White" BackgroundColor="#1E293B" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" Clicked="OnBackClicked"/>

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                        <Label x:Name="TimerLabel" Text="5" FontSize="26" FontFamily="CairoBold" TextColor="#38BDF8" HorizontalOptions="Center">
                            <Label.Shadow>
                                <Shadow Brush="#38BDF8" Radius="8" Opacity="0.5"/>
                            </Label.Shadow>
                        </Label>
                        <ProgressBar x:Name="TimerProgress" Progress="1.0" ProgressColor="#0EA5E9" HeightRequest="8" WidthRequest="120" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                        <Border BackgroundColor="#0369A1" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,6">
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label x:Name="MyNameLabel" Text="أنا" FontSize="13" FontFamily="CairoBold" TextColor="#E0F2FE"/>
                                <Label x:Name="ScoreLabel" Text="0" FontSize="15" FontFamily="CairoBold" TextColor="White"/>
                            </HorizontalStackLayout>
                        </Border>
                        <Border x:Name="OpponentScoreContainer" IsVisible="False" BackgroundColor="#991B1B" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,6">
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label x:Name="OpponentNameLabel" Text="الخصم" FontSize="13" FontFamily="CairoBold" TextColor="#FEE2E2"/>
                                <Label x:Name="OpponentScoreLabel" Text="0" FontSize="15" FontFamily="CairoBold" TextColor="White"/>
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Gameplay Area -->
            <Grid Grid.Row="1" Padding="20">
                <VerticalStackLayout VerticalOptions="Center" Spacing="24" Margin="0,-20,0,0">

                    <!-- بنر إشعار انسحاب الخصم -->
                    <Border x:Name="WithdrawalBanner" IsVisible="False" BackgroundColor="#2D1517" Stroke="#EF4444" StrokeThickness="2" StrokeShape="RoundRectangle 18" Padding="16,14" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="⚠️" FontSize="22" VerticalOptions="Center"/>
                                <Label x:Name="WithdrawalTextLabel" Text="اللاعب انسحب من التحدي!" TextColor="#FCA5A5" FontSize="16" FontFamily="CairoBold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="🏆 تم إنهاء التحدي واحتساب الفوز لصالحك تلقائياً!" TextColor="#FDE68A" FontSize="13" FontFamily="CairoBold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- رقم السؤال -->
                    <Border BackgroundColor="#121B2D" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14,6" HorizontalOptions="Center">
                        <Label x:Name="QuestionIndexLabel" Text="سؤال 1 من 10" TextColor="#94A3B8" FontSize="13" FontFamily="CairoBold"/>
                    </Border>

                    <!-- الكلمة المراد ترجمتها -->
                    <Label x:Name="QuestionWordLabel" Text="Word" TextColor="White" FontSize="46" HorizontalOptions="Center" HorizontalTextAlignment="Center" FontFamily="CairoBold" Margin="0,0,0,15">
                        <Label.Shadow>
                            <Shadow Brush="#0EA5E9" Offset="0,0" Radius="25" Opacity="0.6"/>
                        </Label.Shadow>
                    </Label>

                    <!-- شبكة الخيارات الأربعة (بنفس ستايل حقل الإدخال في تحدي الكتابة) -->
                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center" AlignContent="Center">
                        <Border x:Name="OptionBorder0" FlexLayout.Basis="48%" HeightRequest="95" Margin="0,0,0,14" BackgroundColor="#121B2D" StrokeThickness="1.5" Stroke="#23344D" StrokeShape="RoundRectangle 18">
                            <Border.Shadow>
                                <Shadow Brush="#0EA5E9" Offset="0,0" Radius="5" Opacity="0.1" />
                            </Border.Shadow>
                            <Label x:Name="OptionBtn0" Text="الخيار الأول" TextColor="White" FontSize="18" FontFamily="CairoBold" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOptionClicked" CommandParameter="0"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <Border x:Name="OptionBorder1" FlexLayout.Basis="48%" HeightRequest="95" Margin="0,0,0,14" BackgroundColor="#121B2D" StrokeThickness="1.5" Stroke="#23344D" StrokeShape="RoundRectangle 18">
                            <Border.Shadow>
                                <Shadow Brush="#0EA5E9" Offset="0,0" Radius="5" Opacity="0.1" />
                            </Border.Shadow>
                            <Label x:Name="OptionBtn1" Text="الخيار الثاني" TextColor="White" FontSize="18" FontFamily="CairoBold" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOptionClicked" CommandParameter="1"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <Border x:Name="OptionBorder2" FlexLayout.Basis="48%" HeightRequest="95" Margin="0,0,0,14" BackgroundColor="#121B2D" StrokeThickness="1.5" Stroke="#23344D" StrokeShape="RoundRectangle 18">
                            <Border.Shadow>
                                <Shadow Brush="#0EA5E9" Offset="0,0" Radius="5" Opacity="0.1" />
                            </Border.Shadow>
                            <Label x:Name="OptionBtn2" Text="الخيار الثالث" TextColor="White" FontSize="18" FontFamily="CairoBold" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOptionClicked" CommandParameter="2"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <Border x:Name="OptionBorder3" FlexLayout.Basis="48%" HeightRequest="95" Margin="0,0,0,14" BackgroundColor="#121B2D" StrokeThickness="1.5" Stroke="#23344D" StrokeShape="RoundRectangle 18">
                            <Border.Shadow>
                                <Shadow Brush="#0EA5E9" Offset="0,0" Radius="5" Opacity="0.1" />
                            </Border.Shadow>
                            <Label x:Name="OptionBtn3" Text="الخيار الرابع" TextColor="White" FontSize="18" FontFamily="CairoBold" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOptionClicked" CommandParameter="3"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </FlexLayout>

                    <!-- زر السؤال التالي (بنفس لون زر تحدي الكتابة) -->
                    <Button x:Name="NextButton" Text="السؤال التالي ➔" TextColor="White" FontFamily="CairoBold" FontSize="17" HeightRequest="56" CornerRadius="18" Margin="0,10,0,0" IsVisible="False" Clicked="OnNextClicked">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0284C7" Offset="0.0" />
                                <GradientStop Color="#0EA5E9" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>