<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.SettingsPage"
             BackgroundColor="#0B1120"
             FlowDirection="RightToLeft">

    <Grid>
        <!-- ══════════ الخلفية العلوية (متدرجة) ══════════ -->
        <Border VerticalOptions="Start" HeightRequest="160" StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6366F1" Offset="0.0" />
                    <GradientStop Color="#3B82F6" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="0,0,0,30">

                <!-- ══════════ صورة الملف الشخصي ══════════ -->
                <Grid HeightRequest="120" Margin="0,100,0,0">
                    <Border WidthRequest="100" HeightRequest="100"
                            StrokeShape="RoundRectangle 50"
                            StrokeThickness="4"
                            Stroke="#0B1120"
                            BackgroundColor="#1E293B"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,8" Radius="15" Opacity="0.4"/>
                        </Border.Shadow>
                        <Image Source="user.png" WidthRequest="45" HeightRequest="45" VerticalOptions="Center" HorizontalOptions="Center" Opacity="0.8" />
                    </Border>
                </Grid>

                <Label Text="البيانات الشخصية" 
                       FontFamily="CairoBold"
                       FontSize="22" 
                       TextColor="#F8FAFC" 
                       HorizontalOptions="Center" 
                       Margin="0,10,0,25" />

                <!-- ══════════ بطاقة الحقول ══════════ -->
                <Border Margin="24,0"
                        StrokeShape="RoundRectangle 24"
                        StrokeThickness="1"
                        Stroke="#1E293B"
                        BackgroundColor="#0F172A"
                        Padding="24,30">

                    <VerticalStackLayout Spacing="22">
                        
                        <!-- حقل اسم المستخدم -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="اسم المستخدم" TextColor="#94A3B8" FontSize="13" FontAttributes="Bold" Margin="4,0,0,0"/>
                            <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#334155" BackgroundColor="#1E293B" Padding="16,4">
                                <Entry Text="{Binding UserName}" Placeholder="أدخل اسمك هنا..." PlaceholderColor="#64748B" BackgroundColor="Transparent" TextColor="#F8FAFC" FontSize="15" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- حقل كلمة المرور -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="كلمة المرور" TextColor="#94A3B8" FontSize="13" FontAttributes="Bold" Margin="4,0,0,0"/>
                            <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#334155" BackgroundColor="#1E293B" Padding="16,4">
                                <Entry Text="{Binding Password}" IsPassword="True" Placeholder="••••••••" PlaceholderColor="#64748B" BackgroundColor="Transparent" TextColor="#F8FAFC" FontSize="15" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- حقل رقم الهاتف -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="رقم الهاتف" TextColor="#94A3B8" FontSize="13" FontAttributes="Bold" Margin="4,0,0,0"/>
                            <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#334155" BackgroundColor="#1E293B" Padding="16,4">
                                <Entry Text="{Binding PhoneNumber}" Keyboard="Telephone" Placeholder="مثال: 783982339" PlaceholderColor="#64748B" BackgroundColor="Transparent" TextColor="#F8FAFC" FontSize="15" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- زر حفظ التعديلات -->
                        <Border Margin="0,15,0,0"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                HeightRequest="56">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0.0" />
                                    <GradientStop Color="#4F46E5" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#6366F1" Offset="0,6" Radius="12" Opacity="0.4"/>
                            </Border.Shadow>
                            
                            <Button Text="حفظ التعديلات" 
                                    Command="{Binding SaveCustomerInformationCommand}"
                                    BackgroundColor="Transparent" 
                                    TextColor="White"
                                    FontFamily="CairoBold"
                                    FontSize="16" />
                        </Border>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- زر الرجوع (إغلاق الشاشة) في الأعلى يميناً (لأن الاتجاه RightToLeft) -->
        <Border WidthRequest="40" HeightRequest="40" 
                StrokeShape="RoundRectangle 20" StrokeThickness="0" 
                BackgroundColor="#20FFFFFF" 
                HorizontalOptions="Start" VerticalOptions="Start" 
                Margin="20,40,20,0">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseClicked" />
            </Border.GestureRecognizers>
            <Label Text="✕" FontSize="18" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Border>

        <!-- ══════════ نافذة التحميل ══════════ -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#900B1120" IsVisible="{Binding IsBusy, FallbackValue=False}">
            <Border HorizontalOptions="Center" VerticalOptions="Center" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#1E293B" BackgroundColor="#0F172A" Padding="30">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,10" Radius="30" Opacity="0.5"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="15">
                    <ActivityIndicator x:Name="ActivityIndicator" 
                                       IsRunning="{Binding IsBusy, FallbackValue=False}" 
                                       Color="#6366F1" 
                                       WidthRequest="50" 
                                       HeightRequest="50" 
                                       HorizontalOptions="Center"/>
                    <Label Text="جاري حفظ البيانات..." TextColor="#F8FAFC" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>