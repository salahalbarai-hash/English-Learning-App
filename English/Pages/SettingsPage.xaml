<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.SettingsPage"
             BackgroundColor="#F4F7FC"
             FlowDirection="RightToLeft">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="0,0,0,30">

                <!-- الهيدر (رأس الصفحة) -->
                <Grid HeightRequest="180" BackgroundColor="#68A5E9">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                        <Label Text="" TextColor="White" FontSize="26" FontFamily="CairoBold" HorizontalOptions="Center"/>
                        <Label Text="" FontAttributes="Bold" TextColor="#E0F0FF" FontSize="20" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- بطاقة إعدادات الحساب الأساسية -->
                <Border Margin="20,-30,20,20"
                        StrokeShape="RoundRectangle 25"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="25,35,25,35">

                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.08"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">
                        <Label Text="تحديث البيانات الشخصية" TextColor="#333333" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,10"/>

                        <!-- حقل اسم المستخدم -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="اسم المستخدم" TextColor="#555555" FontSize="14" FontAttributes="Bold" Margin="5,0,0,0"/>
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E8EEF2" BackgroundColor="#F8FAFC" Padding="15,0">
                                <Entry Text="{Binding UserName}" Placeholder="أدخل اسمك هنا..." BackgroundColor="Transparent" TextColor="#333333" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- حقل كلمة المرور -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="كلمة المرور" TextColor="#555555" FontSize="14" FontAttributes="Bold" Margin="5,0,0,0"/>
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E8EEF2" BackgroundColor="#F8FAFC" Padding="15,0">
                                <Entry Text="{Binding Password}" IsPassword="True" Placeholder="••••••••" BackgroundColor="Transparent" TextColor="#333333" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- حقل رقم الهاتف -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="رقم الهاتف" TextColor="#555555" FontSize="14" FontAttributes="Bold" Margin="5,0,0,0"/>
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E8EEF2" BackgroundColor="#F8FAFC" Padding="15,0">
                                <Entry Text="{Binding PhoneNumber}" Keyboard="Telephone" Placeholder="مثال: 783982339" BackgroundColor="Transparent" TextColor="#333333" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- زر حفظ التعديلات (خاص فقط بالبيانات أعلاه) -->
                        <Button Text="حفظ التعديلات" 
                                Command="{Binding SaveCustomerInformationCommand}"
                                BackgroundColor="#68A5E9" 
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                CornerRadius="15"
                                HeightRequest="55"
                                Margin="0,15,0,0">
                            <Button.Shadow>
                                <Shadow Brush="#68A5E9" Offset="0,6" Radius="12" Opacity="0.4"/>
                            </Button.Shadow>
                        </Button>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- نافذة التحميل -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#90000000" IsVisible="{Binding IsBusy, FallbackValue=False}">
            <Frame HorizontalOptions="Center" VerticalOptions="Center" CornerRadius="20" BackgroundColor="White" Padding="30" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <ActivityIndicator x:Name="ActivityIndicator" 
                                       IsRunning="{Binding IsBusy, FallbackValue=False}" 
                                       Color="#68A5E9" 
                                       WidthRequest="60" 
                                       HeightRequest="60" 
                                       HorizontalOptions="Center"/>
                    <Label Text="جاري حفظ البيانات..." TextColor="#555555" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>