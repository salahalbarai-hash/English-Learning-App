<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:English.ViewModels"
             xmlns:models="clr-namespace:Shared.Models;assembly=Shared"
             x:Class="English.Pages.LeadersPage"
             x:DataType="vm:LeadersPageVM"
             BackgroundColor="#080D18"
             FlowDirection="RightToLeft"
             Title="لوحة المتصدرين">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#080D18" Offset="0.0"/>
            <GradientStop Color="#0B1324" Offset="0.5"/>
            <GradientStop Color="#090E1A" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <!-- تقسيم الشاشة: الهيدر في صف ثابت، والقائمة في صف قابل للتمرير -->
        <Grid RowDefinitions="Auto, *" Padding="16,10,16,0">

            <!-- ========================================== -->
            <!-- 1. الهيدر الفاخر المدمج (متناسق مع الهوية) -->
            <!-- ========================================== -->
            <Border Grid.Row="0"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 22"
                    Margin="0,4,0,12"
                    Padding="16,14"
                    BackgroundColor="#101726">

                <!-- تدرج نيون أيقوني مطابق للهوية (Sky Cyan to Indigo) -->
                <Border.Stroke>
                    <LinearGradientBrush EndPoint="1,0">
                        <GradientStop Color="#38BDF8" Offset="0.0"/>
                        <GradientStop Color="#818CF8" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Stroke>

                <!-- ظل الهيدر -->
                <Border.Shadow>
                    <Shadow Brush="#000000" Radius="12" Offset="0,4" Opacity="0.3"/>
                </Border.Shadow>

                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">

                    <!-- معلومات العنوان وأيقونة الكأس -->
                    <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                        <!-- أيقونة الكأس مع خلفية مضيئة -->
                        <Border WidthRequest="48"
                                HeightRequest="48"
                                BackgroundColor="#162238"
                                Stroke="#38BDF8"
                                StrokeThickness="1.2"
                                StrokeShape="RoundRectangle 24"
                                VerticalOptions="Center">
                            <Border.Shadow>
                                <Shadow Brush="#38BDF8" Radius="8" Opacity="0.3" Offset="0,0"/>
                            </Border.Shadow>

                            <Label Text="🏆" FontSize="25" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="لوحة المتصدرين" 
                                   FontSize="20" 
                                   FontFamily="CairoBold" 
                                   TextColor="White"
                                   CharacterSpacing="0.5"/>
                            <Label Text="أبطال إنجليش الأكثر تميزاً 🔥"
                                   FontSize="11.5"
                                   FontFamily="Cairo"
                                   TextColor="#94A3B8"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- زر التحديث الزجاجي المتفاعل -->
                    <Border Grid.Column="1"
                            BackgroundColor="#090E17"
                            Stroke="#263B5E"
                            StrokeThickness="1.2"
                            StrokeShape="RoundRectangle 18"
                            Padding="12,7"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="RefreshButton_Clicked" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                            <!-- مؤشر التحميل الدوار يظهر فقط أثناء التحديث -->
                            <ActivityIndicator IsRunning="{Binding IsRefreshing}"
                                               IsVisible="{Binding IsRefreshing}"
                                               Color="#38BDF8"
                                               WidthRequest="14"
                                               HeightRequest="14"
                                               VerticalOptions="Center"/>

                            <Label Text="{Binding RefreshButtonText}"
                                   TextColor="#38BDF8"
                                   FontSize="12.5"
                                   FontFamily="CairoBold"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 2. قائمة المتصدرين (Dark Luxury Podiums)   -->
            <!-- ========================================== -->
            <CollectionView Grid.Row="1"
                            x:Name="CV"
                            ItemsSource="{Binding TopTenLeaders}"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never"
                            MaximumWidthRequest="650"
                            HorizontalOptions="Center">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="1"
                                     VerticalItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Leader">
                        <Grid Padding="0,2">

                            <!-- بطاقة المتصدر الداكنة الفاخرة مع إطار نيون للمراكز -->
                            <Border StrokeThickness="1.2"
                                    StrokeShape="RoundRectangle 18"
                                    Stroke="{Binding RankColor}"
                                    HeightRequest="86"
                                    Padding="12,0">

                                <!-- خلفية متدرجة ليلية -->
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#152238" Offset="0.0"/>
                                        <GradientStop Color="#0F192A" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <!-- ظل ناعم للبطاقة -->
                                <Border.Shadow>
                                    <Shadow Brush="#000000" Radius="8" Offset="0,3" Opacity="0.25"/>
                                </Border.Shadow>

                                <!-- محتوى البطاقة -->
                                <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="10" VerticalOptions="Center">

                                    <!-- دائرة الترتيب الفاخرة -->
                                    <Border Grid.Column="0"
                                            WidthRequest="46"
                                            HeightRequest="46"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 23"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center">

                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{Binding RankColor}" Offset="0"/>
                                                <GradientStop Color="{Binding RankColor}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>

                                        <Border.Shadow>
                                            <Shadow Brush="{Binding RankColor}" Radius="8" Offset="0,2" Opacity="0.35"/>
                                        </Border.Shadow>

                                        <Label Text="{Binding Rank}" 
                                               TextColor="White" 
                                               FontSize="18.5" 
                                               FontFamily="CairoBold" 
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Center"/>
                                    </Border>

                                    <!-- بيانات المستخدم -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                        <!-- اسم المستخدم -->
                                        <Label Text="{Binding UserName}" 
                                               FontSize="15.5" 
                                               FontFamily="CairoBold" 
                                               TextColor="#F8FAFC"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"/>

                                        <!-- الشارات (كلمات + كوينز) -->
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <!-- شارة الكلمات المحفوظة -->
                                            <Border BackgroundColor="#172554" 
                                                    Stroke="#1E3A8A"
                                                    StrokeThickness="1" 
                                                    StrokeShape="RoundRectangle 10" 
                                                    Padding="8,2.5">
                                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                    <Label Text="📚" FontSize="11" VerticalOptions="Center"/>
                                                    <Label Text="{Binding MemorizedWords}" 
                                                           FontSize="11.5" 
                                                           FontFamily="CairoBold" 
                                                           TextColor="#38BDF8"
                                                           VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </Border>

                                            <!-- شارة الكوينز -->
                                            <Border BackgroundColor="#2E1E07" 
                                                    Stroke="#78350F"
                                                    StrokeThickness="1" 
                                                    StrokeShape="RoundRectangle 10" 
                                                    Padding="8,2.5">
                                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                    <Label Text="🪙" FontSize="11" VerticalOptions="Center"/>
                                                    <Label Text="{Binding Coins}" 
                                                           FontSize="11.5" 
                                                           FontFamily="CairoBold" 
                                                           TextColor="#FBBF24"
                                                           VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- الميداليات -->
                                    <Grid Grid.Column="2" WidthRequest="44" VerticalOptions="Center" HorizontalOptions="Center">
                                        <Label Text="🥇" FontSize="28" IsVisible="{Binding IsFirst}" HorizontalOptions="Center"/>
                                        <Label Text="🥈" FontSize="28" IsVisible="{Binding IsSecond}" HorizontalOptions="Center"/>
                                        <Label Text="🥉" FontSize="28" IsVisible="{Binding IsThird}" HorizontalOptions="Center"/>

                                        <Border IsVisible="{Binding IsNotTopThree}" 
                                                BackgroundColor="#2A101A" 
                                                Stroke="#881337"
                                                StrokeThickness="1" 
                                                StrokeShape="RoundRectangle 12" 
                                                Padding="7,4" 
                                                HorizontalOptions="Center">
                                            <Label Text="🔥" FontSize="15"/>
                                        </Border>
                                    </Grid>

                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- مسافة التنفس أسفل القائمة -->
                <CollectionView.Footer>
                    <BoxView HeightRequest="25" Color="Transparent"/>
                </CollectionView.Footer>

            </CollectionView>

        </Grid>

        <!-- ========================================== -->
        <!-- 3. شاشات الحالات (Overlay) للتحميل والخطأ  -->
        <!-- ========================================== -->
        <!-- غطاء زجاجي ضبابي داكن يغطي الشاشة عند التحميل الأولي -->
        <Border BackgroundColor="#E6080D18"
                StrokeThickness="0"
                ZIndex="10"
                IsVisible="{Binding ShowOverlay}">

            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="24" Padding="24">

                <!-- حالة جاري التحميل -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsBusy}">
                    <ActivityIndicator IsRunning="True" Color="#38BDF8" WidthRequest="55" HeightRequest="55"/>
                    <Label Text="جاري جلب أبطال إنجليش..." FontSize="16" TextColor="#38BDF8" FontFamily="CairoBold" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- حالة خطأ الاتصال -->
                <VerticalStackLayout Spacing="18" IsVisible="{Binding IsErrorVisible}">
                    <Image Source="no_internet_icon.png" WidthRequest="75" HeightRequest="75" Opacity="0.85"/>
                    <Label Text="عذراً، تأكد من اتصالك بالإنترنت" FontSize="17" FontFamily="CairoBold" TextColor="#F8FAFC" HorizontalOptions="Center"/>

                    <Button Text="إعادة المحاولة" 
                            Clicked="RefreshButton_Clicked" 
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="#0284C7" 
                            TextColor="White" 
                            CornerRadius="25" 
                            Padding="35,13" 
                            FontSize="15"
                            FontFamily="CairoBold"
                            Shadow="{Shadow Brush='#0284C7', Opacity=0.35, Radius=10, Offset='0,3'}"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
