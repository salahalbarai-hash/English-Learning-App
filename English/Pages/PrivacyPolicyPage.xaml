<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.PrivacyPolicyPage"
             Title="سياسة الخصوصية"
             BackgroundColor="#13161C"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ══════════ الشريط العلوي (Header) ══════════ -->
        <Grid Grid.Row="0"
              BackgroundColor="#1A1F28"
              Padding="18,42,18,14"
              ColumnDefinitions="40,*,40"
              VerticalOptions="Center">

            <!-- زر الرجوع -->
            <Border Grid.Column="0"
                    WidthRequest="38"
                    HeightRequest="38"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="#2D333F"
                    BackgroundColor="#22262F"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <Label Text="›"
                       FontSize="24"
                       TextColor="#9EA4B0"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,-2,0,0"/>
            </Border>

            <!-- عنوان الصفحة -->
            <Label Grid.Column="1"
                   Text="سياسة الخصوصية"
                   FontSize="18"
                   FontFamily="CairoBold"
                   FontAutoScalingEnabled="True"
                   TextColor="#FFFFFF"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

            <!-- موازن للشكل -->
            <BoxView Grid.Column="2" WidthRequest="40" Color="Transparent"/>
        </Grid>

        <!-- ══════════ المحتوى الرئيسي (نمط المستند المتصل) ══════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,18,22,35" Spacing="0">

                <!-- تاريخ آخر تحديث -->
                <Label Text="آخر تحديث: أكتوبر 2026"
                       FontSize="12"
                       FontFamily="CairoRegular"
                       TextColor="#64748B"
                       Margin="0,0,0,12"/>

                <!-- مقدمة ترحيبية -->
                <Label Text="مرحباً بك في تطبيق «إنجليش» (English). نحن نولي حماية خصوصيتك وأمان بياناتك أهمية قصوى. توضح هذه الوثيقة طبيعة المعلومات التي يتم جمعها عند استخدام التطبيق، والغرض من استخدامها، وضوابط الاستخدام التفاعلي، وكيفية ممارسة حقك الكامل في إدارة بياناتك وحذف حسابك نهائياً."
                       FontSize="14"
                       FontFamily="CairoRegular"
                       TextColor="#C5CAD3"
                       LineHeight="1.6"
                       Margin="0,0,0,6"/>

                <!-- خط فاصل -->
                <BoxView Color="#22262F" HeightRequest="1" Margin="0,18" HorizontalOptions="Fill"/>

                <!-- ══════════ 1. البيانات التي نجمعها ══════════ -->
                <Label Text="1. البيانات التي نجمعها"
                       FontSize="17"
                       FontFamily="CairoBold"
                       FontAutoScalingEnabled="True"
                       TextColor="#FFFFFF"
                       Margin="0,0,0,10"/>

                <Label Text="لتقديم تجربة تعليمية وتنافسية شاملة، نقوم بجمع ومعالجة البيانات الضرورية التالية:"
                       FontSize="14"
                       FontFamily="CairoRegular"
                       TextColor="#C5CAD3"
                       LineHeight="1.6"
                       Margin="0,0,0,12"/>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6" Margin="0,0,0,8">
                    <Label Text="•" FontSize="16" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="بيانات الحساب الأساسية: اسم المستخدم، وكلمة المرور المشفرة بشكل آمن، ورقم الهاتف (اختياري للتحقق والتواصل)."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6" Margin="0,0,0,8">
                    <Label Text="•" FontSize="16" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="مستوى تقدم التعلم والكلمات: قائمة الكلمات الإنجليزية المحفوظة، وتاريخ التقدم الدراسي، وإحصائيات الحفظ اليومي للمفردات."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6" Margin="0,0,0,8">
                    <Label Text="•" FontSize="16" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="التحديات ونقاط لوحة الصدارة: نتائج وسجلات التحديات (تحدي الخيارات، تحدي الكتابة، المفتش الذكي)، ورصيد العملات المكتسبة (Coins)، والترتيب العام في لوحة المتصدرين."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6" Margin="0,0,0,8">
                    <Label Text="•" FontSize="16" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="قائمة الأصدقاء: قائمة الأصدقاء المضافين وطلبات الصداقة المتبادلة للتفاعل وخوض المبارزات."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6">
                    <Label Text="•" FontSize="16" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="الرسائل والمحادثات: نصوص الرسائل المتبادلة بين الأصدقاء لتشغيل وتوفير خدمة المراسلة الفورية داخل التطبيق."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <!-- خط فاصل -->
                <BoxView Color="#22262F" HeightRequest="1" Margin="0,18" HorizontalOptions="Fill"/>

                <!-- ══════════ 2. كيفية استخدام البيانات ══════════ -->
                <Label Text="2. كيفية استخدام البيانات"
                       FontSize="17"
                       FontFamily="CairoBold"
                       FontAutoScalingEnabled="True"
                       TextColor="#FFFFFF"
                       Margin="0,0,0,10"/>

                <Label Text="نستخدم البيانات المجمعة لأغراض تحسين وتشغيل الخدمة التعليمية حصراً وفق الآتي:"
                       FontSize="14"
                       FontFamily="CairoRegular"
                       TextColor="#C5CAD3"
                       LineHeight="1.6"
                       Margin="0,0,0,12"/>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6" Margin="0,0,0,8">
                    <Label Text="•" FontSize="16" TextColor="#10B981" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="تشغيل وتفعيل الميزات التعليمية وحفظ تقدمك الدراسي لضمان استمراريته وعدم ضياعه عبر الأجهزة المختلفة."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6" Margin="0,0,0,8">
                    <Label Text="•" FontSize="16" TextColor="#10B981" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="إدارة ومزامنة التحديات التنافسية الحية بين الأصدقاء وتحديث الترتيب في لوحة الصدارة."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6">
                    <Label Text="•" FontSize="16" TextColor="#10B981" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="مراقبة استقرار الخوادم، وتحسين أداء التطبيق، ومعالجة أي أخطاء برمجية طارئة لتقديم تجربة تعليمية موثوقة."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <!-- خط فاصل -->
                <BoxView Color="#22262F" HeightRequest="1" Margin="0,18" HorizontalOptions="Fill"/>

                <!-- ══════════ 3. قواعد استخدام الرسائل والميزات التفاعلية ══════════ -->
                <Label Text="3. قواعد استخدام الرسائل والميزات التفاعلية"
                       FontSize="17"
                       FontFamily="CairoBold"
                       FontAutoScalingEnabled="True"
                       TextColor="#FFFFFF"
                       Margin="0,0,0,10"/>

                <Label Text="نظراً لاحتواء تطبيق «إنجليش» على ميزات تفاعلية تشمل المحادثات المباشرة بين الأصدقاء وغرف التحدي والمبارزات، فإن استخدام هذه الميزات يخضع للضوابط الآتية:"
                       FontSize="14"
                       FontFamily="CairoRegular"
                       TextColor="#C5CAD3"
                       LineHeight="1.6"
                       Margin="0,0,0,12"/>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6" Margin="0,0,0,8">
                    <Label Text="•" FontSize="16" TextColor="#F59E0B" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="الاحترام المتبادل: يلتزم المستخدم بالأخلاق والروح الرياضية وتجنب إرسال أو تداول أي محتوى مسيء، غير لائق، عنيف، تشهيري، أو يحث على الكراهية أو التمييز."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6" Margin="0,0,0,8">
                    <Label Text="•" FontSize="16" TextColor="#F59E0B" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="منع السلوكيات الضارة: يُمنع انتحال صفة الآخرين، أو إرسال رسائل غير مرغوب فيها (Spam)، أو محاولة التلاعب بنتائج المسابقات والتحديات بأي وسيلة غير مشروعة."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6" Margin="0,0,0,8">
                    <Label Text="•" FontSize="16" TextColor="#F59E0B" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="خيارات الحظر والإبلاغ: يوفر التطبيق خيارات مباشرة تمكّن المستخدم من حظر أي مستخدم مسيء فوراً والإبلاغ عن أي انتهاك لمراجعته واتخاذ الإجراء اللازم بحزم."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6">
                    <Label Text="•" FontSize="16" TextColor="#F59E0B" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="إجراءات الإدارة: تحتفظ إدارة التطبيق بالحق الكامل في تعليق، أو تقييد، أو إيقاف وحذف أي حساب ينتهك هذه القواعد فوراً وبشكل دائم دون سابق إنذار."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <!-- خط فاصل -->
                <BoxView Color="#22262F" HeightRequest="1" Margin="0,18" HorizontalOptions="Fill"/>

                <!-- ══════════ 4. أمان البيانات وحذف الحساب نهائياً ══════════ -->
                <Label Text="4. أمان البيانات وحذف الحساب نهائياً"
                       FontSize="17"
                       FontFamily="CairoBold"
                       FontAutoScalingEnabled="True"
                       TextColor="#FFFFFF"
                       Margin="0,0,0,10"/>

                <Label Text="نلتزم بأعلى معايير الحماية التقنية للمحافظة على بياناتك الشخصية وحقوقك الرقمية:"
                       FontSize="14"
                       FontFamily="CairoRegular"
                       TextColor="#C5CAD3"
                       LineHeight="1.6"
                       Margin="0,0,0,12"/>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6" Margin="0,0,0,8">
                    <Label Text="•" FontSize="16" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="حماية وتشفير البيانات: يتم تشفير كافة الاتصالات بين التطبيق والخوادم عبر بروتوكولات الأمان القياسية (HTTPS/TLS) مع حفظ البيانات الحساسة داخل التخزين الآمن للجهاز."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6" Margin="0,0,0,8">
                    <Label Text="•" FontSize="16" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="عدم مشاركة البيانات: نتعهد بعدم بيع أو تأجير أو مشاركة أي بيانات شخصية تخص المستخدمين مع أي جهات خارجية أو أطراف إعلانية."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6" Margin="0,0,0,8">
                    <Label Text="•" FontSize="16" TextColor="#EF4444" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="حق حذف الحساب والبيانات: يحق للمستخدم في أي وقت طلب وحذف حسابه وكافة بياناته المرتبطة به نهائياً وبكل سهولة من خلال إعدادات الحساب داخل التطبيق مباشرة."
                           FontSize="13.5" FontFamily="CairoBold" TextColor="#FFFFFF" LineHeight="1.5"/>
                </Grid>

                <Grid ColumnDefinitions="18,*" ColumnSpacing="6">
                    <Label Text="•" FontSize="16" TextColor="#EF4444" HorizontalOptions="Center" VerticalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="أثر الحذف الفوري: عند تأكيد الحذف، يتم مسح كافة سجلات المستخدم وبيانات الملف الشخصي ورصيد الكلمات والعملات والمحادثات من خوادمنا بشكل كلي ونهائي دون إمكانية استرجاعها."
                           FontSize="13.5" FontFamily="CairoRegular" TextColor="#C5CAD3" LineHeight="1.5"/>
                </Grid>

                <!-- خط فاصل -->
                <BoxView Color="#22262F" HeightRequest="1" Margin="0,18" HorizontalOptions="Fill"/>

                <!-- ══════════ حقوق النشر ══════════ -->
                <VerticalStackLayout Spacing="4" Margin="0,10,0,10" HorizontalOptions="Center">
                    <Label Text="تطبيق إنجليش © 2026"
                           FontSize="12"
                           FontFamily="CairoRegular"
                           TextColor="#64748B"
                           HorizontalOptions="Center"/>
                    <Label Text="جميع الحقوق محفوظة"
                           FontSize="11"
                           FontFamily="CairoRegular"
                           TextColor="#475569"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
