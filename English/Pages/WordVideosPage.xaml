<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="English.Pages.WordVideosPage"
             BackgroundColor="#0B0F1A"
             Title="ثبت ما تعلمته"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="20">

        <!-- Header -->
        <Border Grid.Row="0"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 25"
                Padding="20"
                BackgroundColor="#161E2E">

            <Border.Stroke>
                <LinearGradientBrush EndPoint="1,0">
                    <GradientStop Color="#38BDF8" Offset="0"/>
                    <GradientStop Color="#818CF8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Stroke>

            <VerticalStackLayout Spacing="8">
                <Label Text="🎯"
                       FontSize="38"
                       HorizontalOptions="Center"/>

                <Label Text="ثبت ما تعلمته"
                       FontSize="26"
                       TextColor="#38BDF8"
                       FontFamily="CairoBold"
                       HorizontalOptions="Center"/>

                <Label x:Name="WordsInfoLabel"
                       Text="سنبحث عن فيديو يناسب كلماتك"
                       FontSize="14"
                       TextColor="#94A3B8"
                       FontFamily="CairoBold"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>

        <!-- Search -->
        <Button Grid.Row="1"
                x:Name="SearchButton"
                Text="🎬 ابحث عن فيديو لتثبيت كلماتك"
                HeightRequest="55"
                Margin="0,20,0,15"
                CornerRadius="28"
                BackgroundColor="#38BDF8"
                TextColor="#0B0F1A"
                FontFamily="CairoBold"
                FontSize="16"
                Clicked="FindLearningVideo_Clicked"/>

        <!-- Video (MediaElement instead of WebView) -->
        <Border Grid.Row="2"
                BackgroundColor="Black"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 25">

            <toolkit:MediaElement x:Name="VideoPlayer"
                                  ShouldAutoPlay="True"
                                  Aspect="AspectFit"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill" />

        </Border>

        <!-- Another -->
        <Button Grid.Row="3"
                Text="🔄 فيديو آخر"
                HeightRequest="45"
                Margin="0,15,0,0"
                CornerRadius="22"
                BackgroundColor="#25FFFFFF"
                TextColor="#38BDF8"
                BorderColor="#38BDF8"
                BorderWidth="1"
                FontFamily="CairoBold"
                Clicked="AnotherVideo_Clicked"/>

        <!-- Loading -->
        <Border Grid.RowSpan="4"
                x:Name="LoadingOverlay"
                BackgroundColor="#CC0B0F1A"
                IsVisible="False"
                StrokeThickness="0">

            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="20">

                <ActivityIndicator IsRunning="True"
                                   Color="#38BDF8"
                                   WidthRequest="60"
                                   HeightRequest="60"/>

                <Label Text="جاري اختيار فيديو مناسب..."
                       TextColor="#38BDF8"
                       FontSize="16"
                       FontFamily="CairoBold"/>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>