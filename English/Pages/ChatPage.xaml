<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.ChatPage"
             BackgroundColor="{AppThemeBinding Light=#EFEAE2, Dark=#0B141A}"
             NavigationPage.HasNavigationBar="False">
    <!-- إخفاء شريط التنقل الافتراضي -->

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 🟢 1. ترويسة علوية احترافية (Custom Header) -->
        <Frame Grid.Row="0" 
               BackgroundColor="{AppThemeBinding Light=#00A884, Dark=#202C33}" 
               Padding="10,25,10,10" 
               HasShadow="True" 
               CornerRadius="0" 
               BorderColor="Transparent">

            <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                <!-- صورة الصديق ونقطة الاتصال المدمجة باحترافية -->
                <Grid Grid.Column="1" WidthRequest="46" HeightRequest="46" Margin="10,0" VerticalOptions="Center">
                    <Border WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 21" StrokeThickness="0" 
                            BackgroundColor="{AppThemeBinding Light=#DFDFDF, Dark=#6B7C85}" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label x:Name="FriendInitialLabel" Text="?" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#374151, Dark=#FFFFFF}" FontSize="18"/>
                    </Border>

                    <!-- نقطة الاتصال المدمجة مع قطع الاحترافي لـ Avatar -->
                    <Border x:Name="OnlineStatusIndicator" 
                            WidthRequest="14" HeightRequest="14" StrokeShape="RoundRectangle 7" Padding="0" 
                            BackgroundColor="#EF4444" 
                            Stroke="{AppThemeBinding Light=#00A884, Dark=#202C33}" StrokeThickness="2"
                            HorizontalOptions="End" VerticalOptions="End" Margin="0,0,1,1" />
                </Grid>

                <!-- اسم الصديق وحالته -->
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                    <Label x:Name="FriendNameTitle" Text="جاري التحميل..." FontAttributes="Bold" FontSize="17" 
                           TextColor="{AppThemeBinding Light=White, Dark=#E9EDEF}" />
                    <Label x:Name="FriendStatusLabel" Text="تحقق من الاتصال..." FontSize="13" 
                           TextColor="{AppThemeBinding Light=#D1D5DB, Dark=#8696A0}" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- 🟢 2. قائمة الرسائل (الدردشة) -->
        <CollectionView x:Name="MessagesList" Grid.Row="1" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,4">
                        <Frame HasShadow="False" 
                               CornerRadius="12"
                               Padding="10,6"
                               BackgroundColor="{Binding BubbleColor}"
                               HorizontalOptions="{Binding BubbleAlignment}"
                               MaximumWidthRequest="280">

                            <!-- ترتيب النص وفيه الوقت وحالة الرسالة -->
                            <Grid RowDefinitions="Auto, Auto">
                                <!-- نص الرسالة -->
                                <!-- تم تعديل لون النص ليتوافق مع الوضع الداكن -->
                                <Label Grid.Row="0" Text="{Binding Content}" FontSize="15" 
                                       TextColor="{AppThemeBinding Light=Black, Dark=#E9EDEF}" Margin="0,0,0,2"/>

                                <!-- الوقت وحالة القراءة -->
                                <HorizontalStackLayout Grid.Row="1" HorizontalOptions="End" Spacing="4">
                                    <Label Text="{Binding TimeString}" FontSize="11" 
                                           TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8696A0}" VerticalOptions="Center"/>
                                    <!-- علامة الصح -->
                                    <Label Text="{Binding StatusIconText}" 
                                           TextColor="{Binding StatusIconColor}" 
                                           FontSize="12" 
                                           IsVisible="{Binding IsMine}" 
                                           VerticalOptions="Center"
                                           FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 🟢 3. منطقة إدخال النص السفلية (عصرية) -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Padding="10" 
              BackgroundColor="{AppThemeBinding Light=#EFEAE2, Dark=#0B141A}">

            <Frame Grid.Column="0" Padding="15,0" CornerRadius="24" HasShadow="False" 
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#2A3942}" HeightRequest="48" VerticalOptions="Center">
                <Entry x:Name="MessageEntry" 
                       Placeholder="المراسلة..." 
                       PlaceholderColor="{AppThemeBinding Light=#667781, Dark=#8696A0}"
                       TextColor="{AppThemeBinding Light=Black, Dark=#E9EDEF}"
                       BackgroundColor="Transparent" 
                       ClearButtonVisibility="Never"
                       VerticalOptions="Center" />
            </Frame>

            <Frame Grid.Column="1" WidthRequest="48" HeightRequest="48" CornerRadius="24" 
                   BackgroundColor="{AppThemeBinding Light=#00A884, Dark=#00A884}" HasShadow="False" Padding="0" Margin="8,0,0,0">
                <ImageButton Source="send.png" BackgroundColor="Transparent" Clicked="OnSendClicked" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
        </Grid>

    </Grid>
</ContentPage>