<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:English.Pages"
             xmlns:models="clr-namespace:English.Models"
             x:Class="English.Pages.ChatPage"
             x:Name="ChatPageRoot"
             BackgroundColor="#0B1120"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ══════════ 1. ترويسة علوية احترافية (Header) ══════════ -->
        <!-- الهيدر الطبيعي -->
        <Border Grid.Row="0" StrokeThickness="0" Padding="0" x:Name="NormalHeader">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#151E2F" Offset="0.0" />
                    <GradientStop Color="#1A2540" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid ColumnDefinitions="Auto, Auto, *, Auto" Padding="16,40,16,14">
                <!-- زر الرجوع -->
                <Border Grid.Column="0" WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 19"
                        StrokeThickness="1" Stroke="#2A3855" BackgroundColor="#111827"
                        VerticalOptions="Center" Margin="0,0,12,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="❯" FontFamily="CairoBold" FontSize="18" TextColor="#F8FAFC"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- الأفاتار (الصورة الشخصية) -->
                <Border Grid.Column="1" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22"
                        StrokeThickness="2" Stroke="#38BDF8" BackgroundColor="#1E293B" VerticalOptions="Center">
                    <Label x:Name="FriendInitialLabel" Text="?" FontSize="18" FontFamily="CairoBold"
                           TextColor="#F8FAFC" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- معلومات الصديق -->
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Margin="12,0,0,0">
                    <Label x:Name="FriendNameTitle" Text="" FontFamily="CairoBold" FontSize="16" TextColor="#F8FAFC" LineBreakMode="TailTruncation" />
                    <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                        <Border x:Name="OnlineStatusIndicator" WidthRequest="8" HeightRequest="8" StrokeShape="RoundRectangle 4" BackgroundColor="#EF4444" VerticalOptions="Center" />
                        <Label x:Name="FriendStatusLabel" Text="غير متصل" FontSize="12" TextColor="#94A3B8" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- هيدر التحديد (Selection Header) يظهر عند بدء التحديد -->
        <Border Grid.Row="0" StrokeThickness="0" Padding="0" x:Name="SelectionHeader" IsVisible="False">
            <Border.Background>
                <SolidColorBrush Color="#1E293B" />
            </Border.Background>
            <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,40,16,14">

                <!-- زر الإلغاء -->
                <Border Grid.Column="0" WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 19"
                        StrokeThickness="0" BackgroundColor="#334155" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelSelectionClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="✕" FontFamily="CairoBold" FontSize="18" TextColor="#F8FAFC"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- عدد المحدد -->
                <Label Grid.Column="1" x:Name="SelectionCountLabel" Text="1 محدد" FontFamily="CairoBold" FontSize="18" TextColor="#F8FAFC" VerticalOptions="Center" HorizontalOptions="Center" />

                <!-- زر الحذف -->
                <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22"
                        StrokeThickness="0" BackgroundColor="#EF4444" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBulkDeleteClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="🗑️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- ══════════ 2. مساحة عرض الرسائل ══════════ -->
        <CollectionView Grid.Row="1"
                        x:Name="MessagesList"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        BackgroundColor="Transparent"
                        Margin="0,10">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatBubbleModel">

                    <!-- 🟢 1. الـ Grid الجذري: هو الوحيد المسموح له بالتقاط اللمس -->
                    <Grid BackgroundColor="#01000000">

                        <Grid.Behaviors>
                            <toolkit:TouchBehavior LongPressDuration="500"
                                                   LongPressCommand="{Binding Source={x:Reference ChatPageRoot}, Path=LongPressCommand}"
                                                   LongPressCommandParameter="{Binding .}"
                                                   Command="{Binding Source={x:Reference ChatPageRoot}, Path=TapCommand}"
                                                   CommandParameter="{Binding .}"
                                                   DefaultAnimationDuration="150"
                                                   PressedOpacity="0.6" />
                        </Grid.Behaviors>

                        <!-- 🟢 2. نغلف كل تصميم الرسالة بـ ContentView ونمنعه من سرقة اللمس نهائياً -->
                        <ContentView InputTransparent="True" Padding="12,4">
                            <Grid ColumnDefinitions="Auto, *">

                                <!-- مربع الاختيار الدائري (يظهر في وضع التحديد) -->
                                <Border Grid.Column="0" 
                        IsVisible="{Binding IsSelectionMode}"
                        WidthRequest="24" HeightRequest="24"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="2"
                        Stroke="#38BDF8"
                        BackgroundColor="Transparent"
                        Margin="0,0,10,0" VerticalOptions="Center">

                                    <Label Text="✓" FontSize="14" TextColor="White" IsVisible="{Binding IsSelected}" HorizontalOptions="Center" VerticalOptions="Center"/>

                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#38BDF8" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>

                                <!-- فقاعة الرسالة -->
                                <Border Grid.Column="1"
                        StrokeThickness="0"
                        Padding="14,10"
                        BackgroundColor="{Binding BubbleColor}"
                        HorizontalOptions="{Binding BubbleAlignment}"
                        MaximumWidthRequest="280"
                        StrokeShape="RoundRectangle 16">

                                    <Grid RowDefinitions="Auto, Auto" RowSpacing="4">

                                        <!-- نص الرسالة -->
                                        <Label Grid.Row="0"
                               Text="{Binding Content}"
                               FontSize="15" 
                               LineBreakMode="WordWrap"
                               TextColor="{Binding TextColor}"
                               LineHeight="1.4" />

                                        <!-- الوقت وحالة القراءة -->
                                        <HorizontalStackLayout Grid.Row="1"
                                               HorizontalOptions="End"
                                               Spacing="5"
                                               VerticalOptions="Center">

                                            <Label Text="{Binding TimeString}"
                                   FontSize="10" 
                                   TextColor="{Binding TimeColor}"
                                   VerticalOptions="Center"/>

                                            <!-- علامة صح الاستلام والقراءة -->
                                            <Path Data="{Binding StatusIconGeometry}"
                                  Stroke="{Binding StatusIconColor}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  IsVisible="{Binding IsMine}"
                                  VerticalOptions="Center"
                                  HorizontalOptions="Center"
                                  HeightRequest="14"
                                  WidthRequest="16"
                                  Aspect="Uniform" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ContentView>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ══════════ 3. شريط إدخال النص السفلي ══════════ -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                Padding="14,10,14,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#151E2F" Offset="0.0" />
                    <GradientStop Color="#111827" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="End">

                <Border Grid.Column="0"
                        Padding="16,8"
                        StrokeShape="RoundRectangle 24"
                        Stroke="#2D3748"
                        StrokeThickness="1"
                        BackgroundColor="#1E293B"
                        VerticalOptions="Center"
                        MinimumHeightRequest="48">
                    <Editor x:Name="MessageEntry"
                            Placeholder="اكتب رسالتك هنا..."
                            PlaceholderColor="#64748B"
                            TextColor="#F8FAFC"
                            FontSize="15" FontFamily="CairoBold"
                            BackgroundColor="Transparent"
                            AutoSize="TextChanges"
                            MaximumHeightRequest="120"
                            VerticalOptions="Center" />
                </Border>

                <!-- زر الإرسال -->
                <Border Grid.Column="1"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 24"
                        StrokeThickness="0"
                        VerticalOptions="End">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#38BDF8" Offset="0.0" />
                            <GradientStop Color="#0284C7" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#0284C7" Offset="0,3" Radius="10" Opacity="0.3"/>
                    </Border.Shadow>

                    <ImageButton Source="send.png"
                                 BackgroundColor="Transparent"
                                 Clicked="OnSendClicked"
                                 WidthRequest="22"
                                 HeightRequest="22"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

    </Grid>
</ContentPage>