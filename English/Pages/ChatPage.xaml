<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.ChatPage"
             BackgroundColor="#0B1120"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 🟢 1. ترويسة علوية ناصعة وعصرية (Header) -->
        <Border Grid.Row="0" BackgroundColor="#151E2F" Stroke="#1E293B" StrokeThickness="1" Padding="12,35,12,12">

            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,1" Radius="10" Opacity="0.03"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto, Auto, *, Auto">

                <!-- صورة الصديق ونقطة الاتصال -->
                <Grid Grid.Column="1" 
                      WidthRequest="48" 
                      HeightRequest="48" 
                      Margin="0,0,12,0" 
                      VerticalOptions="Center">

                    <Border WidthRequest="46" 
                            HeightRequest="46" 
                            StrokeShape="RoundRectangle 23" 
                            StrokeThickness="0" 
                            BackgroundColor="#6366F1" 
                            VerticalOptions="Center" 
                            HorizontalOptions="Center">
                        <Label x:Name="FriendInitialLabel" 
                               Text="?" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" 
                               FontAttributes="Bold" 
                               TextColor="#FFFFFF" 
                               FontSize="19"/>
                    </Border>

                    <!-- نقطة الاتصال المدمجة -->
                    <Border x:Name="OnlineStatusIndicator" 
                            WidthRequest="14" 
                            HeightRequest="14" 
                            StrokeShape="RoundRectangle 7" 
                            Padding="0" 
                            BackgroundColor="#EF4444" 
                            Stroke="#FFFFFF" 
                            StrokeThickness="2.5"
                            HorizontalOptions="End" 
                            VerticalOptions="End" />
                </Grid>

                <!-- اسم الصديق وحالته -->
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                    <Label x:Name="FriendNameTitle" 
                           Text="جاري التحميل..." 
                           FontAttributes="Bold" 
                           FontSize="17" 
                           TextColor="#F8FAFC" />
                    <Label x:Name="FriendStatusLabel" 
                           Text="تحقق من الاتصال..." 
                           FontSize="12" 
                           TextColor="#94A3B8" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- 🟢 2. قائمة الرسائل (الدردشة) -->
        <CollectionView x:Name="MessagesList" 
                        Grid.Row="1"
                        BackgroundColor="#0B1120">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,5">

                        <!-- فقاعة الرسالة -->
                        <Border StrokeThickness="0"
                                Padding="12,9"
                                BackgroundColor="{Binding BubbleColor}"
                                HorizontalOptions="{Binding BubbleAlignment}"
                                MaximumWidthRequest="300"
                                StrokeShape="RoundRectangle 16">

                            <Border.Shadow>
                                <Shadow Brush="#000000"
            Offset="0,1"
            Radius="5"
            Opacity="0.04"/>
                            </Border.Shadow>

                            <Grid RowDefinitions="Auto, Auto" RowSpacing="3">

                                <!-- نص الرسالة -->
                                <Label Grid.Row="0" 
                                       Text="{Binding Content}" 
                                       FontSize="15" 
                                       LineBreakMode="WordWrap"
                                       TextColor="{Binding TextColor}" 
                                       Margin="0,0,0,2"/>

                                <!-- الوقت وحالة القراءة -->
                                <HorizontalStackLayout Grid.Row="1" 
                                                       HorizontalOptions="End" 
                                                       Spacing="4" 
                                                       VerticalOptions="Center">

                                    <Label Text="{Binding TimeString}" 
                                           FontSize="10" 
                                           TextColor="{Binding TimeColor}" 
                                           VerticalOptions="Center"/>

                                    <!-- علامة صح الاستلام والقراءة -->
                                    <Label Text="{Binding StatusIconText}" 
                                           TextColor="{Binding StatusIconColor}" 
                                           FontSize="12" 
                                           IsVisible="{Binding IsMine}" 
                                           VerticalOptions="Center"
                                           FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 🟢 3. شريط إدخال النص السفي (Message Composer) -->
        <Border Grid.Row="2"
        BackgroundColor="#151E2F"
        Stroke="#1E293B"
        StrokeThickness="1"
        Padding="12,10,12,15">

            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">

                <Border Grid.Column="0" 
                        Padding="16,0" 
                        StrokeShape="RoundRectangle 24" 
                        Stroke="#334155"
                        StrokeThickness="1"
                        BackgroundColor="#1E293B" 
                        HeightRequest="48" 
                        VerticalOptions="Center">
                    <Entry x:Name="MessageEntry" 
                           Placeholder="اكتب رسالتك هنا..." 
                           PlaceholderColor="#64748B"
                           TextColor="#F8FAFC"
                           FontSize="15"
                           BackgroundColor="Transparent" 
                           ClearButtonVisibility="Never"
                           VerticalOptions="Center" />
                </Border>

                <!-- زر الإرسال -->
                <Border Grid.Column="1" 
                        WidthRequest="48" 
                        HeightRequest="48" 
                        StrokeShape="RoundRectangle 24" 
                        BackgroundColor="#5B6EF5" 
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#5B6EF5" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>

                    <ImageButton Source="send.png" 
                                 BackgroundColor="Transparent" 
                                 Clicked="OnSendClicked" 
                                 WidthRequest="22" 
                                 HeightRequest="22" 
                                 HorizontalOptions="Center" 
                                 VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

    </Grid>
</ContentPage>