<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.NeuralMemoryJourneyPage"
             FlowDirection="RightToLeft"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#070C18">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#070C18" Offset="0.0" />
            <GradientStop Color="#0D1527" Offset="0.5" />
            <GradientStop Color="#121528" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *">

        <!-- ============================================================ -->
        <!-- 🧭 1. شريط التنقل ومسار المحطات (Journey Stepper Header)      -->
        <!-- ============================================================ -->
        <Border Grid.Row="0"
                StrokeThickness="1"
                Stroke="#1E293B"
                StrokeShape="RoundRectangle 0,0,24,24"
                BackgroundColor="#0C1322"
                Padding="16,14,16,14">
            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                <!-- زر الإغلاق / الخروج -->
                <Border Grid.Column="0"
                        WidthRequest="38"
                        HeightRequest="38"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#334155"
                        StrokeThickness="1"
                        BackgroundColor="#162032"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExitTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="✕" TextColor="#94A3B8" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- مسار المحطات الأربع (المؤشر البصري) -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <!-- عنوان وشارة الدفعة -->
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label x:Name="JourneyTitleLabel"
                               Text="رحلة الحفظ العصبي 🧠"
                               TextColor="#38BDF8"
                               FontSize="14"
                               FontFamily="CairoBold"
                               HorizontalOptions="Center"/>
                        <Border x:Name="BatchBadge"
                                BackgroundColor="#1E1B4B"
                                Stroke="#6366F1"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="6,1"
                                IsVisible="False">
                            <Label x:Name="BatchBadgeLabel" Text="الدفعة 1" TextColor="#A5B4FC" FontSize="10.5" FontFamily="CairoBold"/>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- نقاط المسار الـ 6 -->
                    <HorizontalStackLayout x:Name="StepperContainer" Spacing="4" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False">
                        <!-- المحطة 1: 🎧 البصمة -->
                        <Border x:Name="Step1Border" WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="#1E293B" StrokeThickness="1">
                            <Label Text="🎧" FontSize="10.5" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <BoxView WidthRequest="6" HeightRequest="2" Color="#334155" VerticalOptions="Center"/>

                        <!-- المحطة 2: ⚡ السرعة -->
                        <Border x:Name="Step2Border" WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="#1E293B" StrokeThickness="1">
                            <Label Text="⚡" FontSize="10.5" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <BoxView WidthRequest="6" HeightRequest="2" Color="#334155" VerticalOptions="Center"/>

                        <!-- المحطة 3: 🧩 الحروف -->
                        <Border x:Name="Step3Border" WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="#1E293B" StrokeThickness="1">
                            <Label Text="🧩" FontSize="10.5" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <BoxView WidthRequest="6" HeightRequest="2" Color="#334155" VerticalOptions="Center"/>

                        <!-- المحطة 4: 💣 الألغام -->
                        <Border x:Name="Step4Border" WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="#1E293B" StrokeThickness="1">
                            <Label Text="💣" FontSize="10.5" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <BoxView WidthRequest="6" HeightRequest="2" Color="#334155" VerticalOptions="Center"/>

                        <!-- المحطة 5: 🪞 الانعكاس -->
                        <Border x:Name="Step5Border" WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="#1E293B" StrokeThickness="1">
                            <Label Text="🪞" FontSize="10.5" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <BoxView WidthRequest="6" HeightRequest="2" Color="#334155" VerticalOptions="Center"/>

                        <!-- المحطة 6: 🔐 الخزنة -->
                        <Border x:Name="Step6Border" WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12" BackgroundColor="#1E293B" StrokeThickness="1">
                            <Label Text="🔐" FontSize="10.5" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- مساحة موازنة لزر الإغلاق لضمان توسط شريط التقدم -->
                <BoxView Grid.Column="2" WidthRequest="38" HeightRequest="38" Color="Transparent"/>

            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 📱 2. الحاوية الرئيسية للحالات المتدفقة (State Machine Area)    -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" Padding="16,12,16,16">

            <!-- ======================================================== -->
            <!-- 🟢 الحالة 1: المحطة 1 (البصمة الصوتية والمطابقة الهادئة) 🎧 -->
            <!-- ======================================================== -->
            <Grid x:Name="Station1View" RowDefinitions="Auto, *" IsVisible="True">

                <!-- ترويسة المحطة -->
                <Border Grid.Row="0" BackgroundColor="#0C2036" Stroke="#38BDF8" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14,10" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Text="🎧" FontSize="24" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label x:Name="Station1HeaderTitle" Text="المحطة 1: البصمة الصوتية والتشفير" FontSize="14" FontFamily="CairoBold" TextColor="#38BDF8"/>
                            <Label x:Name="Station1HeaderSub" Text="ركز مع الكلمة لدقيقتين لتثبيتها في الذاكرة، أو اضغط حفظتها مبكراً." FontSize="11.5" FontFamily="CairoRegular" TextColor="#94A3B8"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- المحتوى: 1A. بطاقة التشفير الفردية (Flash Encoding) مع مؤقت بومودورو دقيقتين -->
                <Grid x:Name="Station1_FlashcardContainer" Grid.Row="1" VerticalOptions="Center" IsVisible="True">
                    <Border StrokeThickness="1.5"
                            Stroke="#38BDF8"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="#0B1322"
                            Padding="24,20"
                            HorizontalOptions="Center"
                            WidthRequest="320">
                        <Border.Shadow>
                            <Shadow Brush="#0284C7" Opacity="0.3" Radius="18" Offset="0,4"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="14" HorizontalOptions="Center" WidthRequest="272">
                            <!-- الصف العلوي: مؤشر الكلمة + مؤقت البومودورو لدقيقتين -->
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <!-- مؤشر تقدم الكلمات في الدفعة -->
                                <Label x:Name="FlashcardIndexLabel" 
                                       Grid.Column="0"
                                       Text="الكلمة 1 من 6" 
                                       FontSize="12" 
                                       TextColor="#94A3B8" 
                                       FontFamily="CairoBold" 
                                       VerticalOptions="Center"/>

                                <!-- شارة مؤقت البومودورو لدقيقتين -->
                                <Border Grid.Column="1"
                                        BackgroundColor="#0F1F38"
                                        Stroke="#38BDF8"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 13"
                                        Padding="8,3"
                                        VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label Text="⏳" FontSize="11" VerticalOptions="Center"/>
                                        <Label x:Name="FlashcardPomodoroTimerLabel"
                                               Text="02:00"
                                               FontSize="12.5"
                                               FontFamily="CairoBold"
                                               TextColor="#38BDF8"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- شريط تقدم المؤقت الخاطف للكلمة -->
                            <ProgressBar x:Name="FlashcardPomodoroProgressBar"
                                         Progress="1.0"
                                         ProgressColor="#38BDF8"
                                         HeightRequest="4"
                                         Margin="0,-4,0,2"/>

                            <!-- الكلمة الإنجليزية الكبيرة -->
                            <Label x:Name="FlashcardEnglishLabel" Text="Hospital" FontSize="32" FontFamily="CairoBold" TextColor="#38BDF8" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                            <!-- تقطيع الكلمة لمقاطع صوتية -->
                            <Border BackgroundColor="#111A2E" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,5" HorizontalOptions="Center">
                                <Label x:Name="FlashcardSyllablesLabel" Text="Hos · pi · tal" FontSize="13.5" FontFamily="CairoRegular" TextColor="#CBD5E1"/>
                            </Border>

                            <!-- المعنى العربي البارز -->
                            <Label x:Name="FlashcardArabicLabel" Text="مستشفى" FontSize="24" FontFamily="CairoBold" TextColor="#FBBF24" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                            <!-- زر الاستماع الصوتي -->
                            <Border Stroke="#0284C7" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="#0C243C" Padding="14,8" HorizontalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnReplayFlashcardAudioTapped"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="🔊" FontSize="16" VerticalOptions="Center"/>
                                    <Label Text="استمع للنطق" TextColor="White" FontSize="13" FontFamily="CairoBold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                            <!-- زر الحفظ المبكر والتخطي (ثابت وبدون أي حركة عند النقر) -->
                            <Border HeightRequest="48"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 24"
                                    BackgroundColor="#0284C7"
                                    Margin="0,4,0,0"
                                    HorizontalOptions="Fill">
                                <Border.Shadow>
                                    <Shadow Brush="#0284C7" Opacity="0.35" Radius="8" Offset="0,3"/>
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNextFlashcardClicked"/>
                                </Border.GestureRecognizers>
                                <Label Text="حفظتها مبكراً ⚡"
                                       TextColor="White"
                                       FontFamily="CairoBold"
                                       FontSize="14.5"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Label Text="ينتقل تلقائياً للكلمة التالية بعد دقيقتين ⏱️"
                                   FontSize="10.5"
                                   FontFamily="Cairo"
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- المحتوى: 1B. شبكة المطابقة الهادئة (Gentle Auditory Matching) -->
                <Grid x:Name="Station1_MatchingContainer" Grid.Row="1" RowDefinitions="*, Auto" IsVisible="False">
                    <ScrollView Grid.Row="0" VerticalOptions="Center">
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="14" Margin="0,10,0,10">
                            <!-- عمود الكلمات الإنجليزية (تُنطق عند اللمس) -->
                            <VerticalStackLayout x:Name="MatchEnglishCol" Grid.Column="0" Spacing="12"/>
                            <!-- عمود المعاني العربية -->
                            <VerticalStackLayout x:Name="MatchArabicCol" Grid.Column="1" Spacing="12"/>
                        </Grid>
                    </ScrollView>

                    <Label Grid.Row="1"
                           Text="المس الكلمة الإنجليزية لسماعها، ثم اختر معناها المطابق 🔗"
                           FontSize="12"
                           FontFamily="CairoRegular"
                           TextColor="#94A3B8"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,8,0,0"/>
                </Grid>

            </Grid>


            <!-- ======================================================== -->
            <!-- 🟢 الحالة 2: المحطة 2 (رادار السرعة والبديهة) ⚡           -->
            <!-- ======================================================== -->
            <Grid x:Name="Station2View" RowDefinitions="Auto, Auto, *, Auto" IsVisible="False">

                <!-- ترويسة الرادار -->
                <Border Grid.Row="0" BackgroundColor="#1E1B4B" Stroke="#818CF8" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14,10" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Text="⚡" FontSize="24" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="المحطة 2: رادار السرعة والبديهة" FontSize="14" FontFamily="CairoBold" TextColor="#A5B4FC"/>
                            <Label Text="اختر الإجابة بلمحة بصر فور ظهور الكلمة لتثبيت صورتها الذهنية." FontSize="11" FontFamily="CairoRegular" TextColor="#94A3B8"/>
                        </VerticalStackLayout>
                        <Label x:Name="ReflexScoreLabel" Grid.Column="2" Text="⭐ 0" FontSize="14" FontFamily="CairoBold" TextColor="#FBBF24" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- شريط مؤقت السؤال الخاطف (3 ثوانٍ) -->
                <ProgressBar x:Name="ReflexProgressBar" Grid.Row="1" Progress="1.0" ProgressColor="#F59E0B" HeightRequest="6" Margin="0,0,0,16"/>

                <!-- مربع السؤال المضيء -->
                <VerticalStackLayout Grid.Row="2" Spacing="14" VerticalOptions="Center">
                    <Border Stroke="#6366F1"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="#0B1322"
                            Padding="20,16"
                            HorizontalOptions="Center"
                            WidthRequest="300">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label x:Name="ReflexPromptSubLabel" Text="ما هو المعنى الإنجليزي لـ:" FontSize="12" FontFamily="CairoRegular" TextColor="#94A3B8" HorizontalOptions="Center"/>
                            <Label x:Name="ReflexTargetWordLabel" Text="مستشفى" FontSize="26" FontFamily="CairoBold" TextColor="#FBBF24" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- خيارات الإجابة الـ 3 السريعة -->
                    <VerticalStackLayout x:Name="ReflexOptionsContainer" Spacing="10" HorizontalOptions="Center" WidthRequest="300"/>
                </VerticalStackLayout>

                <!-- تقدم الأسئلة في الرادار -->
                <Label x:Name="ReflexRoundProgressLabel"
                       Grid.Row="3"
                       Text="السؤال 1 من 6"
                       FontSize="11.5"
                       FontFamily="CairoRegular"
                       TextColor="#94A3B8"
                       HorizontalOptions="Center"/>
            </Grid>


            <!-- ======================================================== -->
            <!-- 🟢 الحالة 3: المحطة 3 (التركيب الحركي وقناص الحروف) 🧩    -->
            <!-- ======================================================== -->
            <Grid x:Name="Station3View" RowDefinitions="Auto, *, Auto" IsVisible="False">

                <!-- ترويسة الحروف -->
                <Border Grid.Row="0" BackgroundColor="#1E1430" Stroke="#A855F7" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14,10" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Text="🧩" FontSize="24" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="المحطة 3: التركيب الحركي والتهجئة" FontSize="14" FontFamily="CairoBold" TextColor="#C084FC"/>
                            <Label Text="انقش ترتيب الحروف في ذاكرتك بلمس الحروف بالتسلسل الصحيح." FontSize="11" FontFamily="CairoRegular" TextColor="#94A3B8"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ساحة بناء الكلمة وحروفها -->
                <VerticalStackLayout Grid.Row="1" Spacing="20" VerticalOptions="Center">

                    <!-- المعنى العربي والصوت المساعد -->
                    <Border Stroke="#A855F7" StrokeThickness="1" StrokeShape="RoundRectangle 18" BackgroundColor="#0F1424" Padding="16,10" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="🎯" FontSize="20" VerticalOptions="Center"/>
                            <Label x:Name="SpellingArabicWordLabel" Text="إفطار" FontSize="22" FontFamily="CairoBold" TextColor="#FBBF24" VerticalOptions="Center"/>
                            <Border Stroke="#38BDF8" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#11223A" WidthRequest="34" HeightRequest="34" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSpellingAudioHintTapped"/>
                                </Border.GestureRecognizers>
                                <Label Text="🔊" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- خانات الكلمة المركبة (Slots مرتبة من اليسار لليمين) -->
                    <HorizontalStackLayout x:Name="SpellingSlotsContainer"
                                           FlowDirection="LeftToRight"
                                           Spacing="8"
                                           HorizontalOptions="Center"/>

                    <!-- بنك الحروف المبعثرة (صفوف منتظمة ومستجيبة للمس 100% في جميع الصفوف) -->
                    <VerticalStackLayout x:Name="SpellingBubblesContainer"
                                         FlowDirection="LeftToRight"
                                         Spacing="10"
                                         HorizontalOptions="Center"
                                         Margin="10,0"/>

                </VerticalStackLayout>

                <!-- مؤشر الكلمة الحالية -->
                <Label x:Name="SpellingProgressLabel"
                       Grid.Row="2"
                       Text="الكلمة 1 من 4"
                       FontSize="11.5"
                       FontFamily="CairoRegular"
                       TextColor="#94A3B8"
                       HorizontalOptions="Center"/>
            </Grid>


            <!-- ======================================================== -->
            <!-- 🟢 الحالة 4: المحطة 4 (كاسحة ألغام الحروف) 💣             -->
            <!-- ======================================================== -->
            <Grid x:Name="Station4View" RowDefinitions="Auto, *, Auto" IsVisible="False">

                <!-- ترويسة كاسحة الألغام -->
                <Border Grid.Row="0" BackgroundColor="#2A0B10" Stroke="#F43F5E" StrokeThickness="1.2" StrokeShape="RoundRectangle 16" Padding="14,10" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Text="💣" FontSize="24" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="المحطة 4: كاسحة ألغام الحروف" FontSize="14" FontFamily="CairoBold" TextColor="#FB7185"/>
                            <Label Text="تم تلغيم الكلمة بحروف دخيلة! المس الحروف الدخيلة لتفجيرها وتطهير الكلمة." FontSize="11" FontFamily="CairoRegular" TextColor="#94A3B8"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="#4C0519" Stroke="#F43F5E" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="8,4" VerticalOptions="Center">
                            <Label x:Name="MineRemainingLabel" Text="💣 2" FontSize="12.5" FontFamily="CairoBold" TextColor="#FECDD3"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ساحة تفجير الألغام وتطهير الكلمة -->
                <VerticalStackLayout Grid.Row="1" Spacing="22" VerticalOptions="Center">

                    <!-- المعنى العربي للكلمة المستهدفة مع الصوت المساعد -->
                    <Border Stroke="#F43F5E" StrokeThickness="1" StrokeShape="RoundRectangle 18" BackgroundColor="#140B1A" Padding="16,10" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="🎯" FontSize="20" VerticalOptions="Center"/>
                            <Label x:Name="MineArabicWordLabel" Text="مستشفى" FontSize="22" FontFamily="CairoBold" TextColor="#FBBF24" VerticalOptions="Center"/>
                            <Border Stroke="#38BDF8" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#11223A" WidthRequest="34" HeightRequest="34" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMineAudioHintTapped"/>
                                </Border.GestureRecognizers>
                                <Label Text="🔊" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- شريط الحروف الملغمة (توزع أفقياً مع FlowDirection LTR) -->
                    <VerticalStackLayout x:Name="MineTilesContainer"
                                         Spacing="10"
                                         HorizontalOptions="Center"
                                         Margin="6,0"/>

                    <!-- رسالة توجيهية خفيفة -->
                    <Label x:Name="MineFeedbackLabel"
                           Text="المس الحرف المشبوه لتفجيره 💥"
                           FontSize="12"
                           FontFamily="CairoRegular"
                           TextColor="#94A3B8"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

                <!-- تقدم كلمات كاسحة الألغام -->
                <Label x:Name="MineProgressLabel"
                       Grid.Row="2"
                       Text="الكلمة 1 من 4"
                       FontSize="11.5"
                       FontFamily="CairoRegular"
                       TextColor="#94A3B8"
                       HorizontalOptions="Center"/>
            </Grid>


            <!-- ======================================================== -->
            <!-- 🟢 الحالة 5: المحطة 5 (بوابة الإتقان والانعكاس المزدوج) 🪞   -->
            <!-- ======================================================== -->
            <Grid x:Name="Station5View" RowDefinitions="Auto, *, Auto" IsVisible="False">

                <!-- ترويسة البوابة -->
                <Border Grid.Row="0" BackgroundColor="#2A1705" Stroke="#F59E0B" StrokeThickness="1.2" StrokeShape="RoundRectangle 16" Padding="14,10" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Text="🪞" FontSize="24" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label x:Name="GatekeeperTitleLabel" Text="المحطة 5: بوابة الإتقان (الانعكاس المزدوج) 🪞" FontSize="14" FontFamily="CairoBold" TextColor="#FBBF24"/>
                            <Label x:Name="GatekeeperSubLabel" Text="اختبار حاسم ثنائي الاتجاه للتأكد من رسوخ جميع الكلمات في ذاكرتك 100%." FontSize="11" FontFamily="CairoRegular" TextColor="#94A3B8"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- بطاقة سؤال بوابة الإتقان -->
                <VerticalStackLayout Grid.Row="1" Spacing="16" VerticalOptions="Center">

                    <!-- بطاقة السؤال -->
                    <Border Stroke="#F59E0B"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="#0B1322"
                            Padding="22,18"
                            HorizontalOptions="Center"
                            WidthRequest="310">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label x:Name="GateQuestionPromptLabel" Text="ما هو المعنى الصحيح لـ:" FontSize="12.5" FontFamily="CairoRegular" TextColor="#94A3B8" HorizontalOptions="Center"/>
                            <Label x:Name="GateQuestionWordLabel" Text="Breakfast" FontSize="26" FontFamily="CairoBold" TextColor="#38BDF8" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                            <!-- زر صوتي إذا كان السؤال سمعياً -->
                            <Border x:Name="GateAudioButton" Stroke="#38BDF8" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#11223A" Padding="10,4" HorizontalOptions="Center" IsVisible="False">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGateAudioPromptTapped"/>
                                </Border.GestureRecognizers>
                                <Label Text="🔊 استمع للسؤال" TextColor="#38BDF8" FontSize="12" FontFamily="CairoBold"/>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- خيارات الإجابة الـ 4 -->
                    <VerticalStackLayout x:Name="GateOptionsContainer" Spacing="9" HorizontalOptions="Center" WidthRequest="310"/>
                </VerticalStackLayout>

                <!-- تقدم أسئلة البوابة -->
                <Label x:Name="GateProgressLabel"
                       Grid.Row="2"
                       Text="السؤال 1 من 6"
                       FontSize="11.5"
                       FontFamily="CairoRegular"
                       TextColor="#94A3B8"
                       HorizontalOptions="Center"/>
            </Grid>


            <!-- ======================================================== -->
            <!-- 🟢 الحالة 6: المحطة 6 (خزنة التسميع الغيبي الحر) 🔐        -->
            <!-- ======================================================== -->
            <Grid x:Name="Station6View" RowDefinitions="Auto, *, Auto" IsVisible="False">

                <!-- ترويسة الخزنة -->
                <Border Grid.Row="0" BackgroundColor="#1E1704" Stroke="#F59E0B" StrokeThickness="1.2" StrokeShape="RoundRectangle 16" Padding="14,10" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Text="🔐" FontSize="24" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="المحطة 6: التسميع الغيبي الحر" FontSize="14" FontFamily="CairoBold" TextColor="#FBBF24"/>
                            <Label Text="استرجع الكلمات من ذاكرتك بأي ترتيب، انطقها 🎙️ أو اكتبها ⌨️" FontSize="11" FontFamily="CairoRegular" TextColor="#94A3B8"/>
                        </VerticalStackLayout>
                        <!-- زر التلميح الذكي -->
                        <Border Grid.Column="2" BackgroundColor="#2D1F00" Stroke="#FBBF24" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="8,5" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnVaultHintTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="💡" FontSize="13" VerticalOptions="Center"/>
                                <Label Text="تلميح" TextColor="#FDE68A" FontSize="11.5" FontFamily="CairoBold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- منطقة بطاقات الخزائن المقفلة والمفتوحة (Scrollable) -->
                <Grid Grid.Row="1" RowDefinitions="Auto, *">
                    <!-- عداد الكلمات المسترجعة -->
                    <Border Grid.Row="0" BackgroundColor="#0F172A" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,5" Margin="0,0,0,6" HorizontalOptions="Center">
                        <Label x:Name="VaultProgressLabel" Text="🎯 تم استرجاع 0 من 6 كلمات" FontSize="12.5" FontFamily="CairoBold" TextColor="#38BDF8"/>
                    </Border>

                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout x:Name="VaultSlotsContainer" Spacing="8" Padding="2,2,2,8"/>
                    </ScrollView>
                </Grid>

                <!-- منطقة الإدخال المزدوج (صوت + كتابة) في الأسفل -->
                <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="0,6,0,0">

                    <!-- شريط التغذية الراجعة / حالة الاستماع -->
                    <Label x:Name="VaultStatusLabel"
                           Text="تذكر إحدى الكلمات وانطقها بالميكروفون أو اكتبها أدناه 🚀"
                           FontSize="11.5"
                           FontFamily="CairoRegular"
                           TextColor="#94A3B8"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                    <!-- زر الميكروفون للنطق الصوتي -->
                    <Border x:Name="VaultMicBorder"
                            BackgroundColor="#0C2036"
                            Stroke="#38BDF8"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,9"
                            HorizontalOptions="Fill">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVaultMicTapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Label x:Name="VaultMicIcon" Text="🎙️" FontSize="19" VerticalOptions="Center"/>
                            <Label x:Name="VaultMicText" Grid.Column="1" Text="اضغط للتحدث بالإنجليزية 🎙️" TextColor="White" FontSize="13.5" FontFamily="CairoBold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border x:Name="VaultMicPulse" Grid.Column="2" WidthRequest="10" HeightRequest="10" StrokeShape="RoundRectangle 5" BackgroundColor="#10B981" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- حقل الكتابة الموحد وزر التحقق (Unified Input Capsule) -->
                    <Border BackgroundColor="#0F172A"
                            Stroke="#334155"
                            StrokeThickness="1.2"
                            StrokeShape="RoundRectangle 22"
                            Padding="6,2,14,2"
                            HeightRequest="48">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Entry x:Name="VaultWordEntry"
                                   Grid.Column="0"
                                   Placeholder="اكتب الكلمة بالإنجليزية هنا..."
                                   PlaceholderColor="#64748B"
                                   TextColor="White"
                                   BackgroundColor="Transparent"
                                   FontSize="14"
                                   FontFamily="CairoRegular"
                                   VerticalOptions="Center"
                                   FlowDirection="LeftToRight"
                                   HorizontalTextAlignment="Start"
                                   ClearButtonVisibility="WhileEditing"
                                   Completed="OnVaultEntryCompleted"/>

                            <Border Grid.Column="1"
                                    BackgroundColor="#0284C7"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    Padding="14,6"
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnVaultSubmitClicked"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Label Text="تحقق" TextColor="White" FontSize="12.5" FontFamily="CairoBold" VerticalOptions="Center"/>
                                    <Label Text="🚀" FontSize="11" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>


            <!-- ======================================================== -->
            <!-- 🟢 الحالة 5: شاشة التتويج والاحتفال بالإتقان الكامل 👑    -->
            <!-- ======================================================== -->
            <Grid x:Name="VictoryView" VerticalOptions="Center" IsVisible="False">
                <Border StrokeThickness="1.5"
                        Stroke="#10B981"
                        StrokeShape="RoundRectangle 26"
                        BackgroundColor="#0B1522"
                        Padding="26,22"
                        HorizontalOptions="Center"
                        WidthRequest="330">
                    <Border.Shadow>
                        <Shadow Brush="#10B981" Opacity="0.35" Radius="22" Offset="0,4"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                        <Label Text="👑" FontSize="56" HorizontalOptions="Center"/>

                        <Label Text="إتقان أسطوري! 🧠"
                               FontSize="20"
                               FontFamily="CairoBold"
                               TextColor="#10B981"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="أتممت رحلة الحفظ بنجاح تام! الكلمات الآن راسخة في عقلك وجاهزة لاجتياز أي لعبة أو تحدٍ مع أصدقائك."
                               FontSize="12.5"
                               FontFamily="CairoRegular"
                               TextColor="#CBD5E1"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>

                        <!-- كبسولات الكلمات المحفوظة -->
                        <Border BackgroundColor="#0F1F2C" Stroke="#1E3A4C" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14,10">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="الكلمات المتقنة:" FontSize="11.5" FontFamily="CairoRegular" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                <Label x:Name="VictoryWordsListLabel" Text="Hospital • Breakfast • Family" FontSize="13" FontFamily="CairoBold" TextColor="#38BDF8" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- زر إنهاء الرحلة والعودة -->
                        <Button Text="العودة لشاشة الكلمات ➔"
                                HeightRequest="48"
                                CornerRadius="24"
                                BackgroundColor="#059669"
                                TextColor="White"
                                FontFamily="CairoBold"
                                FontSize="14.5"
                                Clicked="OnFinishJourneyClicked"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </Grid>

        <!-- ======================================================== -->
        <!-- 💡 شاشة التلميح المنبثقة التفاعلية (Custom Hint Modal)     -->
        <!-- ======================================================== -->
        <Grid x:Name="VaultHintOverlay"
              Grid.RowSpan="2"
              BackgroundColor="#CC050914"
              IsVisible="False"
              Opacity="0">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseHintPopupTapped"/>
            </Grid.GestureRecognizers>

            <Border VerticalOptions="Center"
                    HorizontalOptions="Center"
                    WidthRequest="315"
                    Stroke="#F59E0B"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="#0D1526"
                    Padding="22,20">
                <Border.Shadow>
                    <Shadow Brush="#F59E0B" Opacity="0.35" Radius="22" Offset="0,4"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer/>
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <!-- الأيقونة المضيئة -->
                    <Border WidthRequest="52"
                            HeightRequest="52"
                            StrokeShape="RoundRectangle 26"
                            BackgroundColor="#241704"
                            Stroke="#F59E0B"
                            StrokeThickness="1.5"
                            HorizontalOptions="Center">
                        <Label Text="💡" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- عنوان النافذة -->
                    <Label x:Name="HintPopupTitleLabel"
                           Text="تلميح ذكي للذاكرة"
                           FontSize="16"
                           FontFamily="CairoBold"
                           TextColor="#FDE68A"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                    <!-- بطاقة المعنى العربي -->
                    <Border BackgroundColor="#111C30"
                            Stroke="#1E293B"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,10"
                            HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="المعنى بالعربية:" FontSize="11.5" FontFamily="CairoRegular" TextColor="#94A3B8" HorizontalOptions="Center"/>
                            <Label x:Name="HintPopupArabicLabel" Text="مستشفى" FontSize="21" FontFamily="CairoBold" TextColor="#FBBF24" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- شريحة الحرف الأول الإنجليزي -->
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="تبدأ بحرف:" FontSize="13" FontFamily="CairoRegular" TextColor="#94A3B8" VerticalOptions="Center"/>
                        <Border BackgroundColor="#1E1B4B" Stroke="#818CF8" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,3" VerticalOptions="Center">
                            <Label x:Name="HintPopupFirstLetterLabel" Text="H" FontSize="17" FontFamily="CairoBold" TextColor="#38BDF8"/>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- زر الإغلاق / المتابعة -->
                    <Button Text="سأتذكرها الآن! 🎯"
                            HeightRequest="44"
                            CornerRadius="22"
                            BackgroundColor="#D97706"
                            TextColor="White"
                            FontFamily="CairoBold"
                            FontSize="13.5"
                            Clicked="OnCloseHintPopupTapped"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>

