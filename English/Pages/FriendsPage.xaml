<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:English.Pages"
             x:Class="English.Pages.FriendsPage"
             Title="الأصدقاء"
             FlowDirection="RightToLeft"
             BackgroundColor="#111827"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="20,16,20,10" RowSpacing="12">

        <!-- زر الانتقال لصفحة طلبات الصداقة الواردة -->
        <Border x:Name="BtnPendingRequests"
                Grid.Row="0"
                BackgroundColor="#2563EB"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0"
                Padding="14,10"
                IsVisible="False">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOpenRequestsPageClicked" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*, Auto">
                <Label x:Name="LblPendingCount"
                       Text="طلبات الصداقة الواردة 📩"
                       TextColor="White"
                       FontSize="14"
                       FontFamily="CairoBold"
                       VerticalOptions="Center"/>
                <Label Grid.Column="1"
                       Text="عرض الكل ›"
                       TextColor="#BFDBFE"
                       FontSize="13"
                       FontFamily="CairoRegular"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- أزرار التبويبات (المتصلون والأصدقاء) -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="10">
            <Button Grid.Column="0"
                    x:Name="TabOnline" 
                    Text="المتصلون" 
                    Clicked="OnTabClicked" 
                    CommandParameter="Online" 
                    BackgroundColor="#6366F1" 
                    TextColor="White" 
                    CornerRadius="8" 
                    FontSize="14" 
                    FontFamily="CairoBold"/>

            <Button Grid.Column="1"
                    x:Name="TabFriends" 
                    Text="الأصدقاء" 
                    Clicked="OnTabClicked" 
                    CommandParameter="Friends" 
                    BackgroundColor="#1E293B" 
                    TextColor="White" 
                    CornerRadius="8" 
                    FontSize="14" 
                    FontFamily="CairoBold"/>
        </Grid>

        <!-- شريط البحث -->
        <SearchBar Grid.Row="2"
                   x:Name="SearchBox"
                   Placeholder="ابحث عن اسم المستخدم..."
                   TextChanged="OnSearchTextChanged"
                   BackgroundColor="#1E293B"
                   TextColor="White"
                   PlaceholderColor="#94A3B8"/>

        <!-- محتوى القوائم داخل RefreshView متجاوب يملأ الشاشة بسلاسة -->
        <RefreshView Grid.Row="3"
                     x:Name="PageRefreshView"
                     Refreshing="OnPageRefreshing"
                     RefreshColor="#6366F1">
            <Grid>
                <!-- 1. قائمة المتصلين -->
                <CollectionView x:Name="OnlineUsersList" 
                                SelectionMode="None" 
                                IsVisible="True">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center" Padding="20,40">
                            <Label Text="😴" FontSize="40" HorizontalOptions="Center"/>
                            <Label Text="لا يوجد مستخدمون متصلون حالياً" 
                                   TextColor="#94A3B8" 
                                   FontSize="15" 
                                   FontFamily="CairoBold" 
                                   HorizontalOptions="Center"/>
                            <Label Text="اسحب لأسفل لتحديث القائمة" 
                                   TextColor="#64748B" 
                                   FontSize="12" 
                                   FontFamily="CairoRegular" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:OnlineUserItem">
                            <Border Padding="14,10" Margin="0,4" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 12">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Label Text="🟢" FontSize="12" VerticalOptions="Center" Margin="0,0,10,0"/>
                                    <Label Grid.Column="1" 
                                           Text="{Binding Name}" 
                                           TextColor="White" 
                                           FontSize="15" 
                                           VerticalOptions="Center" 
                                           FontFamily="CairoBold"/>

                                    <Button Grid.Column="2"
                                            Text="{Binding ButtonText}"
                                            IsEnabled="{Binding IsButtonEnabled}"
                                            BackgroundColor="{Binding ButtonBgColor}"
                                            TextColor="White"
                                            FontSize="12"
                                            FontFamily="CairoBold"
                                            Padding="12,0"
                                            CornerRadius="8"
                                            HeightRequest="36"
                                            Clicked="OnAddFriendClicked"
                                            CommandParameter="{Binding Name}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- 2. قائمة الأصدقاء (بدون زر التحدي وبمظهر نظيف متكامل) -->
                <CollectionView x:Name="FriendsList" 
                                SelectionMode="None" 
                                IsVisible="False">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center" Padding="20,40">
                            <Label Text="👥" FontSize="40" HorizontalOptions="Center"/>
                            <Label Text="لم تقم بإضافة أي أصدقاء بعد" 
                                   TextColor="#94A3B8" 
                                   FontSize="15" 
                                   FontFamily="CairoBold" 
                                   HorizontalOptions="Center"/>
                            <Label Text="تصفح قائمة المتصلين لإرسال طلبات صداقة" 
                                   TextColor="#64748B" 
                                   FontSize="12" 
                                   FontFamily="CairoRegular" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:FriendItem">
                            <Border Padding="14,12" Margin="0,4" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 12">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Label Text="{Binding StatusIcon}" FontSize="12" VerticalOptions="Center" Margin="0,0,10,0"/>
                                    <Label Grid.Column="1" 
                                           Text="{Binding Name}" 
                                           TextColor="White" 
                                           FontSize="15" 
                                           VerticalOptions="Center" 
                                           FontFamily="CairoBold"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>

    </Grid>
</ContentPage>