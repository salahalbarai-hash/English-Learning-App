<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="English.Pages.SpellReactorPage"
             BackgroundColor="#060913"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft">

    <Grid>

        <!-- 1. لوحة SkiaSharp للكرات المتساقطة وشحنات طاقة المفاعل -->
        <skia:SKCanvasView x:Name="ReactorCanvas"
                           HorizontalOptions="FillAndExpand"
                           VerticalOptions="FillAndExpand"
                           PaintSurface="OnReactorPaintSurface"
                           EnableTouchEvents="True"
                           Touch="OnReactorTouch"/>

        <!-- 2. الطبقة العلوية XAML للنصوص العربية وخانات الحروف ولوحة التحكم -->
        <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="16,14,16,16" InputTransparent="True">

            <!-- شريط التحكم العلوي -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center" Margin="0,0,0,8" InputTransparent="False">
                <Border Grid.Column="0"
                        BackgroundColor="#1E293B"
                        Stroke="#334155"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExitClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="✕" TextColor="#94A3B8" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- طاقة المفاعل (القلوب) والكومبو (Amber Gold) -->
                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="12" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label x:Name="Heart1Label" Text="⚡" TextColor="#F59E0B" FontSize="20"/>
                        <Label x:Name="Heart2Label" Text="⚡" TextColor="#F59E0B" FontSize="20"/>
                        <Label x:Name="Heart3Label" Text="⚡" TextColor="#F59E0B" FontSize="20"/>
                    </HorizontalStackLayout>

                    <Border BackgroundColor="#24180A" Stroke="#F59E0B" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="8,3">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="🔥" FontSize="13" VerticalOptions="Center"/>
                            <Label x:Name="ComboLabel" Text="x1" TextColor="#FDE68A" FontSize="13" FontFamily="CairoBold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>

                <!-- نقاط الجولة (بدون كوينز) -->
                <Border Grid.Column="2" BackgroundColor="#1C212E" Stroke="#66F59E0B" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="10,5">
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="⭐" FontSize="14" VerticalOptions="Center"/>
                        <Label x:Name="SessionScoreLabel" Text="0" FontSize="14" FontFamily="CairoBold" TextColor="#FBBF24" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- كرت الكلمة المستهدفة باللغة العربية (Amber Flame Theme) -->
            <Border Grid.Row="1"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 18"
                    Padding="16,12"
                    Margin="0,0,0,6"
                    BackgroundColor="#1F1608"
                    InputTransparent="True">
                <Border.Stroke>
                    <LinearGradientBrush EndPoint="1,0">
                        <GradientStop Color="#D97706" Offset="0"/>
                        <GradientStop Color="#F59E0B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Stroke>
                <Border.Shadow>
                    <Shadow Brush="#F59E0B" Opacity="0.25" Radius="10" Offset="0,2"/>
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" ColumnSpacing="10">
                    <Label Text="🧪" FontSize="22" VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="المعنى المطلوب لتهدئة المفاعل:"
                               FontSize="11"
                               TextColor="#94A3B8"
                               FontFamily="CairoRegular"/>
                        <Label x:Name="TargetArabicWordLabel"
                               Text="مستشفى"
                               FontSize="22"
                               TextColor="#F59E0B"
                               FontFamily="CairoBold"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- 4. خانات الحروف المستهدفة (Letter Slots) بالأسفل -->
            <Border Grid.Row="3"
                    BackgroundColor="#0B1322"
                    Stroke="#1E293B"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    Padding="14,12"
                    InputTransparent="False"
                    Margin="0,0,0,6">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Text="اجمع الحروف بالترتيب الصحيح 🔤"
                               TextColor="#94A3B8"
                               FontSize="11"
                               FontFamily="CairoRegular"/>
                        <Label x:Name="WordProgressLabel"
                               Text="1 / 10"
                               TextColor="#FBBF24"
                               FontSize="12"
                               FontFamily="CairoBold"/>
                    </Grid>

                    <!-- صف مربعات الحروف المتجمعة -->
                    <FlexLayout x:Name="LetterSlotsLayout"
                                Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Center"
                                AlignItems="Center"
                                FlowDirection="LeftToRight">
                        <!-- تضاف خانات الحروف برمجياً -->
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

        </Grid>

        <!-- 🌟 طبقة نتيجة الجولة (Modal Overlay) -->
        <Grid x:Name="ResultOverlay" BackgroundColor="#E6050811" IsVisible="False" ZIndex="999">
            <Border StrokeThickness="1.5"
                    Stroke="#F59E0B"
                    StrokeShape="RoundRectangle 26"
                    BackgroundColor="#0B1320"
                    Padding="24"
                    WidthRequest="320"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label x:Name="ResultIconLabel" Text="⚛️" FontSize="54" HorizontalOptions="Center"/>
                    <Label x:Name="ResultTitleLabel" Text="استقرار المفاعل! 🎉" FontSize="22" FontFamily="CairoBold" TextColor="#F59E0B" HorizontalOptions="Center"/>
                    <Label x:Name="ResultDescLabel" Text="تمت تهجئة واسترجاع جميع الكلمات بنجاح تام." FontSize="13" FontFamily="CairoRegular" TextColor="#94A3B8" HorizontalTextAlignment="Center"/>

                    <!-- إحصائيات الإنجاز -->
                    <Border BackgroundColor="#111A2E" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16,10">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                                <Label Text="الكلمات المكتملة" FontSize="11" TextColor="#94A3B8" FontFamily="CairoRegular"/>
                                <Label x:Name="ResultWordsCountLabel" Text="10 🧪" FontSize="16" TextColor="#F59E0B" FontFamily="CairoBold" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                                <Label Text="النقاط المحققة" FontSize="11" TextColor="#94A3B8" FontFamily="CairoRegular"/>
                                <Label x:Name="ResultScoreLabel" Text="+100 ⭐" FontSize="16" TextColor="#FBBF24" FontFamily="CairoBold" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Button Text="تشغيل مفاعل جديد 🔁"
                            HeightRequest="48"
                            CornerRadius="24"
                            BackgroundColor="#D97706"
                            TextColor="White"
                            FontFamily="CairoBold"
                            FontSize="15"
                            Clicked="OnPlayAgainClicked"/>

                    <Button Text="العودة"
                            HeightRequest="44"
                            CornerRadius="22"
                            BackgroundColor="Transparent"
                            BorderColor="#334155"
                            BorderWidth="1"
                            TextColor="#94A3B8"
                            FontFamily="CairoBold"
                            FontSize="14"
                            Clicked="OnExitConfirmedClicked"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>