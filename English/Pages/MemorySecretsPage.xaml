<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.MemorySecretsPage"
             FlowDirection="RightToLeft"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <!-- خلفية نيون داكنة سينمائية متناسقة مع التطبيق -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#080D1A" Offset="0.0" />
            <GradientStop Color="#0F172A" Offset="0.5" />
            <GradientStop Color="#13132B" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *">

        <!-- ══════════════ 1. الترويسة العلوية الفاخرة (Header) ══════════════ -->
        <Grid Grid.Row="0" Padding="18,14,18,12" ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
            
            <!-- زر العودة المريح للمس -->
            <Border Grid.Column="0"
                    BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    WidthRequest="38"
                    HeightRequest="38"
                    Padding="8"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked"/>
                </Border.GestureRecognizers>
                <Label Text="✕" TextColor="#CBD5E1" FontSize="15" FontFamily="CairoBold" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- عنوان وتفاصيل الدليل -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="أسرار وتقنيات الحفظ السريع" 
                           FontSize="18" 
                           FontFamily="CairoBold" 
                           TextColor="White"
                           VerticalOptions="Center"/>
                    <Label Text="🧠" FontSize="18" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Text="6 استراتيجيات عقلية مثبتة علمياً لتثبيت أي كلمة إنجليزية بسهولة" 
                       FontSize="11" 
                       FontFamily="CairoRegular" 
                       TextColor="#94A3B8"/>
            </VerticalStackLayout>
        </Grid>

        <!-- ══════════════ 2. قائمة الاستراتيجيات الست الكبرى (مع هامش سفلي كافٍ) ══════════════ -->
        <ScrollView Grid.Row="1" Orientation="Vertical" Padding="16, 12, 16, 100">
            <VerticalStackLayout Spacing="16">

                <!-- 🧱 الاستراتيجية 1: التفكيك اللغوي (Word Lego) -->
                <Border BackgroundColor="#0A1628" 
                        Stroke="#38BDF8" 
                        StrokeThickness="1.5" 
                        StrokeShape="RoundRectangle 22" 
                        Padding="16,16">
                    <Border.Shadow>
                        <Shadow Brush="#38BDF8" Radius="12" Offset="0,3" Opacity="0.16"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <!-- ترويسة الكرت المنظمة -->
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Start">
                            <!-- أعلى اليمين: أيقونة التقنية -->
                            <Border Grid.Column="0" 
                                    BackgroundColor="#132B45" 
                                    Stroke="#38BDF8" 
                                    StrokeThickness="0.8" 
                                    StrokeShape="RoundRectangle 12" 
                                    WidthRequest="44" HeightRequest="44" 
                                    VerticalOptions="Start">
                                <Label Text="🧱" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <!-- المنتصف: العنوان والاسم الإنجليزي والوصف -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Start">
                                <Label Text="1. التفكيك اللغوي" FontSize="15" FontFamily="CairoBold" TextColor="White"/>
                                <Label Text="(Word Lego)" FontSize="11" FontFamily="CairoRegular" TextColor="#93C5FD"/>
                                <Label Text="فك الكتل الطويلة إلى قطع مألوفة" FontSize="11" FontFamily="CairoRegular" TextColor="#94A3B8"/>
                            </VerticalStackLayout>

                            <!-- أعلى اليسار: بادج التصنيف الأنيق -->
                            <Border Grid.Column="2" 
                                    BackgroundColor="#082F49" 
                                    Stroke="#38BDF8" 
                                    StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 16" 
                                    Padding="10,4" 
                                    VerticalOptions="Start">
                                <Label Text="تحليل الكلمات" FontSize="10" FontFamily="CairoBold" TextColor="#38BDF8"/>
                            </Border>
                        </Grid>

                        <Label Text="أكثر من 80% من الكلمات الإنجليزية الطويلة هي في الحقيقة مجرد كلمتين أو ثلاث كلمات سهلة مدموجة معاً! لا تحفظ الكلمة ككتلة واحدة شاقة، بل فككها لتكتشف أنك تعرفها بالفعل."
                               FontSize="12" FontFamily="CairoRegular" TextColor="#E2E8F0" LineHeight="1.3"/>

                        <!-- صندوق الأمثلة المعالج بتقنية الكبسولات الأفقية -->
                        <Border BackgroundColor="#061220" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="أمثلة حية وتطبيقية:" FontSize="11.5" FontFamily="CairoBold" TextColor="#38BDF8"/>
                                
                                <!-- مثال 1: Breakfast -->
                                <Border BackgroundColor="#0A1628" Stroke="#1E3A5F" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,8">
                                    <VerticalStackLayout Spacing="6">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center" FlowDirection="LeftToRight">
                                            <Border BackgroundColor="#1E3A5F" Stroke="#38BDF8" StrokeThickness="0.8" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="Break" FontSize="12" FontFamily="CairoBold" TextColor="#38BDF8"/>
                                            </Border>
                                            <Label Text="+" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                                            <Border BackgroundColor="#1E3A5F" Stroke="#38BDF8" StrokeThickness="0.8" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="Fast" FontSize="12" FontFamily="CairoBold" TextColor="#38BDF8"/>
                                            </Border>
                                            <Label Text="➔" TextColor="#38BDF8" FontSize="14" VerticalOptions="Center"/>
                                            <Border BackgroundColor="#0284C7" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="Breakfast" FontSize="12" FontFamily="CairoBold" TextColor="White"/>
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Text="كسر الصيام ➔ وجبة الفطور" FontSize="11" FontFamily="CairoRegular" TextColor="#CBD5E1"/>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- مثال 2: Sunflower -->
                                <Border BackgroundColor="#0A1628" Stroke="#1E3A5F" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,8">
                                    <VerticalStackLayout Spacing="6">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center" FlowDirection="LeftToRight">
                                            <Border BackgroundColor="#1E3A5F" Stroke="#38BDF8" StrokeThickness="0.8" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="Sun" FontSize="12" FontFamily="CairoBold" TextColor="#38BDF8"/>
                                            </Border>
                                            <Label Text="+" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                                            <Border BackgroundColor="#1E3A5F" Stroke="#38BDF8" StrokeThickness="0.8" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="Flower" FontSize="12" FontFamily="CairoBold" TextColor="#38BDF8"/>
                                            </Border>
                                            <Label Text="➔" TextColor="#38BDF8" FontSize="14" VerticalOptions="Center"/>
                                            <Border BackgroundColor="#0284C7" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="Sunflower" FontSize="12" FontFamily="CairoBold" TextColor="White"/>
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Text="شمس + زهرة ➔ زهرة دوار الشمس" FontSize="11" FontFamily="CairoRegular" TextColor="#CBD5E1"/>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- مثال 3: Password -->
                                <Border BackgroundColor="#0A1628" Stroke="#1E3A5F" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,8">
                                    <VerticalStackLayout Spacing="6">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center" FlowDirection="LeftToRight">
                                            <Border BackgroundColor="#1E3A5F" Stroke="#38BDF8" StrokeThickness="0.8" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="Pass" FontSize="12" FontFamily="CairoBold" TextColor="#38BDF8"/>
                                            </Border>
                                            <Label Text="+" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                                            <Border BackgroundColor="#1E3A5F" Stroke="#38BDF8" StrokeThickness="0.8" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="Word" FontSize="12" FontFamily="CairoBold" TextColor="#38BDF8"/>
                                            </Border>
                                            <Label Text="➔" TextColor="#38BDF8" FontSize="14" VerticalOptions="Center"/>
                                            <Border BackgroundColor="#0284C7" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="Password" FontSize="12" FontFamily="CairoBold" TextColor="White"/>
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Text="يمر + كلمة ➔ كلمة المرور" FontSize="11" FontFamily="CairoRegular" TextColor="#CBD5E1"/>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- سر الذاكرة الذهبي -->
                        <Border BackgroundColor="#0B1329" 
                                Stroke="#1E293B" 
                                StrokeThickness="1" 
                                StrokeShape="RoundRectangle 12" 
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                <Border Grid.Column="0" 
                                        BackgroundColor="#1E293B" 
                                        StrokeShape="RoundRectangle 8" 
                                        WidthRequest="28" HeightRequest="28" 
                                        VerticalOptions="Center">
                                    <Label Text="💡" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="سر الذاكرة الذهبي:" FontSize="11" FontFamily="CairoBold" TextColor="#FBBF24"/>
                                    <Label Text="ابحث دائماً عن الكلمات الصغيرة المختبئة داخل الكلمة الطويلة قبل حفظها." 
                                           FontSize="11.5" FontFamily="CairoRegular" TextColor="#CBD5E1" LineHeight="1.25"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ⏳ الاستراتيجية 2: الاسترجاع الذهني النشط (Active Recall) -->
                <Border BackgroundColor="#1F1608" 
                        Stroke="#F59E0B" 
                        StrokeThickness="1.5" 
                        StrokeShape="RoundRectangle 22" 
                        Padding="16,16">
                    <Border.Shadow>
                        <Shadow Brush="#F59E0B" Radius="12" Offset="0,3" Opacity="0.16"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <!-- ترويسة الكرت المنظمة -->
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Start">
                            <Border Grid.Column="0" 
                                    BackgroundColor="#382305" 
                                    Stroke="#F59E0B" 
                                    StrokeThickness="0.8" 
                                    StrokeShape="RoundRectangle 12" 
                                    WidthRequest="44" HeightRequest="44" 
                                    VerticalOptions="Start">
                                <Label Text="⏳" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Start">
                                <Label Text="2. سر الـ 3 ثوانٍ الذهبية" FontSize="15" FontFamily="CairoBold" TextColor="White"/>
                                <Label Text="(Active Recall)" FontSize="11" FontFamily="CairoRegular" TextColor="#FCD34D"/>
                                <Label Text="الاسترجاع النشط قبل كشف الترجمة" FontSize="11" FontFamily="CairoRegular" TextColor="#94A3B8"/>
                            </VerticalStackLayout>

                            <Border Grid.Column="2" 
                                    BackgroundColor="#351F06" 
                                    Stroke="#F59E0B" 
                                    StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 16" 
                                    Padding="10,4" 
                                    VerticalOptions="Start">
                                <Label Text="أقوى مثبت" FontSize="10" FontFamily="CairoBold" TextColor="#F59E0B"/>
                            </Border>
                        </Grid>

                        <Label Text="عندما ترى الكلمة الإنجليزية، قاوم الرغبة في قلب البطاقة أو النظر للترجمة فوراً! أغمض عينيك لمدة 3 ثوانٍ فقط، واضغط على ذهنك لمحاولة تذكر المعنى أولاً."
                               FontSize="12" FontFamily="CairoRegular" TextColor="#E2E8F0" LineHeight="1.3"/>

                        <!-- مسار دورة الاسترجاع العملي -->
                        <Border BackgroundColor="#140E06" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="مسار الاسترجاع الذهني النشط:" FontSize="11.5" FontFamily="CairoBold" TextColor="#F59E0B"/>
                                
                                <Border BackgroundColor="#1F1608" Stroke="#452B09" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,8">
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center" FlowDirection="LeftToRight">
                                            <Border BackgroundColor="#351F06" Stroke="#F59E0B" StrokeThickness="0.8" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="1. انظر للكلمة" FontSize="11" FontFamily="CairoBold" TextColor="#FDE68A"/>
                                            </Border>
                                            <Label Text="➔" TextColor="#F59E0B" FontSize="13" VerticalOptions="Center"/>
                                            <Border BackgroundColor="#452B09" Stroke="#F59E0B" StrokeThickness="0.8" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="2. توقف 3 ثوانٍ ⏱️" FontSize="11" FontFamily="CairoBold" TextColor="#FBBF24"/>
                                            </Border>
                                            <Label Text="➔" TextColor="#F59E0B" FontSize="13" VerticalOptions="Center"/>
                                            <Border BackgroundColor="#D97706" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="3. تذكّر المعنى" FontSize="11" FontFamily="CairoBold" TextColor="White"/>
                                            </Border>
                                        </HorizontalStackLayout>
                                        
                                        <Label Text="تطبيق حي: انظر إلى كلمة [ Challenge ] ➔ قف 3 ثوانٍ متأملاً ➔ استرجع أنها تعني [ تحدي ] قبل كشف الحل." 
                                               FontSize="11" FontFamily="CairoRegular" TextColor="#CBD5E1" LineHeight="1.25"/>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- صندوق ماذا يحدث في عقلك؟ -->
                        <Border BackgroundColor="#0F172A" 
                                Stroke="#1E293B" 
                                StrokeThickness="1" 
                                StrokeShape="RoundRectangle 12" 
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                <Border Grid.Column="0" 
                                        BackgroundColor="#1E293B" 
                                        StrokeShape="RoundRectangle 8" 
                                        WidthRequest="28" HeightRequest="28" 
                                        VerticalOptions="Center">
                                    <Label Text="🧠" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="ماذا يحدث في عقلك؟" FontSize="11" FontFamily="CairoBold" TextColor="#F59E0B"/>
                                    <Label Text="المجهود الذهني الذي تبذله في تلك الثواني الثلاث هو الذي يبني المسار العصبي وينقل الكلمة من الذاكرة اللحظية إلى الذاكرة الدائمة؛ أما القراءة المباشرة للترجمة فتنساها بعد دقائق." 
                                           FontSize="11.5" FontFamily="CairoRegular" TextColor="#CBD5E1" LineHeight="1.25"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- سر الذاكرة الذهبي -->
                        <Border BackgroundColor="#0B1329" 
                                Stroke="#1E293B" 
                                StrokeThickness="1" 
                                StrokeShape="RoundRectangle 12" 
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                <Border Grid.Column="0" 
                                        BackgroundColor="#1E293B" 
                                        StrokeShape="RoundRectangle 8" 
                                        WidthRequest="28" HeightRequest="28" 
                                        VerticalOptions="Center">
                                    <Label Text="💡" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="سر الذاكرة الذهبي:" FontSize="11" FontFamily="CairoBold" TextColor="#FBBF24"/>
                                    <Label Text="الجهد المبذول في استدعاء المعلومة هو ما يرسخها، وليس تكرار قراءتها سلبياً." 
                                           FontSize="11.5" FontFamily="CairoRegular" TextColor="#CBD5E1" LineHeight="1.25"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 🎵 الاستراتيجية 3: التقطيع النغمي الصوتي (Syllable Beats) -->
                <Border BackgroundColor="#081E18" 
                        Stroke="#10B981" 
                        StrokeThickness="1.5" 
                        StrokeShape="RoundRectangle 22" 
                        Padding="16,16">
                    <Border.Shadow>
                        <Shadow Brush="#10B981" Radius="12" Offset="0,3" Opacity="0.16"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <!-- ترويسة الكرت المنظمة -->
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Start">
                            <Border Grid.Column="0" 
                                    BackgroundColor="#09382A" 
                                    Stroke="#10B981" 
                                    StrokeThickness="0.8" 
                                    StrokeShape="RoundRectangle 12" 
                                    WidthRequest="44" HeightRequest="44" 
                                    VerticalOptions="Start">
                                <Label Text="🎵" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Start">
                                <Label Text="3. التقطيع النغمي" FontSize="15" FontFamily="CairoBold" TextColor="White"/>
                                <Label Text="(Syllable Beats)" FontSize="11" FontFamily="CairoRegular" TextColor="#A7F3D0"/>
                                <Label Text="تحويل الكلمة إلى إيقاع موسيقي مريح" FontSize="11" FontFamily="CairoRegular" TextColor="#94A3B8"/>
                            </VerticalStackLayout>

                            <Border Grid.Column="2" 
                                    BackgroundColor="#062F24" 
                                    Stroke="#10B981" 
                                    StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 16" 
                                    Padding="10,4" 
                                    VerticalOptions="Start">
                                <Label Text="إيقاع صوتي" FontSize="10" FontFamily="CairoBold" TextColor="#10B981"/>
                            </Border>
                        </Grid>

                        <Label Text="الأذن البشرية تعشق النغم وتلتقط الألحان بسرعة مذهلة! الكلمات الطويلة أو المعقدة تُحفظ بلمح البصر عندما تقسمها إلى نغمتين أو ثلاث نغمات خفيفة متتابعة."
                               FontSize="12" FontFamily="CairoRegular" TextColor="#E2E8F0" LineHeight="1.3"/>

                        <!-- صندوق الأمثلة بكبسولات المقاطع النغمية -->
                        <Border BackgroundColor="#051410" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="أمثلة التقطيع النغمي:" FontSize="11.5" FontFamily="CairoBold" TextColor="#10B981"/>
                                
                                <!-- مثال 1: Hospital -->
                                <Border BackgroundColor="#081E18" Stroke="#0E4233" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,8">
                                    <VerticalStackLayout Spacing="6">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center" FlowDirection="LeftToRight">
                                            <Border BackgroundColor="#062F24" Stroke="#10B981" StrokeThickness="0.8" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="Hos" FontSize="12" FontFamily="CairoBold" TextColor="#A7F3D0"/>
                                            </Border>
                                            <Label Text="•" TextColor="#10B981" FontSize="14" VerticalOptions="Center"/>
                                            <Border BackgroundColor="#062F24" Stroke="#10B981" StrokeThickness="0.8" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="pi" FontSize="12" FontFamily="CairoBold" TextColor="#A7F3D0"/>
                                            </Border>
                                            <Label Text="•" TextColor="#10B981" FontSize="14" VerticalOptions="Center"/>
                                            <Border BackgroundColor="#062F24" Stroke="#10B981" StrokeThickness="0.8" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="tal" FontSize="12" FontFamily="CairoBold" TextColor="#A7F3D0"/>
                                            </Border>
                                            <Label Text="➔" TextColor="#10B981" FontSize="14" VerticalOptions="Center"/>
                                            <Border BackgroundColor="#059669" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="Hospital" FontSize="12" FontFamily="CairoBold" TextColor="White"/>
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Text="ثلاث دقات متوازنة ➔ مستشفى" FontSize="11" FontFamily="CairoRegular" TextColor="#CBD5E1"/>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- مثال 2: Beautiful -->
                                <Border BackgroundColor="#081E18" Stroke="#0E4233" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,8">
                                    <VerticalStackLayout Spacing="6">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center" FlowDirection="LeftToRight">
                                            <Border BackgroundColor="#062F24" Stroke="#10B981" StrokeThickness="0.8" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="Beau" FontSize="12" FontFamily="CairoBold" TextColor="#A7F3D0"/>
                                            </Border>
                                            <Label Text="•" TextColor="#10B981" FontSize="14" VerticalOptions="Center"/>
                                            <Border BackgroundColor="#062F24" Stroke="#10B981" StrokeThickness="0.8" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="ti" FontSize="12" FontFamily="CairoBold" TextColor="#A7F3D0"/>
                                            </Border>
                                            <Label Text="•" TextColor="#10B981" FontSize="14" VerticalOptions="Center"/>
                                            <Border BackgroundColor="#062F24" Stroke="#10B981" StrokeThickness="0.8" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="ful" FontSize="12" FontFamily="CairoBold" TextColor="#A7F3D0"/>
                                            </Border>
                                            <Label Text="➔" TextColor="#10B981" FontSize="14" VerticalOptions="Center"/>
                                            <Border BackgroundColor="#059669" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,3">
                                                <Label Text="Beautiful" FontSize="12" FontFamily="CairoBold" TextColor="White"/>
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Text="نغمة خفيفة متدفقة ➔ جميل" FontSize="11" FontFamily="CairoRegular" TextColor="#CBD5E1"/>
                                    </VerticalStackLayout>
