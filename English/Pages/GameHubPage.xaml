<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             x:Class="English.Pages.GameHubPage" 
             FlowDirection="RightToLeft" 
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0.0" />
            <GradientStop Color="#1E1B4B" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *">

        <!-- 🟢 1. ترويسة الصفحة العلويّة (Header) -->
        <Grid Grid.Row="0" Padding="24,24,24,10" ColumnDefinitions="*, Auto" VerticalOptions="Center">
            
            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                <Label Text="التحديات 🎮" FontSize="30" FontFamily="CairoBold" TextColor="White"/>
                <Label Text="اختر لعبتك وطوّر لغتك بمتعة!" FontSize="14" FontFamily="CairoRegular" TextColor="#94A3B8"/>
            </VerticalStackLayout>

            <!-- بادج التحديات -->
            <Border Grid.Column="1" BackgroundColor="#1E293B" StrokeThickness="1" Stroke="#334155" StrokeShape="RoundRectangle 16" Padding="14,10" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChallengeFriendTapped"/>
                </Border.GestureRecognizers>

                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="⚔️" FontSize="18" VerticalOptions="Center"/>
                    <Label x:Name="ChallengeCountLabel" Text="0" FontSize="18" FontFamily="CairoBold" TextColor="#FBBF24" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

        </Grid>

        <!-- 🟢 2. قائمة بطاقات الألعاب التفاعلية (Cards) -->
        <ScrollView Grid.Row="1" Padding="24,10,24,30">
            <VerticalStackLayout x:Name="CardsLayout" Spacing="24">

                <!-- 🧠 بطاقة اللعبة الأولى: المفتش الذكي -->
                <Border StrokeThickness="1.5" StrokeShape="RoundRectangle 24" BackgroundColor="#111827">
                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#8B5CF6" Offset="0" />
                            <GradientStop Color="#EC4899" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Stroke>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSmartInspectorTapped"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <!-- Glow Overlay -->
                        <BoxView Opacity="0.1" CornerRadius="24">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0" />
                                    <GradientStop Color="#EC4899" Offset="1" />
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                        <VerticalStackLayout Padding="20" Spacing="16">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#8B5CF6" Offset="0" />
                                            <GradientStop Color="#EC4899" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="🔍" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="16,0,0,0" Spacing="2">
                                    <Label Text="المفتش الذكي" FontSize="20" FontFamily="CairoBold" TextColor="White"/>
                                    <Label Text="تخمين وذكاء 💡" FontSize="13" FontFamily="CairoRegular" TextColor="#A78BFA"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Label Text="اكتشف الكلمة السرية الإنجليزية عن طريق الأسئلة والتخمين المنطقي بأقل عدد محاولات." 
                                   FontSize="14" FontFamily="CairoRegular" TextColor="#CBD5E1" LineBreakMode="WordWrap" LineHeight="1.5"/>

                            <Button Text="خوض التحدي 🚀" TextColor="White" FontFamily="CairoBold" FontSize="15" HeightRequest="52" CornerRadius="14" Clicked="OnSmartInspectorTapped">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8B5CF6" Offset="0" />
                                        <GradientStop Color="#EC4899" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ⚡ بطاقة اللعبة الثانية: تحدي الخيارات -->
                <Border StrokeThickness="1.5" StrokeShape="RoundRectangle 24" BackgroundColor="#111827">
                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#10B981" Offset="0" />
                            <GradientStop Color="#06B6D4" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Stroke>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChoiceChallengeTapped"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <!-- Glow Overlay -->
                        <BoxView Opacity="0.1" CornerRadius="24">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10B981" Offset="0" />
                                    <GradientStop Color="#06B6D4" Offset="1" />
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                        <VerticalStackLayout Padding="20" Spacing="16">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#10B981" Offset="0" />
                                            <GradientStop Color="#06B6D4" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="⚡" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="16,0,0,0" Spacing="2">
                                    <Label Text="تحدي الخيارات" FontSize="20" FontFamily="CairoBold" TextColor="White"/>
                                    <Label Text="سرعة ومعرفة ⚡" FontSize="13" FontFamily="CairoRegular" TextColor="#34D399"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Label Text="اختبر مفرداتك وسرعة إجابتك باختيار المعنى الصحيح للكلمات من بين عدة خيارات." 
                                   FontSize="14" FontFamily="CairoRegular" TextColor="#CBD5E1" LineBreakMode="WordWrap" LineHeight="1.5"/>

                            <Button Text="خوض التحدي 🚀" TextColor="White" FontFamily="CairoBold" FontSize="15" HeightRequest="52" CornerRadius="14" Clicked="OnChoiceChallengeTapped">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#10B981" Offset="0" />
                                        <GradientStop Color="#06B6D4" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ✍️ بطاقة اللعبة الثالثة: تحدي الكتابة -->
                <Border StrokeThickness="1.5" StrokeShape="RoundRectangle 24" BackgroundColor="#111827">
                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0" />
                            <GradientStop Color="#6366F1" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Stroke>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWritingChallengeTapped"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <!-- Glow Overlay -->
                        <BoxView Opacity="0.1" CornerRadius="24">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0" />
                                    <GradientStop Color="#6366F1" Offset="1" />
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                        <VerticalStackLayout Padding="20" Spacing="16">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F6" Offset="0" />
                                            <GradientStop Color="#6366F1" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="✍️" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="16,0,0,0" Spacing="2">
                                    <Label Text="تحدي الكتابة" FontSize="20" FontFamily="CairoBold" TextColor="White"/>
                                    <Label Text="إملاء ودقة 📝" FontSize="13" FontFamily="CairoRegular" TextColor="#93C5FD"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Label Text="اكتب الكلمة الإنجليزية الصحيحة وطور مهاراتك الإملائية في جو من الحماس والتحدي." 
                                   FontSize="14" FontFamily="CairoRegular" TextColor="#CBD5E1" LineBreakMode="WordWrap" LineHeight="1.5"/>

                            <Button Text="خوض التحدي 🚀" TextColor="White" FontFamily="CairoBold" FontSize="15" HeightRequest="52" CornerRadius="14" Clicked="OnWritingChallengeTapped">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3B82F6" Offset="0" />
                                        <GradientStop Color="#6366F1" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>