<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="English.Pages.MorePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="المزيد"
             FlowDirection="RightToLeft"
             BackgroundColor="#12161D"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="22,45,22,30" Spacing="5">

            <!-- الحساب -->
            <Label Text="الحساب" FontSize="14" FontAttributes="Bold" TextColor="#A6A6A6" Margin="6,10,0,5"/>

            <!-- البيانات الشخصية -->
            <Border BackgroundColor="#252A34" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16" HeightRequest="65" Margin="0,0,0,12" ClassId="Profile">
                <Grid ColumnDefinitions="40,*,25">
                    <Image Source="user.png" WidthRequest="25" HeightRequest="25" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="البيانات الشخصية" FontSize="16" FontAttributes="Bold" TextColor="#F1F1F1" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="›" FontSize="25" TextColor="#8A8A8A" HorizontalOptions="End" VerticalOptions="Center"/>
                </Grid>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="MenuClicked"/>
                </Border.GestureRecognizers>
            </Border>


            <!-- الأصدقاء -->
            <Border BackgroundColor="#252A34" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16" HeightRequest="65" Margin="0,0,0,12" ClassId="Friends">
                <Grid ColumnDefinitions="40,*,25">
                    <Image Source="group.png" WidthRequest="25" HeightRequest="25" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="إدارة الأصدقاء" FontSize="16" FontAttributes="Bold" TextColor="#F1F1F1" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="›" FontSize="25" TextColor="#8A8A8A" HorizontalOptions="End" VerticalOptions="Center"/>
                </Grid>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="MenuClicked"/>
                </Border.GestureRecognizers>
            </Border>


            <!-- الرسائل -->
            <Border BackgroundColor="#252A34" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16" HeightRequest="65" Margin="0,0,0,12" ClassId="Messages">
                <Grid ColumnDefinitions="40,*,25">
                    <Image Source="messages.png" WidthRequest="25" HeightRequest="25" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="الرسائل" FontSize="16" FontAttributes="Bold" TextColor="#F1F1F1" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="›" FontSize="25" TextColor="#8A8A8A" HorizontalOptions="End" VerticalOptions="Center"/>
                </Grid>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="MenuClicked"/>
                </Border.GestureRecognizers>
            </Border>


            <!-- التطبيق -->
            <Label Text="التطبيق" FontSize="14" FontAttributes="Bold" TextColor="#A6A6A6" Margin="6,10,0,5"/>


            <!-- مشاركة التطبيق -->
            <Border BackgroundColor="#252A34" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16" HeightRequest="65" Margin="0,0,0,12" ClassId="Share">
                <Grid ColumnDefinitions="40,*,25">
                    <Image Source="share.png" WidthRequest="25" HeightRequest="25" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="مشاركة التطبيق" FontSize="16" FontAttributes="Bold" TextColor="#F1F1F1" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="›" FontSize="25" TextColor="#8A8A8A" HorizontalOptions="End" VerticalOptions="Center"/>
                </Grid>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="MenuClicked"/>
                </Border.GestureRecognizers>
            </Border>


            <!-- حول التطبيق -->
            <Border BackgroundColor="#252A34" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16" HeightRequest="65" Margin="0,0,0,12" ClassId="About">
                <Grid ColumnDefinitions="40,*,25">
                    <Image Source="information.png" WidthRequest="25" HeightRequest="25" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="حول التطبيق" FontSize="16" FontAttributes="Bold" TextColor="#F1F1F1" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="›" FontSize="25" TextColor="#8A8A8A" HorizontalOptions="End" VerticalOptions="Center"/>
                </Grid>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="MenuClicked"/>
                </Border.GestureRecognizers>
            </Border>


            <!-- تسجيل الخروج -->
            <Border BackgroundColor="#252A34" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16" HeightRequest="65" Margin="0,0,0,12" ClassId="Logout">
                <Grid ColumnDefinitions="40,*">
                    <Image Source="logout.png" WidthRequest="25" HeightRequest="25" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="تسجيل الخروج" FontSize="16" FontAttributes="Bold" TextColor="#EF4444" VerticalOptions="Center"/>
                </Grid>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="MenuClicked"/>
                </Border.GestureRecognizers>
            </Border>


            <!-- الإصدار -->
            <Label Text="Version 1.0.0" FontSize="12" TextColor="#7A7A7A" HorizontalOptions="Center" Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>