<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.TikTokLiveArenaPage"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <!-- 🌌 خلفية سينمائية استثنائية مخصصة للبث المباشر على تيك توك -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#050814" Offset="0.0" />
            <GradientStop Color="#091226" Offset="0.5" />
            <GradientStop Color="#0C1B33" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="16,24,16,20">

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 🔴 1. شريط البث العلوي (Broadcast Header)                    -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center" Margin="0,0,0,10">
            <!-- شارة البث الحي المباشر -->
            <Border Grid.Column="0"
                    BackgroundColor="#1F1318"
                    Stroke="#EF4444"
                    StrokeThickness="1.2"
                    StrokeShape="RoundRectangle 16"
                    Padding="10,5"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label x:Name="LiveDotLabel" Text="🔴" FontSize="11" VerticalOptions="Center"/>
                    <Label Text="LIVE" FontSize="11" FontFamily="CairoBold" TextColor="#EF4444" VerticalOptions="Center"/>
                    <Label x:Name="HostHandleLabel" Text="@live" FontSize="11" FontFamily="CairoBold" TextColor="White" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

            <!-- رقم وتتابع السؤال -->
            <Border Grid.Column="1"
                    BackgroundColor="#0F172A"
                    Stroke="#263B5E"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,5"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Label x:Name="QuestionProgressLabel"
                       Text="سؤال 1 من 20"
                       FontSize="12"
                       FontFamily="CairoBold"
                       TextColor="#94A3B8"/>
            </Border>

            <!-- زر خروج / إنهاء البث -->
            <Border Grid.Column="2"
                    BackgroundColor="#1E293B"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="10,5"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnExitTapped"/>
                </Border.GestureRecognizers>
                <Label Text="✕ إنهاء" FontSize="11" FontFamily="CairoBold" TextColor="#CBD5E1"/>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 🏆 2. لوحة الشرف الحية العمودية (Vertical Top Scorers Podium) -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                BackgroundColor="#0C1424"
                Stroke="#1E2E4A"
                StrokeThickness="1.2"
                StrokeShape="RoundRectangle 18"
                Padding="14,10"
                Margin="0,0,0,10">
            <VerticalStackLayout Spacing="8">
                <!-- عنوان لوحة الشرف -->
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                        <Label Text="🏆" FontSize="16" VerticalOptions="Center"/>
                        <Label Text="متصدرو البث المباشر (Top Scorers)" FontSize="13" FontFamily="CairoBold" TextColor="#FBBF24"/>
                    </HorizontalStackLayout>
                    <Label Grid.Column="2" x:Name="ActiveViewersCountLabel" Text="أسرع إجابة = 3 نقاط ⚡" FontSize="11" FontFamily="CairoBold" TextColor="#38BDF8"/>
                </Grid>

                <!-- القائمة العمودية للمتصدرين: كل متسابق في سطر كامل عالي الوضوح -->
                <VerticalStackLayout x:Name="LeaderboardLayout" Spacing="6">
                    <!-- العناصر تُنشأ وتُحدث برمجياً بسلاسة بحجم كبير وواضح -->
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 🎯 3. مسرح السؤال التفاعلي والمؤقت والخيارات الأربعة          -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <VerticalStackLayout Grid.Row="2" VerticalOptions="Center" Spacing="14">

            <!-- بنر الإشعار / الاحتفال بأسرع مجيب -->
            <Border x:Name="CelebrationBanner"
                    IsVisible="False"
                    BackgroundColor="#1F2A1A"
                    Stroke="#10B981"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 16"
                    Padding="12,7"
                    HorizontalOptions="Center">
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="👑" FontSize="16" VerticalOptions="Center"/>
                    <Label x:Name="CelebrationTextLabel"
                           Text="أسرع إجابة: @fahad_sa (+3 نقاط) ⚡"
                           FontSize="12.5"
                           FontFamily="CairoBold"
                           TextColor="#6EE7B7"/>
                </HorizontalStackLayout>
            </Border>

            <!-- ⏱️ مؤقت السؤال الاحترافي الفاخر (Broadcast Timer Pod - لا يتداخل إطلاقاً) -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" WidthRequest="250">
                <Border BackgroundColor="#0D1627"
                        Stroke="#233554"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 22"
                        Padding="18,6">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="⏱️" FontSize="20" VerticalOptions="Center"/>
                        <Label x:Name="TimerSecondsLabel"
                               Text="10"
                               FontSize="24"
                               FontFamily="CairoBold"
                               TextColor="#38BDF8"
                               VerticalOptions="Center">
                            <Label.Shadow>
                                <Shadow Brush="#38BDF8" Radius="10" Opacity="0.5"/>
                            </Label.Shadow>
                        </Label>
                        <Label Text="ثوانٍ متبقية" FontSize="12" FontFamily="CairoRegular" TextColor="#94A3B8" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <!-- شريط التقدم النيوني أسفل العداد بوضوح تام وبدون أي تداخل -->
                <ProgressBar x:Name="TimerProgressBar"
                             Progress="1.0"
                             ProgressColor="#38BDF8"
                             HeightRequest="5"
                             HorizontalOptions="Fill"/>
            </VerticalStackLayout>

            <!-- الكلمة الإنجليزية الكبيرة -->
            <Label x:Name="EnglishWordLabel"
                   Text="Adventure"
                   TextColor="White"
                   FontSize="44"
                   FontFamily="CairoBold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,6">
                <Label.Shadow>
                    <Shadow Brush="#38BDF8" Radius="24" Offset="0,0" Opacity="0.5"/>
                </Label.Shadow>
            </Label>

            <!-- شبكة الخيارات الأربعة مع عداد ونسب التصويت اللحظي -->
            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" RowSpacing="12" ColumnSpacing="12">

                <!-- الخيار [ 1 ] -->
                <Border x:Name="OptionCard0" Grid.Row="0" Grid.Column="0"
                        BackgroundColor="#0F172A" Stroke="#263B5E" StrokeThickness="1.5" StrokeShape="RoundRectangle 18" Padding="12,10" HeightRequest="90">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOptionManualTapped" CommandParameter="0"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="*, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="26" HeightRequest="26" VerticalOptions="Start">
                                <Label Text="1" FontSize="13" FontFamily="CairoBold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" x:Name="OptionText0" Text="مغامرة" FontSize="16" FontFamily="CairoBold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                        </Grid>
                        <!-- شريط التصويت اللحظي للشات -->
                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="6" VerticalOptions="End">
                            <ProgressBar x:Name="OptionProgress0" Progress="0.0" ProgressColor="#38BDF8" HeightRequest="4" VerticalOptions="Center"/>
                            <Label Grid.Column="1" x:Name="OptionVotesLabel0" Text="0" FontSize="11" FontFamily="CairoBold" TextColor="#94A3B8"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- الخيار [ 2 ] -->
                <Border x:Name="OptionCard1" Grid.Row="0" Grid.Column="1"
                        BackgroundColor="#0F172A" Stroke="#263B5E" StrokeThickness="1.5" StrokeShape="RoundRectangle 18" Padding="12,10" HeightRequest="90">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOptionManualTapped" CommandParameter="1"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="*, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="26" HeightRequest="26" VerticalOptions="Start">
                                <Label Text="2" FontSize="13" FontFamily="CairoBold" TextColor="#F59E0B" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" x:Name="OptionText1" Text="رحلة" FontSize="16" FontFamily="CairoBold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                        </Grid>
                        <!-- شريط التصويت اللحظي للشات -->
                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="6" VerticalOptions="End">
                            <ProgressBar x:Name="OptionProgress1" Progress="0.0" ProgressColor="#F59E0B" HeightRequest="4" VerticalOptions="Center"/>
                            <Label Grid.Column="1" x:Name="OptionVotesLabel1" Text="0" FontSize="11" FontFamily="CairoBold" TextColor="#94A3B8"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- الخيار [ 3 ] -->
                <Border x:Name="OptionCard2" Grid.Row="1" Grid.Column="0"
                        BackgroundColor="#0F172A" Stroke="#263B5E" StrokeThickness="1.5" StrokeShape="RoundRectangle 18" Padding="12,10" HeightRequest="90">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOptionManualTapped" CommandParameter="2"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="*, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="26" HeightRequest="26" VerticalOptions="Start">
                                <Label Text="3" FontSize="13" FontFamily="CairoBold" TextColor="#10B981" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" x:Name="OptionText2" Text="تحدي" FontSize="16" FontFamily="CairoBold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                        </Grid>
                        <!-- شريط التصويت اللحظي للشات -->
                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="6" VerticalOptions="End">
                            <ProgressBar x:Name="OptionProgress2" Progress="0.0" ProgressColor="#10B981" HeightRequest="4" VerticalOptions="Center"/>
                            <Label Grid.Column="1" x:Name="OptionVotesLabel2" Text="0" FontSize="11" FontFamily="CairoBold" TextColor="#94A3B8"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- الخيار [ 4 ] -->
                <Border x:Name="OptionCard3" Grid.Row="1" Grid.Column="1"
                        BackgroundColor="#0F172A" Stroke="#263B5E" StrokeThickness="1.5" StrokeShape="RoundRectangle 18" Padding="12,10" HeightRequest="90">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOptionManualTapped" CommandParameter="3"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="*, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="26" HeightRequest="26" VerticalOptions="Start">
                                <Label Text="4" FontSize="13" FontFamily="CairoBold" TextColor="#EC4899" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" x:Name="OptionText3" Text="خطة" FontSize="16" FontFamily="CairoBold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                        </Grid>
                        <!-- شريط التصويت اللحظي للشات -->
                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="6" VerticalOptions="End">
                            <ProgressBar x:Name="OptionProgress3" Progress="0.0" ProgressColor="#EC4899" HeightRequest="4" VerticalOptions="Center"/>
                            <Label Grid.Column="1" x:Name="OptionVotesLabel3" Text="0" FontSize="11" FontFamily="CairoBold" TextColor="#94A3B8"/>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>

        </VerticalStackLayout>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 🎮 4. شريط معلومات وتفاعل الشات وأدوات الباث السفلية          -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                BackgroundColor="#0B1320"
                Stroke="#1E293B"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                Padding="14,10">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <!-- شريط آخر نشاط في الشات -->
                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <Label Text="💬" FontSize="14" VerticalOptions="Center"/>
                    <Label x:Name="LastChatActivityLabel"
                           Text="اكتب 1 أو 2 أو 3 أو 4 في الشات للمشاركة!"
                           FontSize="11.5"
                           FontFamily="CairoRegular"
                           TextColor="#94A3B8"
                           LineBreakMode="TailTruncation"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- أزرار تحكم سريعة للباث -->
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <!-- زر تخطي للسؤال التالي -->
                    <Border BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,5">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSkipQuestionTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="⏭️ تخطي" FontSize="11" FontFamily="CairoBold" TextColor="#CBD5E1"/>
                    </Border>
                    <!-- زر إيقاف مؤقت -->
                    <Border BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,5">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTogglePauseTapped"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="PauseButtonLabel" Text="⏸️" FontSize="11" FontFamily="CairoBold" TextColor="#CBD5E1"/>
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 📡 5. شاشة فحص حالة البث والانتظار (Waiting for Live)       -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="WaitingLiveOverlay"
                Grid.Row="1"
                Grid.RowSpan="2"
                IsVisible="False"
                BackgroundColor="#091021"
                Stroke="#233554"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 24"
                Padding="22"
                VerticalOptions="Center"
                Margin="10,0">
            <Border.Shadow>
                <Shadow Brush="#000000" Radius="30" Offset="0,10" Opacity="0.8"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                <Border WidthRequest="60" HeightRequest="60" StrokeShape="RoundRectangle 30" BackgroundColor="#1E293B" StrokeThickness="0" HorizontalOptions="Center">
                    <Label x:Name="WaitingIconLabel" Text="📡" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label x:Name="WaitingTitleLabel" Text="جاري فحص حالة البث المباشر..." FontSize="17" FontFamily="CairoBold" TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label x:Name="WaitingSubtitleLabel" Text="يرجى الانتظار بينما نتحقق من اتصال غرفة البث على تيك توك..." FontSize="12" FontFamily="CairoRegular" TextColor="#94A3B8" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <ActivityIndicator x:Name="WaitingSpinner" IsRunning="True" Color="#38BDF8" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center"/>

                <VerticalStackLayout x:Name="WaitingActionsLayout" IsVisible="False" Spacing="10" Margin="0,10,0,0" WidthRequest="260">
                    <Button Text="🔄 إعادة فحص البث الآن" FontFamily="CairoBold" FontSize="13.5" TextColor="White" BackgroundColor="#2563EB" CornerRadius="14" HeightRequest="44" Clicked="OnRetryCheckLiveClicked"/>
                    <Button Text="🎮 التحويل لوضع التجربة والمحاكاة" FontFamily="CairoBold" FontSize="13" TextColor="#38BDF8" BackgroundColor="#131D30" CornerRadius="14" HeightRequest="44" Clicked="OnSwitchToSimulationClicked"/>
                    <Button Text="▶️ بدء التحدي على أي حال (يدوي)" FontFamily="CairoRegular" FontSize="12" TextColor="#94A3B8" BackgroundColor="Transparent" Clicked="OnForceStartClicked"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
