<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.CreateAccountPage"
             Title="إنشاء حساب"
             FlowDirection="RightToLeft"
             BackgroundColor="#0B0F1A">

    <Grid>
        <Ellipse Fill="#15818CF8" WidthRequest="300" HeightRequest="300" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-150,-150,0" />
        <Ellipse Fill="#1538BDF8" WidthRequest="250" HeightRequest="250" HorizontalOptions="Start" VerticalOptions="End" Margin="-100,0,0,-100" />

        <ScrollView>
            <VerticalStackLayout Padding="30,40,30,30" Spacing="20" VerticalOptions="Center">

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0,0,0,10">
                    <Label Text="انضم إلينا 🚀" 
                           TextColor="White" 
                           FontSize="32" 
                           FontFamily="CairoBold" 
                           HorizontalOptions="Center"/>
                    <Label Text="ابدأ رحلتك في تعلم الإنجليزية الآن" 
                           TextColor="#94A3B8" 
                           FontSize="15" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="اسم المستخدم" TextColor="#94A3B8" FontSize="14" FontAttributes="Bold" Margin="5,0,0,0"/>
                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#1E293B" BackgroundColor="#0F172A" Padding="15,5" HeightRequest="60">
                        <Entry x:Name="UserNameEntry" Placeholder="اختر اسماً مميزاً..." PlaceholderColor="#475569" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="كلمة المرور" TextColor="#94A3B8" FontSize="14" FontAttributes="Bold" Margin="5,0,0,0"/>
                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#1E293B" BackgroundColor="#0F172A" Padding="15,5" HeightRequest="60">
                        <Entry x:Name="PasswordEntry" Placeholder="••••••••" IsPassword="True" PlaceholderColor="#475569" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="رقم الهاتف" TextColor="#94A3B8" FontSize="14" FontAttributes="Bold" Margin="5,0,0,0"/>
                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#1E293B" BackgroundColor="#0F172A" Padding="15,5" HeightRequest="60">
                        <Entry x:Name="PhoneEntry" Placeholder="7XXXXXXXX" Keyboard="Telephone" PlaceholderColor="#475569" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <Button Text="إنشاء حساب جديد ✨" 
                        Clicked="OnCreateAccountClicked" 
                        Margin="0,20,0,0" 
                        HeightRequest="60"
                        CornerRadius="16"
                        FontSize="18"
                        FontAttributes="Bold"
                        FontFamily="CairoBold"
                        TextColor="White">
                    <Button.Background>
                        <LinearGradientBrush EndPoint="1,0">
                            <GradientStop Color="#818CF8" Offset="0.1" />
                            <GradientStop Color="#38BDF8" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Shadow>
                        <Shadow Brush="#38BDF8" Offset="0,6" Radius="20" Opacity="0.4" />
                    </Button.Shadow>
                </Button>

                <Button Text="لديك حساب بالفعل؟ سجل دخولك" 
                        BackgroundColor="Transparent"
                        TextColor="#94A3B8"
                        FontSize="14"
                        Clicked="OnBackToLoginClicked"
                        Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="LoadingOverlay" BackgroundColor="#CC0B0F1A" IsVisible="False">
            <Border HorizontalOptions="Center" VerticalOptions="Center" StrokeShape="RoundRectangle 20" BackgroundColor="#0F172A" Padding="35">
                <VerticalStackLayout Spacing="15">
                    <ActivityIndicator x:Name="ActivityIndicator" IsRunning="True" Color="#38BDF8" WidthRequest="50" HeightRequest="50" />
                    <Label Text="جاري إنشاء حسابك..." TextColor="White" FontSize="16" FontFamily="CairoBold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>