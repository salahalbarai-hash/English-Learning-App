<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="English.Pages.ResultPopup"
               Color="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <Border x:Name="MainBorder" 
            WidthRequest="320"
            BackgroundColor="#111827"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 35"
            Padding="25,35,25,25"
            HorizontalOptions="Center"
            VerticalOptions="Center">

        <Border.Shadow>
            <Shadow x:Name="GlowShadow" Offset="0,0" Radius="30" Opacity="0.6"/>
        </Border.Shadow>

        <VerticalStackLayout Spacing="15" HorizontalOptions="Center">

            <Label x:Name="IconLabel" 
                   FontSize="65" 
                   HorizontalOptions="Center"/>

            <Label x:Name="TitleLabel" 
                   FontSize="26" 
                   FontFamily="CairoBold" 
                   HorizontalOptions="Center"/>

            <Label x:Name="MessageLabel" 
                   FontSize="14" 
                   TextColor="#A5B4FC" 
                   FontFamily="CairoRegular" 
                   HorizontalOptions="Center"/>

            <Border BackgroundColor="#1E293B" 
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15" 
                    Padding="15,10" 
                    Margin="0,10">

                <Label x:Name="WordLabel" 
                       FontSize="22" 
                       FontFamily="CairoBold" 
                       TextColor="White" 
                       HorizontalOptions="Center"
                       TextTransform="Uppercase"/>
            </Border>

            <Button x:Name="ActionButton" 
                    Clicked="OnNewGameClicked" 
                    HeightRequest="52" 
                    CornerRadius="26" 
                    FontFamily="CairoBold" 
                    FontSize="16" 
                    Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>