<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="English.Pages.WordMatrixPage"
             BackgroundColor="#080D18"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="16,14,16,16">

        <!-- 1. شريط التحكم العلوي: الإحصائيات والأرواح وزر الخروج -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center" Margin="0,0,0,10">
            <!-- زر الخروج -->
            <Border Grid.Column="0"
                    BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    WidthRequest="40"
                    HeightRequest="40"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnExitClicked"/>
                </Border.GestureRecognizers>
                <Label Text="✕" TextColor="#94A3B8" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- القلوب والكومبو في المنتصف (Rose Pink Theme) -->
            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="14" VerticalOptions="Center">
                <!-- شارات القلوب -->
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label x:Name="Heart1Label" Text="❤️" FontSize="18"/>
                    <Label x:Name="Heart2Label" Text="❤️" FontSize="18"/>
                    <Label x:Name="Heart3Label" Text="❤️" FontSize="18"/>
                </HorizontalStackLayout>

                <!-- شارة الكومبو -->
                <Border BackgroundColor="#2B1019" Stroke="#F43F5E" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="8,3">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="🔥" FontSize="13" VerticalOptions="Center"/>
                        <Label x:Name="ComboLabel" Text="x1" TextColor="#FECDD3" FontSize="13" FontFamily="CairoBold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </HorizontalStackLayout>

            <!-- نقاط الجولة -->
            <Border Grid.Column="2" BackgroundColor="#1C212E" Stroke="#66F43F5E" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="10,5">
                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                    <Label Text="⭐" FontSize="14" VerticalOptions="Center"/>
                    <Label x:Name="SessionScoreLabel" Text="0" FontSize="14" FontFamily="CairoBold" TextColor="#FBBF24" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- 2. بطاقة مرحلة اللعبة والعداد التنازلي (Rose Pink Gradient) -->
        <Border Grid.Row="1"
                StrokeThickness="1.2"
                StrokeShape="RoundRectangle 18"
                Padding="16,12"
                Margin="0,0,0,14"
                BackgroundColor="#160D14">
            <Border.Stroke>
                <LinearGradientBrush EndPoint="1,0">
                    <GradientStop Color="#F43F5E" Offset="0"/>
                    <GradientStop Color="#BE123C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Stroke>

            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label x:Name="PhaseTitleLabel"
                           Text="مرحلة الملاحظة 🧠"
                           FontSize="16"
                           FontFamily="CairoBold"
                           TextColor="#FFFFFF"/>
                    <Label x:Name="PhaseSubLabel"
                           Text="احفظ مواقع الكلمات الإنجليزية ومعانيها قبل أن تختفي!"
                           FontSize="11.5"
                           FontFamily="CairoRegular"
                           TextColor="#94A3B8"/>
                </VerticalStackLayout>

                <!-- عداد الثواني الدائري / النصي -->
                <Border Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="1.5"
                        Stroke="#F43F5E"
                        BackgroundColor="#26101B"
                        VerticalOptions="Center">
                    <Label x:Name="TimerTextLabel"
                           Text="4"
                           TextColor="#FECDD3"
                           FontSize="18"
                           FontFamily="CairoBold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 3. شبكة بطاقات المصفوفة المكانية (The Matrix Grid) -->
        <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never" HorizontalScrollBarVisibility="Never">
            <Grid x:Name="MatrixGrid" 
                  RowSpacing="10" 
                  ColumnSpacing="10" 
                  HorizontalOptions="FillAndExpand" 
                  VerticalOptions="CenterAndExpand">
                <!-- تتولد بطاقات الشبكة ديناميكياً في الكود حسب عدد الكلمات -->
            </Grid>
        </ScrollView>

        <!-- 4. مؤشر التقدم السفلي للجولة -->
        <Grid Grid.Row="3" ColumnDefinitions="*, Auto" Margin="0,10,0,0" VerticalOptions="Center">
            <Label x:Name="ProgressPairsLabel"
                   Text="الأزواج المتبقية: 4"
                   TextColor="#64748B"
                   FontSize="12"
                   FontFamily="CairoRegular"
                   VerticalOptions="Center"/>

            <Label x:Name="ModeBadgeLabel"
                   Text="الكلمات المحفوظة 🧠"
                   TextColor="#F43F5E"
                   FontSize="12"
                   FontFamily="CairoBold"
                   HorizontalOptions="End"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- 🌟 طبقة نافذة النصر / الخسارة المشروطة (Modal Overlay) -->
        <Grid x:Name="ResultOverlay" Grid.RowSpan="4" BackgroundColor="#E6050811" IsVisible="False" ZIndex="999">
            <Border StrokeThickness="1.5"
                    Stroke="#F43F5E"
                    StrokeShape="RoundRectangle 26"
                    BackgroundColor="#0B1320"
                    Padding="24"
                    WidthRequest="320"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label x:Name="ResultIconLabel" Text="🏆" FontSize="54" HorizontalOptions="Center"/>
                    <Label x:Name="ResultTitleLabel" Text="ذاكرة خارقة! 🎉" FontSize="22" FontFamily="CairoBold" TextColor="#F43F5E" HorizontalOptions="Center"/>
                    <Label x:Name="ResultDescLabel" Text="تمت مطابقة جميع أزواج الكلمات بنجاح تام." FontSize="13" FontFamily="CairoRegular" TextColor="#94A3B8" HorizontalTextAlignment="Center"/>

                    <!-- إحصائيات الإنجاز -->
                    <Border BackgroundColor="#111A2E" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16,10">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                                <Label Text="النقاط المحققة" FontSize="11" TextColor="#94A3B8" FontFamily="CairoRegular"/>
                                <Label x:Name="ResultScoreLabel" Text="+40 ⭐" FontSize="16" TextColor="#FBBF24" FontFamily="CairoBold" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                                <Label Text="الوقت المستغرق" FontSize="11" TextColor="#94A3B8" FontFamily="CairoRegular"/>
                                <Label x:Name="ResultTimeLabel" Text="18s ⏱️" FontSize="16" TextColor="#F43F5E" FontFamily="CairoBold" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Button Text="جولة أخرى 🔁"
                            HeightRequest="48"
                            CornerRadius="24"
                            BackgroundColor="#E11D48"
                            TextColor="White"
                            FontFamily="CairoBold"
                            FontSize="15"
                            Clicked="OnPlayAgainClicked"/>

                    <Button Text="العودة"
                            HeightRequest="44"
                            CornerRadius="22"
                            BackgroundColor="Transparent"
                            BorderColor="#334155"
                            BorderWidth="1"
                            TextColor="#94A3B8"
                            FontFamily="CairoBold"
                            FontSize="14"
                            Clicked="OnExitConfirmedClicked"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>