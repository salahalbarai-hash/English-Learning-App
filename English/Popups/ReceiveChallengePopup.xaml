<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="English.Popups.ReceiveChallengePopup">

    <Border BackgroundColor="#111827"
            Stroke="#334155"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 25"
            Padding="20"
            WidthRequest="330">

        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
            <Label Text="⚔️ طلب تحدٍ جديد!" 
                   FontSize="20" 
                   FontFamily="CairoBold" 
                   TextColor="White" 
                   HorizontalOptions="Center"/>

            <Label x:Name="MessageLabel"
                   Text="لقد تلقيت طلب تحدٍ من صديق..." 
                   FontSize="13.5" 
                   TextColor="#94A3B8" 
                   FontFamily="CairoRegular"
                   HorizontalTextAlignment="Center"/>

            <!-- معاينة الكلمة للتحديات الفردية -->
            <Border x:Name="WordPreviewContainer" BackgroundColor="#0B1221" Padding="10" IsVisible="False" Stroke="#00E5FF" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="6">
                    <Label Text="الكلمة المختارة" FontSize="12" TextColor="#94A3B8" HorizontalOptions="Center"/>
                    <Label x:Name="WordLabel" Text="" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    <Label x:Name="ArabicLabel" Text="" FontSize="13" TextColor="#94A3B8" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- 🕊️ بطاقة اختيار لون الطائر (تظهر فقط عند تلقي تحدي الطائر الصاعد) -->
            <Border x:Name="BirdColorContainer"
                    IsVisible="False"
                    BackgroundColor="#0B1322"
                    Stroke="#1E293B"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="14,12">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="اختر لون طائرك في السباق 🕊️"
                           FontSize="13"
                           FontFamily="CairoBold"
                           TextColor="#CBD5E1"
                           HorizontalOptions="Center"/>

                    <Label x:Name="SenderBirdColorHintLabel"
                           Text="طائر الصديق: 🦅 أزرق نيون"
                           FontSize="11.5"
                           FontFamily="CairoBold"
                           TextColor="#38BDF8"
                           HorizontalOptions="Center"/>

                    <!-- صف دوائر الألوان المتاحة (يتم إخفاء لون المرسل تلقائياً) -->
                    <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                        <!-- 1. Cyan (أزرق نيون) -->
                        <Border x:Name="ColorCyanBorder" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="3" Stroke="White" BackgroundColor="#38BDF8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorCyanTapped"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="ColorCyanCheck" Text="✓" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="True"/>
                        </Border>

                        <!-- 2. Rose (وردي ناري) -->
                        <Border x:Name="ColorRoseBorder" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="1" Stroke="#F43F5E" BackgroundColor="#F43F5E">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorRoseTapped"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="ColorRoseCheck" Text="✓" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False"/>
                        </Border>

                        <!-- 3. Gold (ذهبي متوهج) -->
                        <Border x:Name="ColorGoldBorder" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="1" Stroke="#F59E0B" BackgroundColor="#F59E0B">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorGoldTapped"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="ColorGoldCheck" Text="✓" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False"/>
                        </Border>

                        <!-- 4. Emerald (أخضر زمردي) -->
                        <Border x:Name="ColorEmeraldBorder" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="1" Stroke="#10B981" BackgroundColor="#10B981">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorEmeraldTapped"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="ColorEmeraldCheck" Text="✓" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False"/>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- أزرار القبول والرفض -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                <Button Grid.Column="0"
                        Text="رفض ❌"
                        BackgroundColor="#EF4444"
                        TextColor="White"
                        CornerRadius="18"
                        HeightRequest="42"
                        FontFamily="CairoBold"
                        Clicked="OnDeclineClicked"/>

                <Button Grid.Column="1"
                        Text="قبول المواجهة 🚀"
                        BackgroundColor="#10B981"
                        TextColor="White"
                        CornerRadius="18"
                        HeightRequest="42"
                        FontFamily="CairoBold"
                        Clicked="OnAcceptClicked"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
