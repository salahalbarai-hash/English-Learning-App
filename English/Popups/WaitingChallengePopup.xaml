<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="English.Popups.WaitingChallengePopup"
             Color="Transparent"
             CanBeDismissedByTappingOutsideOfPopup="False">
    <!-- نمنع الإغلاق بالضغط خارجها -->

    <Border BackgroundColor="#151624"
            Stroke="#333752"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 24"
            Padding="24"
            WidthRequest="320"
            HorizontalOptions="Center"
            VerticalOptions="Center">

        <Border.Shadow>
            <Shadow Brush="#00E5FF" Offset="0,0" Radius="15" Opacity="0.15"/>
        </Border.Shadow>

        <VerticalStackLayout Spacing="16">

            <Label x:Name="IconLabel" 
                   Text="⚡" 
                   FontSize="36" 
                   HorizontalOptions="Center"/>

            <Label x:Name="TitleLabel"
                   Text="جارٍ التحقق وتجهيز التحدي..." 
                   FontSize="19" 
                   FontAttributes="Bold" 
                   TextColor="White" 
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"/>

            <Label x:Name="SubtitleLabel"
                   Text="نتحقق من جاهزية الصديق ونُعد الأسئلة..."
                   FontSize="13"
                   TextColor="#94A3B8"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"/>

            <Label x:Name="FriendNameLabel"
                   FontSize="15" 
                   TextColor="#00E5FF" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <!-- مؤشر التحميل الدائري -->
            <ActivityIndicator IsRunning="True" 
                               Color="#00E5FF" 
                               WidthRequest="46" 
                               HeightRequest="46"
                               Margin="0,6"/>

            <!-- زر الإلغاء -->
            <Button x:Name="CancelButton"
                    Text="إلغاء الطلب ✖"
                    BackgroundColor="#F43F5E"
                    TextColor="White"
                    CornerRadius="14"
                    HeightRequest="45"
                    FontAttributes="Bold"
                    Clicked="OnCancelClicked"/>

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>