<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
           x:Class="English.Popups.DeleteConfirmPopup"
           Color="Transparent">

    <Border StrokeShape="RoundRectangle 24"
            StrokeThickness="0"
            BackgroundColor="#0F172A"
            WidthRequest="320"
            Padding="24"
            Margin="0,0,0,0">
            
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,15" Radius="40" Opacity="0.5"/>
        </Border.Shadow>

        <VerticalStackLayout Spacing="16">
            
            <Label Text="ماذا تريد أن تفعل؟"
                   TextColor="#F8FAFC"
                   FontFamily="CairoBold"
                   FontSize="18"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <!-- زر حذف لدى الجميع -->
            <Button x:Name="DeleteForEveryoneBtn"
                    Text="حذف لدى الجميع"
                    TextColor="#EF4444"
                    BackgroundColor="#1E293B"
                    FontFamily="CairoBold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="52"
                    Clicked="OnDeleteForEveryoneClicked"/>

            <!-- زر حذف لدي -->
            <Button x:Name="DeleteForMeBtn"
                    Text="حذف لدي"
                    TextColor="#F8FAFC"
                    BackgroundColor="#1E293B"
                    FontFamily="CairoBold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="52"
                    Clicked="OnDeleteForMeClicked"/>

            <!-- خط فاصل خفيف -->
            <BoxView HeightRequest="1" Color="#1E293B" Margin="20,5" />

            <!-- زر إلغاء -->
            <Button Text="إلغاء"
                    TextColor="#94A3B8"
                    BackgroundColor="Transparent"
                    FontFamily="CairoBold"
                    FontSize="16"
                    HeightRequest="45"
                    Clicked="OnCancelClicked"/>

        </VerticalStackLayout>
    </Border>

</mct:Popup>
