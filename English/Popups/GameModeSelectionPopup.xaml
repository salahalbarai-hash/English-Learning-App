<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="English.Popups.GameModeSelectionPopup"
             CanBeDismissedByTappingOutsideOfPopup="True">

    <Border BackgroundColor="#0F172A"
            Stroke="#1E293B"
            StrokeThickness="1.5"
            StrokeShape="RoundRectangle 24"
            Padding="22"
            WidthRequest="340"
            FlowDirection="RightToLeft">

        <VerticalStackLayout Spacing="18">

            <!-- هيدر النافذة -->
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label x:Name="GameTitleLabel"
                           Text="اختر وضع اللعب"
                           FontSize="18"
                           FontFamily="CairoBold"
                           TextColor="White"/>
                    <Label Text="اختر كيف ترغب في اللعب اليوم"
                           FontSize="12"
                           FontFamily="CairoRegular"
                           TextColor="#94A3B8"/>
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="✕"
                        FontSize="14"
                        TextColor="#94A3B8"
                        BackgroundColor="Transparent"
                        WidthRequest="32"
                        HeightRequest="32"
                        Padding="0"
                        Clicked="OnCloseClicked"/>
            </Grid>

            <BoxView HeightRequest="1" Color="#1E293B" Margin="0,-6,0,0"/>

            <!-- الخيار الأول: لعب فردي -->
            <Border Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="#1E293B"
                    Padding="14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSinglePlayerTapped"/>
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                    <Border Grid.Column="0"
                            WidthRequest="46"
                            HeightRequest="46"
                            StrokeShape="RoundRectangle 23"
                            StrokeThickness="0"
                            BackgroundColor="#312E81"
                            VerticalOptions="Center">
                        <Label Text="👤" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="لعب فردي (Single Player)"
                               FontSize="14"
                               FontFamily="CairoBold"
                               TextColor="#F8FAFC"/>
                        <Label Text="تدرب بمفردك وحطّم رقمك القياسي"
                               FontSize="11"
                               FontFamily="CairoRegular"
                               TextColor="#94A3B8"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- الخيار الثاني: تحدي صديق -->
            <Border Stroke="#065F46"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="#064E3B"
                    Padding="14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFriendChallengeTapped"/>
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                    <Border Grid.Column="0"
                            WidthRequest="46"
                            HeightRequest="46"
                            StrokeShape="RoundRectangle 23"
                            StrokeThickness="0"
                            BackgroundColor="#047857"
                            VerticalOptions="Center">
                        <Label Text="⚔️" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="تحدي صديق (Friend Challenge)"
                               FontSize="14"
                               FontFamily="CairoBold"
                               TextColor="#F8FAFC"/>
                        <Label Text="أرسل دعوة تحدٍ مباشرة لصديق أونلاين"
                               FontSize="11"
                               FontFamily="CairoRegular"
                               TextColor="#A7F3D0"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>