<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="English.Popups.InAppMessageBannerPopup"
               Color="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="True">

    <!-- شريط إشعار عائم ينزل من أعلى الشاشة بهوية بصرية دارك وأنيقة -->
    <Border x:Name="BannerCard"
            BackgroundColor="#151E2F"
            Stroke="#38BDF8"
            StrokeThickness="1.2"
            StrokeShape="RoundRectangle 18"
            Padding="12,10"
            WidthRequest="340"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="0, 15, 0, 0"
            FlowDirection="RightToLeft">

        <Border.Shadow>
            <Shadow Brush="#38BDF8" Offset="0,4" Radius="14" Opacity="0.25" />
        </Border.Shadow>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBannerTapped" />
            <SwipeGestureRecognizer Direction="Up" Swiped="OnSwipedUp" />
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="40, *, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
            
            <!-- الحرف الأول لاسم الصديق داخل دائرة نيون أنيقة -->
            <Border Grid.Column="0"
                    WidthRequest="40"
                    HeightRequest="40"
                    StrokeShape="RoundRectangle 20"
                    Stroke="#38BDF8"
                    StrokeThickness="1.5"
                    BackgroundColor="#1E293B"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Label x:Name="SenderInitialLabel"
                       Text="?"
                       TextColor="#38BDF8"
                       FontSize="16"
                       FontFamily="CairoBold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- تفاصيل الرسالة: اسم المرسل + نص الرسالة المختصر -->
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label x:Name="SenderNameLabel"
                           Text="صديق"
                           TextColor="White"
                           FontSize="14"
                           FontFamily="CairoBold"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label Text="• رسالة جديدة"
                           TextColor="#38BDF8"
                           FontSize="11"
                           FontFamily="Cairo"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label x:Name="MessagePreviewLabel"
                       Text="..."
                       TextColor="#94A3B8"
                       FontSize="12"
                       FontFamily="Cairo"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </VerticalStackLayout>

            <!-- زر العرض السريع للمحادثة -->
            <Border Grid.Column="2"
                    BackgroundColor="#0284C7"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    Padding="10,6"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBannerTapped" />
                </Border.GestureRecognizers>
                <Label Text="عرض 💬"
                       TextColor="White"
                       FontSize="12"
                       FontFamily="CairoBold"
                       VerticalOptions="Center" />
            </Border>

            <!-- زر الإغلاق ✕ -->
            <Border Grid.Column="3"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="6,4"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseClicked" />
                </Border.GestureRecognizers>
                <Label Text="✕"
                       TextColor="#64748B"
                       FontSize="14"
                       FontFamily="CairoBold"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />
            </Border>
            
        </Grid>
    </Border>
</toolkit:Popup>
