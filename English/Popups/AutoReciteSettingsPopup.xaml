<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
              x:Class="English.Popups.AutoReciteSettingsPopup"
              Color="Transparent"
              CanBeDismissedByTappingOutsideOfPopup="True">

    <Border BackgroundColor="#0F172A"
            Stroke="#263B5E"
            StrokeThickness="1.5"
            StrokeShape="RoundRectangle 24"
            Padding="22"
            WidthRequest="340"
            FlowDirection="RightToLeft">

        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,15" Radius="40" Opacity="0.6"/>
        </Border.Shadow>

        <VerticalStackLayout Spacing="16">

            <!-- هيدر النافذة -->
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Image Source="headphones_icon.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                        <Label Text="إعدادات التلقين الصوتي"
                               FontSize="17"
                               FontFamily="CairoBold"
                               TextColor="White"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="حدد عدد مرات التكرار للكلمات والدورات"
                           FontSize="11.5"
                           FontFamily="Cairo"
                           TextColor="#94A3B8"/>
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="✕"
                        FontSize="14"
                        TextColor="#94A3B8"
                        BackgroundColor="Transparent"
                        WidthRequest="32"
                        HeightRequest="32"
                        Padding="0"
                        Clicked="OnCloseClicked"/>
            </Grid>

            <BoxView HeightRequest="1" Color="#1E293B" Margin="0,-4,0,0"/>

            <!-- القسم 1: تكرار الكلمة الواحدة -->
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="تكرار الكلمة الواحدة"
                           TextColor="#E2E8F0"
                           FontFamily="CairoBold"
                           FontSize="13.5"/>
                    <Label Grid.Column="1" Text="انقر الرقم للتعديل"
                           TextColor="#64748B"
                           FontFamily="Cairo"
                           FontSize="11"/>
                </Grid>

                <!-- أداة تحكم موحدة وأنيقة للرقم (بدون أي مربعات بيضاء) -->
                <Border Stroke="#263B5E" StrokeThickness="1.2"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="#131D30"
                        HeightRequest="48"
                        Padding="6,4">
                    <Grid ColumnDefinitions="42,*,42" VerticalOptions="Center">
                        <!-- زر إنقاص -->
                        <Border Grid.Column="0"
                                StrokeThickness="0"
                                BackgroundColor="#1E293B"
                                StrokeShape="RoundRectangle 10"
                                WidthRequest="38" HeightRequest="38">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWordMinusTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="—" TextColor="#38BDF8" FontSize="18" FontFamily="CairoBold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <!-- الرقم الواضح في المنتصف بلون سماوي نيون -->
                        <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWordLabelTapped"/>
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label x:Name="WordRepeatsLabel"
                                   Text="2"
                                   TextColor="#38BDF8"
                                   FontFamily="CairoBold"
                                   FontSize="22"
                                   VerticalOptions="Center"/>
                            <Label Text="مرات"
                                   TextColor="#94A3B8"
                                   FontFamily="Cairo"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   Margin="0,3,0,0"/>
                        </HorizontalStackLayout>

                        <!-- زر زيادة -->
                        <Border Grid.Column="2"
                                StrokeThickness="0"
                                BackgroundColor="#1E293B"
                                StrokeShape="RoundRectangle 10"
                                WidthRequest="38" HeightRequest="38">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWordPlusTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="+" TextColor="#38BDF8" FontSize="20" FontFamily="CairoBold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- اختصارات سريعة لتكرار الكلمة -->
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="5">
                    <Border x:Name="ChipW1" Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#1E293B" Padding="3,4">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipW1Tapped"/></Border.GestureRecognizers>
                        <Label Text="1×" TextColor="#94A3B8" FontFamily="CairoBold" FontSize="11.5" HorizontalOptions="Center"/>
                    </Border>
                    <Border x:Name="ChipW2" Grid.Column="1" StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#1E293B" Padding="3,4">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipW2Tapped"/></Border.GestureRecognizers>
                        <Label Text="2×" TextColor="#94A3B8" FontFamily="CairoBold" FontSize="11.5" HorizontalOptions="Center"/>
                    </Border>
                    <Border x:Name="ChipW5" Grid.Column="2" StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#1E293B" Padding="3,4">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipW5Tapped"/></Border.GestureRecognizers>
                        <Label Text="5×" TextColor="#94A3B8" FontFamily="CairoBold" FontSize="11.5" HorizontalOptions="Center"/>
                    </Border>
                    <Border x:Name="ChipW10" Grid.Column="3" StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#1E293B" Padding="3,4">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipW10Tapped"/></Border.GestureRecognizers>
                        <Label Text="10×" TextColor="#94A3B8" FontFamily="CairoBold" FontSize="11.5" HorizontalOptions="Center"/>
                    </Border>
                    <Border x:Name="ChipW20" Grid.Column="4" StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#1E293B" Padding="3,4">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipW20Tapped"/></Border.GestureRecognizers>
                        <Label Text="20×" TextColor="#94A3B8" FontFamily="CairoBold" FontSize="11.5" HorizontalOptions="Center"/>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- القسم 2: تكرار المجموعة بالكامل -->
            <VerticalStackLayout Spacing="8">
                <Label Text="تكرار المجموعة (الدورات)"
                       TextColor="#E2E8F0"
                       FontFamily="CairoBold"
                       FontSize="13.5"/>

                <!-- التبديل بين مستمر أو عدد محدد -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <!-- خيار مستمر -->
                    <Border x:Name="BtnInfiniteLoop" Grid.Column="0"
                            StrokeThickness="1.2"
                            StrokeShape="RoundRectangle 12"
                            Padding="8,9"
                            HorizontalOptions="Fill">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnInfiniteLoopTapped"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="TxtInfiniteLoop" Text="♾️ مستمر حتى الإيقاف"
                               FontFamily="CairoBold" FontSize="12.5"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- خيار عدد محدد -->
                    <Border x:Name="BtnCustomLoop" Grid.Column="1"
                            StrokeThickness="1.2"
                            StrokeShape="RoundRectangle 12"
                            Padding="8,9"
                            HorizontalOptions="Fill">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCustomLoopTapped"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="TxtCustomLoop" Text="عدد دورات محدد"
                               FontFamily="CairoBold" FontSize="12.5"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- أداة تحكم عدد الدورات (تظهر فقط عند اختيار عدد محدد) -->
                <VerticalStackLayout x:Name="CustomRoundsContainer" Spacing="6" IsVisible="False">
                    <Border Stroke="#263B5E" StrokeThickness="1.2"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="#131D30"
                            HeightRequest="46"
                            Padding="6,3">
                        <Grid ColumnDefinitions="40,*,40" VerticalOptions="Center">
                            <!-- زر إنقاص -->
                            <Border Grid.Column="0"
                                    StrokeThickness="0"
                                    BackgroundColor="#1E293B"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="36" HeightRequest="36">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRoundMinusTapped"/>
                                </Border.GestureRecognizers>
                                <Label Text="—" TextColor="#38BDF8" FontSize="18" FontFamily="CairoBold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <!-- عدد الدورات في المنتصف -->
                            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRoundLabelTapped"/>
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label x:Name="GroupRoundsLabel"
                                       Text="2"
                                       TextColor="#38BDF8"
                                       FontFamily="CairoBold"
                                       FontSize="20"
                                       VerticalOptions="Center"/>
                                <Label Text="دورات"
                                       TextColor="#94A3B8"
                                       FontFamily="Cairo"
                                       FontSize="12.5"
                                       VerticalOptions="Center"
                                       Margin="0,2,0,0"/>
                            </HorizontalStackLayout>

                            <!-- زر زيادة -->
                            <Border Grid.Column="2"
                                    StrokeThickness="0"
                                    BackgroundColor="#1E293B"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="36" HeightRequest="36">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRoundPlusTapped"/>
                                </Border.GestureRecognizers>
                                <Label Text="+" TextColor="#38BDF8" FontSize="18" FontFamily="CairoBold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- اختصارات سريعة لعدد الدورات -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                        <Border x:Name="ChipR1" Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#1E293B" Padding="4,4">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipR1Tapped"/></Border.GestureRecognizers>
                            <Label Text="دورة 1" TextColor="#94A3B8" FontFamily="CairoBold" FontSize="11.5" HorizontalOptions="Center"/>
                        </Border>
                        <Border x:Name="ChipR2" Grid.Column="1" StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#1E293B" Padding="4,4">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipR2Tapped"/></Border.GestureRecognizers>
                            <Label Text="دورتان" TextColor="#94A3B8" FontFamily="CairoBold" FontSize="11.5" HorizontalOptions="Center"/>
                        </Border>
                        <Border x:Name="ChipR5" Grid.Column="2" StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#1E293B" Padding="4,4">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipR5Tapped"/></Border.GestureRecognizers>
                            <Label Text="5 دورات" TextColor="#94A3B8" FontFamily="CairoBold" FontSize="11.5" HorizontalOptions="Center"/>
                        </Border>
                        <Border x:Name="ChipR10" Grid.Column="3" StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#1E293B" Padding="4,4">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipR10Tapped"/></Border.GestureRecognizers>
                            <Label Text="10 دورات" TextColor="#94A3B8" FontFamily="CairoBold" FontSize="11.5" HorizontalOptions="Center"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- تلميح توضيحي للوضع المستمر -->
                <Label x:Name="InfiniteHintLabel"
                       Text="💡 سيعاد تكرار الكلمات باستمرار حتى تضغط زر الإيقاف"
                       TextColor="#64748B"
                       FontFamily="Cairo"
                       FontSize="11"
                       HorizontalOptions="Center"
                       IsVisible="True"/>

            </VerticalStackLayout>

            <!-- زر ابدأ التلقين الفاخر -->
            <Button Text="ابدأ التلقين ▶️"
                    TextColor="#0B111D"
                    BackgroundColor="#38BDF8"
                    FontFamily="CairoBold"
                    FontSize="16"
                    HeightRequest="48"
                    CornerRadius="24"
                    Margin="0,4,0,0"
                    Clicked="OnStartClicked"/>

        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
